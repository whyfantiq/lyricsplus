        self.line_source: Optional[str] = None
        self.current_index = -1
        self._current_index_set_at = 0.0
        self._chain_group_start: List[int] = []
        self._chain_tie_earlier: List[bool] = []
        self._line_backing: List[bool] = []
        self._line_backing_join: List[bool] = []
        self._chain_recheck_done: set = set()
        self.running = False
        self.sync_loop_started = False
        self.load_generation = 0
        self.loading_started_at = 0.0
        self._loading_overlay = None
        self._loading_container = None
        self.source_url: Optional[str] = None
        self.last_scroll_target: int = -1
        self.scroll_animator = None
        self._scroll_target_index: int = -1
        self._auto_scroll_resume_at: float = 0.0
        self._scroll_touch_listener = None
        self._ui_lock = threading.Lock()
        self._last_seek_at = 0.0
        self._dbg_last_bulletin_at: Dict[str, float] = {}

    # рисование под вырезом камеры
    def _allow_draw_into_cutout(self) -> None:
        try:
            window = self.dialog.getWindow() if self.dialog else None
            if window is None:
                return
            sdk = int(Build.VERSION.SDK_INT)
            if sdk < 28:
                return
            attrs = window.getAttributes()
            attrs.layoutInDisplayCutoutMode = 3 if sdk >= 30 else 1
            window.setAttributes(attrs)
        except Exception as e:
            self.log_dbg_fail("cutout mode", e)

    # показ окна
    def show(self):
        settings_cache_clear()
        self._lts_memo = None
        _gil_boost_on(self)
        self.dialog = Dialog(self.context)
        self.dialog.requestWindowFeature(Window.FEATURE_NO_TITLE)
        self.dialog.setCancelable(True)
        self._allow_draw_into_cutout()

        self.frame_root = FrameLayout(self.context)
        self.frame_root.setBackgroundColor(COLOR_BG)

        self.root = LinearLayout(self.context)
        self.root.setOrientation(LinearLayout.VERTICAL)
        self.root.setBackgroundColor(Color.TRANSPARENT)
        self.frame_root.addView(self.root, FrameLayout.LayoutParams(-1, -1))

        try:
            self.frame_root.setClipChildren(False)
            self.frame_root.setClipToPadding(False)
        except Exception:
            pass

        self._build_header()
        self._build_mini_player_bar()
        self._build_mini_player_toggle_btn()
        self._build_copy_btn()

        self._build_body_loading()

        self.running = True

        self.dialog.setContentView(self.frame_root)
        self.dialog.show()

        try:
            window = self.dialog.getWindow()
            window.setLayout(-1, -1)
            window.setBackgroundDrawable(ColorDrawable(COLOR_BG))
            try:
                decor = window.getDecorView()
                decor.setPadding(0, 0, 0, 0)
            except Exception:
                pass
            window.clearFlags(WindowManager.LayoutParams.FLAG_NOT_FULLSCREEN)
            window.addFlags(
                WindowManager.LayoutParams.FLAG_FULLSCREEN
                | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
                | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
            )
            try:
                window.clearFlags(0x04000000)
                window.addFlags(-2147483648)
            except Exception:
                pass
            window.setStatusBarColor(STATUS_BAR_COLOR)
            window.setNavigationBarColor(COLOR_BG)
        except Exception:
            pass
        self._allow_draw_into_cutout()
        self._hide_status_bar()
        self._install_compact_bar_inset_fix()

        self._ensure_sync_loop()
        self._reload_for_track(self.track)

    # шапка с обложкой и названием
    def _build_header(self):
        status_h = status_bar_height_px(self.context)
        side_pad = dp(self.context, self._side_padding_dp())
        art_size = dp(self.context, HEADER_ART_SIZE_DP)
        top_pad = status_h + dp(self.context, 10) + dp(self.context, HEADER_TOP_EXTRA_DP)
        bottom_pad = dp(self.context, 12) + HEADER_EXTRA_HEIGHT_PX
        content_h = top_pad + art_size + bottom_pad
        fade_tail = dp(self.context, HEADER_FADE_TAIL_DP)
        self._header_content_height_px = content_h
        self._big_close_center_px = float(top_pad) + float(art_size) / 2.0
        self._header_cover_bottom_px = top_pad + art_size + dp(self.context, TOP_FADE_END_BELOW_COVER_DP)

        self.header_overlay = FrameLayout(self.context)
        try:
            self.header_overlay.setClipChildren(False)
            self.header_overlay.setClipToPadding(False)
        except Exception:
            pass
        self.frame_root.addView(
            self.header_overlay,
            FrameLayout.LayoutParams(-1, content_h + fade_tail, Gravity.TOP),
        )
        try:
            self.header_overlay.setClickable(True)
        except Exception:
            pass

        self._header_fade_view = View(self.context)
        fade_lp = FrameLayout.LayoutParams(-1, fade_tail, Gravity.TOP)
        fade_lp.topMargin = content_h
        self.header_overlay.addView(self._header_fade_view, fade_lp)

        self.header_row = LinearLayout(self.context)
        self.header_row.setOrientation(LinearLayout.HORIZONTAL)
        self.header_row.setGravity(Gravity.CENTER_VERTICAL)
        self.header_row.setPadding(side_pad, top_pad, side_pad, bottom_pad)
        try:
            self.header_row.setClipChildren(False)
            self.header_row.setClipToPadding(False)
        except Exception:
            pass
        self.header_overlay.addView(
            self.header_row,
            FrameLayout.LayoutParams(-1, content_h, Gravity.TOP),
        )

        self._update_header_panel_color(Color.TRANSPARENT)

        art_bg = GradientDrawable()
        art_bg.setColor(Color.TRANSPARENT)
        self._art_bg_drawable = art_bg
        art_bg.setCornerRadius(dp(self.context, HEADER_ART_RADIUS_DP))
        art_holder = FrameLayout(self.context)
        art_holder.setBackground(art_bg)
        try:
            art_holder.setClipToOutline(True)
        except Exception:
            pass

        self.art_view = ImageView(self.context)
        self.art_view.setScaleType(ImageView.ScaleType.CENTER_CROP)
        art_holder.addView(self.art_view, FrameLayout.LayoutParams(-1, -1))

        self._art_note_view = TextView(self.context)
        self._art_note_view.setText("\u266a")
        self._art_note_view.setTextColor(argb_gray(150, 255))
        self._art_note_view.setTextSize(18)
        self._art_note_view.setGravity(Gravity.CENTER)
        self._art_note_view.setVisibility(View.GONE)
        art_holder.addView(self._art_note_view, FrameLayout.LayoutParams(-1, -1))

        self.header_row.addView(art_holder, LinearLayout.LayoutParams(art_size, art_size))
        self._header_art_holder = art_holder

        text_col = LinearLayout(self.context)
        text_col.setOrientation(LinearLayout.VERTICAL)
        text_col.setGravity(Gravity.CENTER_VERTICAL)
        lp_text = LinearLayout.LayoutParams(0, -2, 1.0)
        lp_text.setMargins(dp(self.context, 12), 0, dp(self.context, 8), 0)
        self.header_row.addView(text_col, lp_text)
        self.header_text_col = text_col

        self.title_view = TextView(self.context)
        self.title_view.setTextColor(Color.WHITE)
        self.title_view.setTextSize(16)
        self.title_view.setTypeface(Typeface.DEFAULT_BOLD)
        self.title_view.setSingleLine(True)
        self.title_view.setEllipsize(TextUtils.TruncateAt.END)
        text_col.addView(self.title_view, LinearLayout.LayoutParams(-1, -2))

        self.artist_view = TextView(self.context)
        self.artist_view.setTextColor(self._muted_text_color())
        self.artist_view.setTextSize(13)
        self.artist_view.setSingleLine(True)
        self.artist_view.setEllipsize(TextUtils.TruncateAt.END)
        lp_artist = LinearLayout.LayoutParams(-1, -2)
        lp_artist.setMargins(0, dp(self.context, 2), 0, 0)
        text_col.addView(self.artist_view, lp_artist)

        self.menu_button = TextView(self.context)
        self.menu_button.setText("\u00d7")
        self.menu_button.setTextColor(Color.WHITE)
        self.menu_button.setTextSize(26)
        self.menu_button.setGravity(Gravity.CENTER)
        self.menu_button.setTypeface(Typeface.DEFAULT)
        self.menu_button.setClickable(True)
        self.menu_button.setOnClickListener(ViewClickListener(lambda _v: self.close()))
        menu_size = dp(self.context, HEADER_MENU_TOUCH_SIZE_DP)
        self.header_row.addView(self.menu_button, LinearLayout.LayoutParams(menu_size, menu_size))

        self._update_header(self.track)
        self._build_compact_bar(status_h)

    # компактная панель с крестиком
    def _build_compact_bar(self, status_h: int) -> None:
        try:
            status_h = min(int(status_h), dp(self.context, COMPACT_BAR_MAX_STATUS_DP))
            self._compact_status_h = status_h
            self._compact_top_applied = status_h
            bar_h = status_h + dp(self.context, COMPACT_BAR_HEIGHT_DP)
            self._compact_bar_h_px = bar_h
            bar = LinearLayout(self.context)
            bar.setOrientation(LinearLayout.HORIZONTAL)
            bar.setGravity(Gravity.CENTER_VERTICAL | Gravity.RIGHT)
            bar.setPadding(dp(self.context, 4), status_h, dp(self.context, 8), 0)
            self._apply_compact_bar_bg(bar, status_h)
            bar.setClickable(False)

            self.frame_root.addView(bar, FrameLayout.LayoutParams(-1, bar_h, Gravity.TOP))
            bar.setVisibility(View.INVISIBLE)
            self.compact_bar = bar
            if not self._header_expanded and self.menu_button is not None:
                self.menu_button.setTranslationY(self._compact_close_ty())
                self.menu_button.setScaleX(COMPACT_CLOSE_SCALE)
                self.menu_button.setScaleY(COMPACT_CLOSE_SCALE)
        except Exception as e:
            self.log_dbg_fail("compact bar", e)

    # скрытие статус-бара
    def _hide_status_bar(self) -> None:
        try:
            window = self.dialog.getWindow() if self.dialog else None
            if window is None:
                return
            sdk = int(Build.VERSION.SDK_INT)
            try:
                decor = window.getDecorView()
                decor.setSystemUiVisibility(0x100 | 0x400 | 0x4 | 0x1000)
            except Exception:
                pass
            if sdk >= 30:
                try:
                    ctrl = window.getInsetsController()
                    if ctrl is not None:
                        types = jclass("android.view.WindowInsets$Type")
                        ctrl.hide(types.statusBars())
                        ctrl.setSystemBarsBehavior(2)
                except Exception as e:
                    self.log_dbg_fail("insets controller", e)
        except Exception as e:
            self.log_dbg_fail("hide status bar", e)

    # фон компактной панели
    def _apply_compact_bar_bg(self, bar, top_px: int) -> None:
        try:
            bar.setBackgroundColor(Color.TRANSPARENT)
        except Exception as e:
            self.log_dbg_fail("compact bar bg", e)

    # поправка отступа компактной панели
    def _install_compact_bar_inset_fix(self) -> None:
        try:
            if self.frame_root is None or not JARRAY_AVAILABLE:
                return
            viewer = self
            OnGL = jclass("android.view.ViewTreeObserver$OnGlobalLayoutListener")

            class _CompactInsetListener(dynamic_proxy(OnGL)):
                def onGlobalLayout(self_inner):
                    try:
                        viewer._sync_compact_bar_inset()
                    except Exception:
                        pass

            self._compact_gl_listener = _CompactInsetListener()
            self.frame_root.getViewTreeObserver().addOnGlobalLayoutListener(self._compact_gl_listener)
        except Exception as e:
            self.log_dbg_fail("compact inset listener", e)

    # синхронизация отступа панели
    def _sync_compact_bar_inset(self) -> None:
        bar = self.compact_bar
        if bar is None or self.frame_root is None:
            return
        loc = jarray(jint)([0, 0])
        self.frame_root.getLocationOnScreen(loc)
        top_off = max(0, int(loc[1]))
        need = max(0, int(self._compact_status_h) - top_off)
        if need < dp(self.context, 6):
            need = 0
        if need == self._compact_top_applied:
            return
        self._compact_top_applied = need
        bar_h = need + dp(self.context, COMPACT_BAR_HEIGHT_DP)
        bar.setPadding(dp(self.context, 4), need, dp(self.context, 8), 0)
        self._apply_compact_bar_bg(bar, need)
        lp = bar.getLayoutParams()
        lp.height = bar_h
        bar.setLayoutParams(lp)
        self._compact_bar_h_px = bar_h
        if not self._header_expanded and self.menu_button is not None:
            self.menu_button.setTranslationY(self._compact_close_ty())
        try:
            cm = self._top_fade_compact_mask
            if cm is not None and self._top_fade_len_px:
                cm.getPaint().setShader(
                    self._make_top_fade_shader(self._compact_fade_end_px(), self._top_fade_len_px))
                if self._top_fade_host is not None:
                    self._top_fade_host.invalidate()
        except Exception:
            pass

    # сдвиг крестика
    def _compact_close_ty(self) -> float:
        compact_center = float(self._compact_top_applied) + float(dp(self.context, COMPACT_BAR_HEIGHT_DP)) / 2.0
        return compact_center - float(self._big_close_center_px)

    # анимация крестика
    def _animate_compact_close(self, header_shown: bool, duration_ms: int) -> None:
        btn = self.menu_button
        if btn is None:
            return
        try:
            btn.setVisibility(View.VISIBLE)
        except Exception:
            pass
        if header_shown:
            ty, sc = 0.0, 1.0
        else:
            ty, sc = self._compact_close_ty(), COMPACT_CLOSE_SCALE
        self._animate_view_fade_slide(btn, 1.0, ty, duration_ms, target_scale=sc)

    # панель мини-плеера
    def _build_mini_player_bar(self) -> None:
        ctx = self.context
        try:
            bg = GradientDrawable()
            bg.setColor(Color.argb(252, 24, 24, 24))
            bg.setCornerRadius(dp(ctx, MINI_PLAYER_CORNER_DP))
            container = FrameLayout(ctx)
            container.setBackground(bg)
            try:
                container.setClipToOutline(True)
            except Exception:
                pass
            pad = dp(ctx, 10)
            container.setPadding(pad, dp(ctx, 6), pad, dp(ctx, 6))
        except Exception as e:
            self.log_dbg_fail("mini player container", e)
            return

        try:
            row = LinearLayout(ctx)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            container.addView(row, FrameLayout.LayoutParams(-1, dp(ctx, MINI_PLAYER_COVER_SIZE_DP + 8)))
        except Exception as e:
            self.log_dbg_fail("mini player row", e)
            return

        try:
            cover_bg = GradientDrawable()
            cover_bg.setColor(Color.TRANSPARENT)
            self._mini_cover_bg = cover_bg
            cover_bg.setCornerRadius(dp(ctx, 10))
            cover_holder = FrameLayout(ctx)
            cover_holder.setBackground(cover_bg)
            try:
                cover_holder.setClipToOutline(True)
            except Exception:
                pass
            self.mini_cover_view = ImageView(ctx)
            self.mini_cover_view.setScaleType(ImageView.ScaleType.CENTER_CROP)
            cover_holder.addView(self.mini_cover_view, FrameLayout.LayoutParams(-1, -1))
            cover_size = dp(ctx, MINI_PLAYER_COVER_SIZE_DP)
            lp_cover = LinearLayout.LayoutParams(cover_size, cover_size)
            lp_cover.setMargins(0, 0, dp(ctx, 12), 0)
            row.addView(cover_holder, lp_cover)
        except Exception as e:
            self.log_dbg_fail("mini player cover", e)

        try:
            text_col = LinearLayout(ctx)
            text_col.setOrientation(LinearLayout.VERTICAL)
            text_col.setGravity(Gravity.CENTER_VERTICAL)
            row.addView(text_col, LinearLayout.LayoutParams(0, -2, 1.0))

            self.mini_title_view = TextView(ctx)
            self.mini_title_view.setTextColor(Color.WHITE)
            self.mini_title_view.setTextSize(15)
            self.mini_title_view.setTypeface(Typeface.DEFAULT_BOLD)
            self.mini_title_view.setSingleLine(True)
            self.mini_title_view.setEllipsize(TextUtils.TruncateAt.END)
            text_col.addView(self.mini_title_view, LinearLayout.LayoutParams(-1, -2))

            self.mini_artist_view = TextView(ctx)
            self.mini_artist_view.setTextColor(self._muted_text_color())
            self.mini_artist_view.setTextSize(13)
            self.mini_artist_view.setSingleLine(True)
            self.mini_artist_view.setEllipsize(TextUtils.TruncateAt.END)
            lp_artist = LinearLayout.LayoutParams(-1, -2)
            lp_artist.setMargins(0, dp(ctx, 2), 0, 0)
            text_col.addView(self.mini_artist_view, lp_artist)
        except Exception as e:
            self.log_dbg_fail("mini player text", e)

        try:
            container.setClickable(True)
            container.setFocusable(True)
            container.setOnClickListener(ViewClickListener(lambda _v: self._toggle_playback()))
        except Exception as e:
            self.log_dbg_fail("mini player tap-to-toggle", e)

        self.mini_player_bar = container
        self._mini_player_hidden_ty = float(dp(ctx, MINI_PLAYER_HIDE_OFFSET_DP))
        try:
            self.mini_player_bar.setAlpha(0.0)
            self.mini_player_bar.setTranslationY(self._mini_player_hidden_ty)
            self.mini_player_bar.setVisibility(View.GONE)
        except Exception as e:
            self.log_dbg_fail("mini player initial state", e)

        try:
            lp_container = FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM)
            margin_side = dp(ctx, 12)
            margin_bottom = dp(ctx, 16)
            lp_container.setMargins(margin_side, 0, margin_side, margin_bottom)
            shield = View(ctx)
            shield.setClickable(True)
            shield.setFocusable(False)
            shield.setVisibility(View.GONE)
            shield_h = dp(ctx, MINI_PLAYER_COVER_SIZE_DP + 8 + 12 + 16 + 8)
            self.frame_root.addView(shield, FrameLayout.LayoutParams(-1, shield_h, Gravity.BOTTOM))
            self.mini_player_shield = shield
            self.frame_root.addView(self.mini_player_bar, lp_container)
        except Exception as e:
            self.log_dbg_fail("mini player attach", e)
            return

        self._update_mini_player_texts(self.track)

    # кнопка мини-плеера
    def _build_mini_player_toggle_btn(self) -> None:
        ctx = self.context
        try:
            btn = FrameLayout(ctx)
            bg = GradientDrawable()
            bg.setColor(Color.argb(252, 24, 24, 24))
            bg.setShape(GradientDrawable.OVAL)
            btn.setBackground(bg)
            btn.setClickable(True)
            btn.setFocusable(True)
            btn.setOnClickListener(ViewClickListener(lambda _v: self._toggle_mini_player()))
        except Exception as e:
            self.log_dbg_fail("mini player toggle button", e)
            return

        try:
            arm_len = dp(ctx, MINI_PLAYER_ARROW_ARM_LEN_DP)
            thickness = dp(ctx, MINI_PLAYER_ARROW_THICKNESS_DP)
            half = arm_len / 2.0
            offset = half * math.cos(math.radians(45))

            left_arm_bg = GradientDrawable()
            left_arm_bg.setColor(Color.WHITE)
            left_arm_bg.setCornerRadius(thickness / 2.0)
            left_arm = View(ctx)
            left_arm.setBackground(left_arm_bg)
            left_arm.setRotation(-45.0)
            left_arm.setTranslationX(-offset)
            btn.addView(left_arm, FrameLayout.LayoutParams(arm_len, thickness, Gravity.CENTER))

            right_arm_bg = GradientDrawable()
            right_arm_bg.setColor(Color.WHITE)
            right_arm_bg.setCornerRadius(thickness / 2.0)
            right_arm = View(ctx)
            right_arm.setBackground(right_arm_bg)
            right_arm.setRotation(45.0)
            right_arm.setTranslationX(offset)
            btn.addView(right_arm, FrameLayout.LayoutParams(arm_len, thickness, Gravity.CENTER))
        except Exception as e:
            self.log_dbg_fail("mini player toggle chevron", e)

        self.mini_player_toggle_btn = btn
        try:
            size = dp(ctx, MINI_PLAYER_TOGGLE_BTN_SIZE_DP)
            lp = FrameLayout.LayoutParams(size, size, Gravity.BOTTOM | Gravity.RIGHT)
            margin_side = dp(ctx, 12)
            margin_bottom = dp(ctx, 16)
            lp.setMargins(margin_side, 0, margin_side, margin_bottom)
            self.frame_root.addView(self.mini_player_toggle_btn, lp)
        except Exception as e:
            self.log_dbg_fail("mini player toggle button attach", e)

    # кнопка копирования
    def _build_copy_btn(self) -> None:
        ctx = self.context
        try:
            btn = FrameLayout(ctx)
            bg = GradientDrawable()
            bg.setColor(Color.argb(252, 24, 24, 24))
            bg.setShape(GradientDrawable.OVAL)
            btn.setBackground(bg)
            btn.setClickable(True)
            btn.setFocusable(True)
            btn.setOnClickListener(ViewClickListener(lambda _v: self._copy_lyrics_to_clipboard()))

            w, h, st, sh = dp(ctx, 13), dp(ctx, 15), dp(ctx, 2), dp(ctx, 3)
            back_bg = GradientDrawable()
            back_bg.setColor(Color.TRANSPARENT)
            back_bg.setStroke(st, Color.WHITE)
            back_bg.setCornerRadius(float(dp(ctx, 2)))
            back = View(ctx)
            back.setBackground(back_bg)
            back.setTranslationX(float(-sh))
            back.setTranslationY(float(-sh))
            btn.addView(back, FrameLayout.LayoutParams(w, h, Gravity.CENTER))

            front_bg = GradientDrawable()
            front_bg.setColor(Color.argb(255, 24, 24, 24))
            front_bg.setStroke(st, Color.WHITE)
            front_bg.setCornerRadius(float(dp(ctx, 2)))
            front = View(ctx)
            front.setBackground(front_bg)
            front.setTranslationX(float(sh))
            front.setTranslationY(float(sh))
            btn.addView(front, FrameLayout.LayoutParams(w, h, Gravity.CENTER))

            d = dp(ctx, 100) / 100.0
            t = 2.6 * d
            short_len, long_len = 8.0 * d, 15.5 * d
            k = math.cos(math.radians(45))
            vx = -(long_len * k - short_len * k) / 2.0
            vy = (long_len * k) / 2.0
            check = FrameLayout(ctx)

            def _bar(length, rot, cx, cy):
                bg_ = GradientDrawable()
                bg_.setColor(Color.WHITE)
                bg_.setCornerRadius(t / 2.0)
                v_ = View(ctx)
                v_.setBackground(bg_)
                v_.setRotation(rot)
                v_.setTranslationX(float(cx))
                v_.setTranslationY(float(cy))
                check.addView(v_, FrameLayout.LayoutParams(int(round(length)), int(round(t)), Gravity.CENTER))

            _bar(short_len, 45.0, vx - (short_len / 2.0) * k, vy - (short_len / 2.0) * k)
            _bar(long_len, -45.0, vx + (long_len / 2.0) * k, vy - (long_len / 2.0) * k)
            check.setVisibility(View.GONE)
            btn.addView(check, FrameLayout.LayoutParams(-1, -1))
            self._copy_check_view = check
            self._copy_icon_views = [back, front]
            self._copy_check_view = check

            btn.setVisibility(View.GONE)
            self._copy_btn = btn
            size = dp(ctx, COPY_BTN_SIZE_DP)
            lp = FrameLayout.LayoutParams(size, size, Gravity.BOTTOM | Gravity.RIGHT)
            lp.setMargins(dp(ctx, 12), 0, dp(ctx, 18), dp(ctx, 12))
            self.frame_root.addView(btn, lp)
        except Exception as e:
            self.log_dbg_fail("copy button", e)

    # переключение режима кнопки
    def _set_copy_mode(self, mode: Optional[bool]) -> None:
        try:
            toggle = self.mini_player_toggle_btn
            copy = getattr(self, "_copy_btn", None)
            if toggle is None or copy is None:
                return
            show_toggle = (mode is False) or (not self._header_expanded)
            show_copy = (mode is True) and self._header_expanded
            toggle.setVisibility(View.VISIBLE if show_toggle else View.GONE)
            copy.setVisibility(View.VISIBLE if show_copy else View.GONE)
        except Exception as e:
            self.log_dbg_fail("copy mode", e)

    # галочка после копирования
    def _flash_copy_done(self) -> None:
        try:
            check = getattr(self, "_copy_check_view", None)
            icons = getattr(self, "_copy_icon_views", None) or []
            if check is None:
                return
            for v in icons:
                v.setVisibility(View.INVISIBLE)
            check.setVisibility(View.VISIBLE)
            try:
                check.setScaleX(0.4)
                check.setScaleY(0.4)
                check.setAlpha(0.0)
                if ANIMATOR_AVAILABLE:
                    from android.view.animation import OvershootInterpolator
                    for prop, a0, a1 in (("scaleX", 0.4, 1.0), ("scaleY", 0.4, 1.0), ("alpha", 0.0, 1.0)):
                        oa = ObjectAnimator.ofFloat(check, prop, a0, a1)
                        oa.setDuration(220)
                        if prop != "alpha":
                            oa.setInterpolator(OvershootInterpolator(2.0))
                        oa.start()
                else:
                    check.setScaleX(1.0)
                    check.setScaleY(1.0)
                    check.setAlpha(1.0)
            except Exception:
                check.setScaleX(1.0)
                check.setScaleY(1.0)
                check.setAlpha(1.0)
            self._copy_flash_token = getattr(self, "_copy_flash_token", 0) + 1
            token = self._copy_flash_token

            def _revert():
                try:
                    if token != getattr(self, "_copy_flash_token", 0):
                        return
                    check.setVisibility(View.GONE)
                    for v in icons:
                        v.setVisibility(View.VISIBLE)
                except Exception:
                    pass

            _t = threading.Timer(1.5, lambda: run_on_ui_thread_safe(_revert))
            _t.daemon = True
            _t.start()
        except Exception as e:
            self.log_dbg_fail("copy flash", e)

    # копирование текста
    def _copy_lyrics_to_clipboard(self) -> None:
        try:
            with self._ui_lock:
                text = "\n".join(safe_str(t) for t in (self.lines or [])).strip()
            if not text:
                return
            from android.content import ClipData, Context
            cm = self.context.getSystemService(Context.CLIPBOARD_SERVICE)
            cm.setPrimaryClip(ClipData.newPlainText("lyrics", text))
            self._flash_copy_done()
            try:
                from android.widget import Toast
                Toast.makeText(self.context, "Текст скопирован", Toast.LENGTH_SHORT).show()
            except Exception:
                pass
        except Exception as e:
            self.log_dbg_fail("copy lyrics", e)
            try:
                from android.widget import Toast
                Toast.makeText(self.context, "Не удалось скопировать", Toast.LENGTH_SHORT).show()
            except Exception:
                pass

    # пауза и воспроизведение
    def _toggle_playback(self) -> None:
        try:
            if is_track_paused():
                resume_current_track()
            else:
                pause_current_track()
        except Exception as e:
            self.log_dbg_fail("_toggle_playback", e)

    # показ и скрытие мини-плеера
    def _toggle_mini_player(self) -> None:
        try:
            self._header_expanded = not self._header_expanded
            expanded = self._header_expanded
            duration = MINI_PLAYER_TOGGLE_DURATION_MS
            hide_ty = float(-dp(self.context, 10))

            self._animate_top_fade(expanded, duration)
            self._animate_compact_close(expanded, duration)

            header_views = [v for v in (self._header_art_holder, self.header_text_col,
                                         self._header_fade_view) if v is not None]
            for v in header_views:
                if v is self._header_art_holder and getattr(self, "_cover_state", "") == "none":
                    continue
                if expanded:
                    try:
                        v.setVisibility(View.VISIBLE)
                    except Exception:
                        pass
                    self._animate_view_fade_slide(v, 1.0, 0.0, duration)
                else:
                    self._animate_view_fade_slide(
                        v, 0.0, hide_ty, duration,
                        on_end=(lambda vv=v: self._set_view_invisible_safe(vv)))

            try:
                if self.mini_player_shield is not None:
                    self.mini_player_shield.setVisibility(View.GONE if expanded else View.VISIBLE)
            except Exception:
                pass
            if self.mini_player_bar is not None:
                if expanded:
                    self._animate_view_fade_slide(
                        self.mini_player_bar, 0.0, self._mini_player_hidden_ty, duration,
                        on_end=lambda: self._set_view_gone_safe(self.mini_player_bar))
                else:
                    try:
                        self.mini_player_bar.setVisibility(View.VISIBLE)
                    except Exception:
                        pass
                    self._animate_view_fade_slide(self.mini_player_bar, 1.0, 0.0, duration)

            if self.mini_player_toggle_btn is not None:
                arrow_target_ty = 0.0 if expanded else float(-dp(self.context, MINI_PLAYER_ARROW_UP_SHIFT_DP))
                arrow_target_rot = 0.0 if expanded else MINI_PLAYER_ARROW_ROTATION_DEG
                self._animate_view_fade_slide(
                    self.mini_player_toggle_btn, 1.0, arrow_target_ty, duration,
                    target_rotation=arrow_target_rot)
        except Exception as e:
            self.log_dbg_fail("_toggle_mini_player", e)

    # градиент затухания сверху
    def _make_top_fade_shader(self, fade_end: int, fade_len: int):
        total_h = max(1, int(fade_end) + int(fade_len))
        steps = 8
        colors = [0xFF000000, 0xFF000000]
        positions = [0.0, float(fade_end) / float(total_h)]
        for k in range(1, steps + 1):
            t = k / float(steps)
            erase = 1.0 - (t * t * (3.0 - 2.0 * t))
            colors.append((int(round(255 * erase)) & 0xFF) << 24)
            positions.append((fade_end + fade_len * t) / float(total_h))
        positions[-1] = 1.0
        colors = [c - 0x100000000 if c >= 0x80000000 else c for c in colors]
        return LinearGradient(
            0.0, 0.0, 0.0, float(total_h),
            jarray(jint)(colors) if JARRAY_AVAILABLE else colors,
            jarray(jfloat)(positions) if JARRAY_AVAILABLE else positions,
            Shader.TileMode.CLAMP,
        )

    # граница затухания сверху
    def _compact_fade_end_px(self) -> int:
        center = float(self._compact_top_applied) + float(dp(self.context, COMPACT_BAR_HEIGHT_DP)) / 2.0
        return int(center) + dp(self.context, COMPACT_FADE_BELOW_CLOSE_DP)

    # анимация затухания сверху
    def _animate_top_fade(self, show: bool, duration_ms: int) -> None:
        mask = self._top_fade_mask
        cmask = self._top_fade_compact_mask
        host = self._top_fade_host
        try:
            if self.header_overlay is not None:
                self.header_overlay.setClickable(bool(show))
        except Exception:
            pass
        if mask is None:
            return
        try:
            if self._top_fade_animator is not None:
                self._top_fade_animator.cancel()
        except Exception:
            pass
        self._top_fade_animator = None

        def set_clip(top_px: int) -> None:
            try:
                if self.scroll is not None:
                    self.scroll.setClipBounds(Rect(0, int(top_px), Integer.MAX_VALUE, Integer.MAX_VALUE))
            except Exception:
                pass

        target = 255 if show else 0
        if not show:
            set_clip(0)
        try:
            start = int(mask.getAlpha())
        except Exception:
            start = 255 if not show else 0
        ctarget = 0 if show else 255
        try:
            cstart = int(cmask.getAlpha()) if cmask is not None else ctarget
        except Exception:
            cstart = ctarget

        def finish() -> None:
            try:
                mask.setAlpha(target)
                if cmask is not None:
                    cmask.setAlpha(ctarget)
                if host is not None:
                    host.invalidate()
            except Exception:
                pass
            if show:
                set_clip(self._top_fade_clip_top_px)

        if not ANIMATOR_AVAILABLE or (start == target and cstart == ctarget):
            finish()
            return
        try:
            animator = ValueAnimator.ofFloat(0.0, 1.0)
            animator.setDuration(int(duration_ms))
            try:
                animator.setInterpolator(AccelerateDecelerateInterpolator())
            except Exception:
                pass

            class _FadeFrame(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self_inner, anim):
                    try:
                        t = float(anim.getAnimatedValue())
                        t_in = min(1.0, t / 0.4)
                        t_out = max(0.0, min(1.0, (t - 0.4) / 0.6))
                        if cmask is None:
                            mask.setAlpha(int(start + (target - start) * t))
                        elif show:
                            mask.setAlpha(int(start + (target - start) * t_in))
                            cmask.setAlpha(int(cstart + (ctarget - cstart) * t_out))
                        else:
                            cmask.setAlpha(int(cstart + (ctarget - cstart) * t_in))
                            mask.setAlpha(int(start + (target - start) * t_out))
                        if host is not None:
                            host.invalidate()
                    except Exception:
                        pass

            _cancelled = [False]

            class _FadeEnd(dynamic_proxy(Animator.AnimatorListener)):
                def onAnimationStart(self_inner, anim, *args):
                    pass

                def onAnimationCancel(self_inner, anim, *args):
                    _cancelled[0] = True

                def onAnimationEnd(self_inner, anim, *args):
                    if not _cancelled[0]:
                        finish()

                def onAnimationRepeat(self_inner, anim, *args):
                    pass

            animator.addUpdateListener(_FadeFrame())
            animator.addListener(_FadeEnd())
            animator.start()
            self._top_fade_animator = animator
        except Exception:
            finish()

    # скрыть view
    def _set_view_invisible_safe(self, view) -> None:
        try:
            view.setVisibility(View.INVISIBLE)
        except Exception:
            pass

    # убрать view
    def _set_view_gone_safe(self, view) -> None:
        try:
            view.setVisibility(View.GONE)
        except Exception:
            pass

    # анимация прозрачности и сдвига
    def _animate_view_fade_slide(self, view, target_alpha: float, target_ty_px: float,
                                  duration_ms: int, on_end=None,
                                  target_rotation: Optional[float] = None,
                                  target_scale: Optional[float] = None) -> None:
        if view is None:
            if on_end is not None:
                try:
                    on_end()
                except Exception:
                    pass
            return
        try:
            from_alpha = float(view.getAlpha())
        except Exception:
            from_alpha = 1.0
        try:
            from_ty = float(view.getTranslationY())
        except Exception:
            from_ty = 0.0
        from_scale = None
        if target_scale is not None:
            try:
                from_scale = float(view.getScaleX())
            except Exception:
                from_scale = 1.0
        from_rotation = None
        if target_rotation is not None:
            try:
                from_rotation = float(view.getRotation())
            except Exception:
                from_rotation = 0.0

        def apply(t: float):
            try:
                view.setAlpha(from_alpha + (target_alpha - from_alpha) * t)
                view.setTranslationY(from_ty + (target_ty_px - from_ty) * t)
                if from_rotation is not None:
                    view.setRotation(from_rotation + (target_rotation - from_rotation) * t)
                if from_scale is not None:
                    sc = from_scale + (target_scale - from_scale) * t
                    view.setScaleX(sc)
                    view.setScaleY(sc)
            except Exception:
                pass

        if not ANIMATOR_AVAILABLE:
            _af_animate_interpolated(duration_ms, lambda t: t, apply)
            if on_end is not None:
                try:
                    from android_utils import run_on_ui_thread
                    run_on_ui_thread(on_end, duration_ms)
                except Exception:
                    try:
                        on_end()
                    except Exception:
                        pass
            return

        try:
            _anims = [
                ObjectAnimator.ofFloat(view, "alpha", float(from_alpha), float(target_alpha)),
                ObjectAnimator.ofFloat(view, "translationY", float(from_ty), float(target_ty_px)),
            ]
            if from_rotation is not None:
                _anims.append(ObjectAnimator.ofFloat(view, "rotation", float(from_rotation), float(target_rotation)))
            if from_scale is not None:
                _anims.append(ObjectAnimator.ofFloat(view, "scaleX", float(from_scale), float(target_scale)))
                _anims.append(ObjectAnimator.ofFloat(view, "scaleY", float(from_scale), float(target_scale)))
            _aset = AnimatorSet()
            _aset.playTogether(*_anims)
            _aset.setDuration(int(duration_ms))
            try:
                _aset.setInterpolator(AccelerateDecelerateInterpolator())
            except Exception:
                pass
            if on_end is not None:
                class _NativeFadeEndListener(dynamic_proxy(Animator.AnimatorListener)):
                    def onAnimationStart(self, anim, *args):
                        pass

                    def onAnimationCancel(self, anim, *args):
                        pass

                    def onAnimationEnd(self, anim, *args):
                        try:
                            on_end()
                        except Exception:
                            pass

                    def onAnimationRepeat(self, anim, *args):
                        pass

                _aset.addListener(_NativeFadeEndListener())
            _aset.start()
            return
        except Exception as _e_native:
            try:
                self.log_dbg_fail("_animate_view_fade_slide(native)", _e_native)
            except Exception:
                pass

        try:
            animator = ValueAnimator.ofFloat(0.0, 1.0)
            animator.setDuration(duration_ms)
            try:
                animator.setInterpolator(AccelerateDecelerateInterpolator())
            except Exception:
                pass

            class _FadeSlideFrameListener(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self, anim):
                    try:
                        apply(float(anim.getAnimatedValue()))
                    except Exception:
                        pass

            animator.addUpdateListener(_FadeSlideFrameListener())

            if on_end is not None:
                class _FadeSlideEndListener(dynamic_proxy(Animator.AnimatorListener)):
                    def onAnimationStart(self, anim, *args):
                        pass

                    def onAnimationCancel(self, anim, *args):
                        pass

                    def onAnimationEnd(self, anim, *args):
                        try:
                            on_end()
                        except Exception:
                            pass

                    def onAnimationRepeat(self, anim, *args):
                        pass

                animator.addListener(_FadeSlideEndListener())

            animator.start()
        except Exception as e:
            self.log_dbg_fail("_animate_view_fade_slide", e)
            apply(1.0)
            if on_end is not None:
                try:
                    on_end()
                except Exception:
                    pass

    # обновление шапки
    def _update_header(self, track: "TrackInfo") -> None:
        if not self.title_view or not self.artist_view:
            return
        try:
            self.title_view.setText(track.title if track and track.title else "Без названия")
            display_artist = track.display_artist if track else ""
            if display_artist:
                self.artist_view.setText(display_artist)
                self.artist_view.setVisibility(View.VISIBLE)
            else:
                self.artist_view.setVisibility(View.GONE)
        except Exception:
            pass
        self._update_mini_player_texts(track)
        self._load_album_art_async()

    # обновление текста мини-плеера
    def _update_mini_player_texts(self, track: "TrackInfo") -> None:
        if self.mini_title_view is None or self.mini_artist_view is None:
            return
        try:
            self.mini_title_view.setText(track.title if track and track.title else "Без названия")
            display_artist = track.display_artist if track else ""
            if display_artist:
                self.mini_artist_view.setText(display_artist)
                self.mini_artist_view.setVisibility(View.VISIBLE)
            else:
                self.mini_artist_view.setVisibility(View.GONE)
        except Exception:
            pass

    # состояние обложки
    def _set_cover_state(self, state: str) -> None:
        try:
            self._cover_state = state
            vis = {"shown": View.VISIBLE, "loading": View.INVISIBLE, "none": View.GONE}.get(state, View.VISIBLE)
            holders = [getattr(self, "_header_art_holder", None)]
            try:
                if self.mini_cover_view is not None:
                    holders.append(self.mini_cover_view.getParent())
            except Exception:
                pass
            for h in holders:
                if h is not None:
                    try:
                        h.setVisibility(vis)
                    except Exception:
                        pass
            col = getattr(self, "header_text_col", None)
            if col is not None:
                lp = col.getLayoutParams()
                lp.setMargins(0 if state == "none" else dp(self.context, 12), 0, dp(self.context, 8), 0)
                col.setLayoutParams(lp)
        except Exception as e:
            _log_safe("cover state", e)

    # показ заглушки обложки
    def _show_placeholder_cover(self, generation: int) -> None:
        try:
            if generation != self._art_load_generation:
                return
            if getattr(self, "_real_cover_gen", -1) == generation:
                return
            if getattr(self, "_placeholder_gen", -1) == generation:
                return
            ph = _no_cover_bitmap()
            if ph is None:
                return
            self._placeholder_gen = generation
            for iv in (self.art_view, self.mini_cover_view):
                if iv is None:
                    continue
                iv.setImageBitmap(ph)
                try:
                    iv.setAlpha(0.0)
                    if ANIMATOR_AVAILABLE:
                        anim = ObjectAnimator.ofFloat(iv, "alpha", 0.0, 1.0)
                        anim.setDuration(PLACEHOLDER_FADE_MS)
                        anim.start()
                    else:
                        iv.setAlpha(1.0)
                except Exception:
                    try:
                        iv.setAlpha(1.0)
                    except Exception:
                        pass
        except Exception as e:
            _log_safe("placeholder cover", e)

    # загрузка обложки в фоне
    def _load_album_art_async(self) -> None:
        self._art_load_generation += 1
        generation = self._art_load_generation
        try:
            for holder_bg in (getattr(self, "_art_bg_drawable", None), getattr(self, "_mini_cover_bg", None)):
                try:
                    if holder_bg is not None:
                        holder_bg.setColor(Color.TRANSPARENT)
                except Exception:
                    pass
            for iv in (self.art_view, self.mini_cover_view):
                if iv is not None:
                    iv.setImageBitmap(None)
                    iv.setAlpha(1.0)
            if self._art_note_view:
                self._art_note_view.setVisibility(View.GONE)
            self._set_cover_state("shown")
            self._reset_background_tint()
        except Exception as e:
            _log_safe("cover reset", e)
        threading.Thread(
            target=lambda g=generation: self._load_album_art_bg(g),
            name="LyricsPlusArt", daemon=True,
        ).start()
        try:
            _t = threading.Timer(
                PLACEHOLDER_DELAY_SEC,
                lambda g=generation: run_on_ui_thread_safe(lambda: self._show_placeholder_cover(g)))
            _t.daemon = True
            _t.start()
        except Exception as e:
            _log_safe("placeholder timer", e)

    # поиск обложки
    def _find_cover_bitmap(self, track, allow_online: bool):
        _prune_cover_cache()
        fps = []
        try:
            fps = list(track.fingerprints) if track is not None else []
        except Exception:
            fps = []
        cache_paths = [os.path.join(_cover_dir(), "cover_fp_%s.jpg" % _cover_md5(fp)) for fp in fps]

        for cp in cache_paths:
            try:
                if os.path.exists(cp) and os.path.getsize(cp) > 0:
                    bmp = _decode_bitmap_bounded(cp, COVER_MAX_DIM)
                    if bmp is not None:
                        return bmp
            except Exception:
                pass

        def _remember(bmp):
            for cp in cache_paths[:1]:
                _save_bitmap_jpeg(bmp, cp)

        msg = None
        try:
            msg = get_playing_message_object()
        except Exception:
            msg = None

        try:
            path = _track_local_path(msg)
            if path:
                bmp = _embedded_cover_bitmap(path)
                if bmp is not None:
                    _remember(bmp)
                    return bmp
        except Exception as e:
            _log_safe("embedded cover", e)

        try:
            bmp = try_get_sharp_thumb_bitmap()
            if bmp is not None:
                return bmp
        except Exception:
            pass

        try:
            path = self._extract_album_art_path()
            if not path:
                path = _artwork_url_path(msg)
            if path:
                bmp = _decode_bitmap_bounded(path, COVER_MAX_DIM)
                if bmp is not None:
                    _remember(bmp)
                    return bmp
        except Exception as e:
            _log_safe("cover fallback", e)

        if allow_online and track is not None and (track.title or track.artist):
            try:
                path = self._fetch_cover_online(track.title, track.artist)
                if path:
                    bmp = _decode_bitmap_bounded(path, COVER_MAX_DIM)
                    if bmp is not None:
                        return bmp
            except Exception as e:
                _log_safe("cover online", e)
        return None

    # установка обложки
    def _apply_cover(self, generation: int, bitmap) -> None:
        tint_color = average_color_from_bitmap(bitmap) if bitmap is not None else None

        def apply():
            if generation != self._art_load_generation:
                return
            if bitmap is None:
                try:
                    self._set_cover_state("shown")
                    self._show_placeholder_cover(generation)
                except Exception:
                    pass
                try:
                    self._reset_background_tint()
                except Exception:
                    pass
                return
            try:
                for holder_bg in (getattr(self, "_art_bg_drawable", None), getattr(self, "_mini_cover_bg", None)):
                    if holder_bg is not None and tint_color is not None:
                        holder_bg.setColor(int(tint_color))
            except Exception:
                pass
            try:
                self._real_cover_gen = generation
                for iv in (self.art_view, self.mini_cover_view):
                    if iv is not None:
                        iv.setImageBitmap(bitmap)
                        iv.setAlpha(1.0)
                if self.art_view and self._art_note_view:
                    self._art_note_view.setVisibility(View.GONE)
            except Exception:
                pass
            self._set_cover_state("shown")
            try:
                self._apply_background_tint(tint_color)
            except Exception:
                pass

        run_on_ui_thread_safe(apply)

    # фоновая загрузка обложки
    def _load_album_art_bg(self, generation: int) -> None:
        track = self.track
        delays = (0.0, 2.5, 6.0)
        last = len(delays) - 1
        for attempt, delay in enumerate(delays):
            if delay:
                time.sleep(delay)
            if generation != self._art_load_generation:
                return
            try:
                bitmap = self._find_cover_bitmap(track, allow_online=(attempt == 0 or attempt == last))
            except Exception as e:
                _log_safe("find cover", e)
                bitmap = None
            if bitmap is not None:
                self._apply_cover(generation, bitmap)
                return
        if generation == self._art_load_generation:
            self._apply_cover(generation, None)

    # сброс цвета фона
    def _reset_background_tint(self) -> None:
        if not self.frame_root:
            return
        try:
            self.frame_root.setBackgroundColor(COLOR_BG)
        except Exception:
            pass

    # цвет фона по обложке
    def _apply_background_tint(self, tint_color: Optional[int]) -> None:
        if not self.frame_root:
            return
        if tint_color is None:
            self._reset_background_tint()
            return
        try:
            top_color = int(darken_color(tint_color, 0.55))
            bottom_color = Color.BLACK
            if JARRAY_AVAILABLE:
                colors_arr = jarray(jint)([top_color, bottom_color])
                gradient = GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM, colors_arr)
            else:
                gradient = GradientDrawable()
                gradient.setColor(top_color)
            self.frame_root.setBackground(gradient)
            try:
                window = self.dialog.getWindow() if self.dialog else None
                if window:
                    window.setStatusBarColor(STATUS_BAR_COLOR)
            except Exception:
                pass
        except Exception:
            self._reset_background_tint()

    # цвет панели шапки
    def _update_header_panel_color(self, color: int) -> None:
        if self.header_row is not None:
            try:
                self.header_row.setBackgroundColor(Color.TRANSPARENT)
            except Exception:
                pass
        if self._header_fade_view is not None:
            try:
                self._header_fade_view.setBackground(None)
            except Exception:
                pass

    # экран загрузки
    def _build_body_loading(self):
        self._set_copy_mode(None)
        container = FrameLayout(self.context)
        self._loading_container = container
        container.setPadding(0, self._header_content_height_px, 0, 0)
        self.root.addView(container, LinearLayout.LayoutParams(-1, 0, 1.0))

        box = LinearLayout(self.context)
        box.setOrientation(LinearLayout.VERTICAL)
        box.setGravity(Gravity.CENTER)
        box.setPadding(dp(self.context, 24), dp(self.context, 24), dp(self.context, 24), dp(self.context, 24))
        container.addView(box, FrameLayout.LayoutParams(-1, -1))

        progress = ProgressBar(self.context)
        box.addView(progress, LinearLayout.LayoutParams(dp(self.context, 42), dp(self.context, 42)))

        self.status_text = TextView(self.context)
        self.status_text.setText("Поиск текста…")
        self.status_text.setTextColor(self._muted_text_color())
        self.status_text.setTextSize(16)
        self.status_text.setGravity(Gravity.CENTER)
        lp = LinearLayout.LayoutParams(-1, -2)
        lp.setMargins(0, dp(self.context, 18), 0, 0)
        box.addView(self.status_text, lp)

    # запуск цикла синхронизации
    def _ensure_sync_loop(self) -> None:
        if self.sync_loop_started:
            return
        self.sync_loop_started = True
        threading.Thread(target=self._sync_loop, name="LyricsSyncLoop", daemon=True).start()

    # перезагрузка текста для трека
    def _reload_for_track(self, track: TrackInfo):
        if not self.root:
            return
        self.track = track
        self._track_sig = None
        self._update_header(track)
        self.load_generation += 1
        generation = self.load_generation
        self.loading_started_at = time.time()
        self.current_index = -1
        with self._ui_lock:
            self.lines = []
            self.line_times = []
            self.line_views = []
            self.line_rows = []
            self.line_click_listeners = []
            self._line_animators = {}
            self._chain_group_start = []
            self._chain_tie_earlier = []
            self._line_backing = []
            self._line_backing_join = []
            self._chain_recheck_done = set()
        self.has_synced = False
        self.last_scroll_target = -1
        self.scroll_animator = None
        self._scroll_target_index = -1
        self._auto_scroll_resume_at = 0.0
        self._last_shown_result = None
        self._ai_sync_auto_attempted_key = None

        try:
            _af_wave_cancel(self, reset=True)
            self._blur_anims = {}
            self._blur_cur = {}
            self._blur_applied_q = {}
        except Exception:
            pass
        self._remove_loading_overlay(animate=False)
        self.root.removeAllViews()
        self._build_body_loading()

        threading.Thread(
            target=lambda: self._load_lyrics_background(generation, track),
            name="LyricsLoad", daemon=True,
        ).start()

    # проверка смены трека
    def _check_track_changed(self) -> bool:
        try:
            if not is_music():
                return False
            msg, title, artist, duration, fallback = _read_track_raw()
            sig = (title, artist, fallback, duration)
            if sig == self.__dict__.get("_track_sig"):
                return False
            nt = TrackInfo(title=title, artist=artist, duration=duration, query_fallback=fallback, source_msg=msg)
            if not nt.query:
                return False
            if nt.cache_key != self.track.cache_key:
                now_t = time.time()
                if now_t - getattr(self, "_last_reload_at", 0.0) < 1.0:
                    return False
                self._last_reload_at = now_t
                self._reload_for_track(nt)
                self._track_sig = sig
                return True
            self._track_sig = sig
        except Exception as e:
            self.plugin.log("track change check failed: " + str(e))
        return False

    # вынос загрузки поверх экрана
    def _loading_overlay_detach(self) -> None:
        try:
            lc = getattr(self, "_loading_container", None)
            if lc is None or lc.getParent() is None:
                return
            if lc.getParent() is not self.root:
                return
            self.root.removeView(lc)
            lc.setClickable(False)
            self.frame_root.addView(lc, 1, FrameLayout.LayoutParams(-1, -1))
            self._loading_overlay = lc
        except Exception as e:
            self._dbg("loading", "overlay detach failed: " + str(e))

    # показ текста после загрузки
    def _reveal_lines(self) -> None:
        try:
            if getattr(self, "_reveal_busy", False):
                return
            lc = self.lines_container
            ov = getattr(self, "_loading_overlay", None)
            if ov is None:
                lc.setAlpha(1.0)
                return
            self._reveal_busy = True
            self._loading_overlay = None

            def _done():
                self._reveal_busy = False

            def _show():
                try:
                    if ov.getParent() is not None:
                        ov.getParent().removeView(ov)
                except Exception:
                    pass
                try:
                    self._animate_view_fade_slide(lc, 1.0, 0.0, 220, on_end=_done)
                except Exception:
                    lc.setAlpha(1.0)
                    _done()

            try:
                self._animate_view_fade_slide(ov, 0.0, 0.0, 130, on_end=_show)
            except Exception:
                _show()
        except Exception:
            self._reveal_busy = False
            try:
                self.lines_container.setAlpha(1.0)
            except Exception:
                pass

    # удаление экрана загрузки
    def _remove_loading_overlay(self, animate: bool = True) -> None:
        ov = getattr(self, "_loading_overlay", None)
        if ov is None:
            return
        self._loading_overlay = None

        def _rm():
            try:
                if ov.getParent() is not None:
                    ov.getParent().removeView(ov)
            except Exception:
                pass
        if not animate:
            _rm()
            return
        try:
            self._animate_view_fade_slide(ov, 0.0, 0.0, 220, on_end=_rm)
        except Exception:
            _rm()

    # загрузка текста в фоне
    def _load_lyrics_background(self, generation: int, track: TrackInfo):
        try:
            _t0 = time.monotonic()
            result = self.provider.get_lyrics(track)
            _left = MIN_LOADING_SEC - (time.monotonic() - _t0)
            if _left > 0:
                time.sleep(_left)
            if generation != self.load_generation:
                return
            try:
                if result is not None and result.lines and len(result.lines) > MAX_LYRIC_LINES:
                    result.lines = result.lines[:MAX_LYRIC_LINES]
            except Exception:
                pass
            run_on_ui_thread_safe(lambda r=result, g=generation: self._show_lyrics(r, g))
        except BaseException as e:
            self.plugin.log("Lyrics load failed: " + str(e))
            try:
                self.plugin.log(traceback.format_exc())
            except Exception:
                pass
            run_on_ui_thread_safe(lambda err=str(e), g=generation: self._show_error(err or "Ошибка поиска", g))

    # экран ошибки
    def _show_error(self, message: str, generation: Optional[int] = None):
        if not self.running or not self.root:
            return
        if generation is not None and generation != self.load_generation:
            return
        self._set_copy_mode(None)
        try:
            if not self.dialog or not self.dialog.isShowing():
                return
        except Exception:
            return
        try:
            self.loading_started_at = 0.0
            self._remove_loading_overlay(animate=False)
            self.root.removeAllViews()

            box = LinearLayout(self.context)
            box.setOrientation(LinearLayout.VERTICAL)
            box.setGravity(Gravity.CENTER)
            box.setPadding(dp(self.context, 24), dp(self.context, 24) + self._header_content_height_px,
                           dp(self.context, 24), dp(self.context, 24))
            self.root.addView(box, LinearLayout.LayoutParams(-1, 0, 1.0))

            title = TextView(self.context)
            title.setText("Текст не найден :<")
            title.setGravity(Gravity.CENTER)
            title.setTextColor(COLOR_TEXT_ERROR)
            title.setTextSize(22)
            title.setTypeface(Typeface.DEFAULT_BOLD)
            box.addView(title, LinearLayout.LayoutParams(-1, -2))

            msg = TextView(self.context)
            msg.setText(message)
            msg.setGravity(Gravity.CENTER)
            msg.setTextColor(self._muted_text_color())
            msg.setTextSize(15)
            lp = LinearLayout.LayoutParams(-1, -2)
            lp.setMargins(0, dp(self.context, 12), 0, 0)
            box.addView(msg, lp)

            retry = TextView(self.context)
            retry.setText("Повторить поиск")
            retry.setGravity(Gravity.CENTER)
            retry.setTextColor(Color.WHITE)
            retry.setTextSize(16)
            retry.setTypeface(Typeface.DEFAULT_BOLD)
            retry.setPadding(dp(self.context, 18), dp(self.context, 12), dp(self.context, 18), dp(self.context, 12))
            retry.setBackgroundColor(Color.rgb(32, 32, 32))
            retry.setOnClickListener(ViewClickListener(lambda _: self._retry()))
            lp_retry = LinearLayout.LayoutParams(-2, -2)
            lp_retry.setMargins(0, dp(self.context, 22), 0, 0)
            box.addView(retry, lp_retry)
        except Exception as e:
            self.plugin.log("_show_error crashed: " + str(e))

    # повторная попытка загрузки
    def _retry(self):
        if not self.root:
            return
        track = get_current_track_info()
        try:
            self.plugin.cache_forget_track(track)
        except Exception:
            pass
        self._reload_for_track(track)

    # построение экрана с текстом
    def _show_lyrics(self, result: LyricsResult, generation: Optional[int] = None):
        if not self.running or not self.root:
            return
        if generation is not None and generation != self.load_generation:
            return
        try:
            if not self.dialog or not self.dialog.isShowing():
                return
        except Exception:
            return
        try:
            self.loading_started_at = 0.0
            self.source_url = result.source_url
            self._last_shown_result = result
            self._loading_overlay_detach()
            self.root.removeAllViews()

            try:
                if result.synced:
                    _ts = {round(float_safe(it.get("time"), 0.0), 2) for it in result.lines
                           if isinstance(it, dict) and it.get("time") is not None and not it.get("pause")}
                    if len(_ts) < 2:
                        result.synced = False
            except Exception:
                pass
            self.has_synced = result.synced
            self._set_copy_mode(not result.synced)
            self.line_source = result.source
            self.scroll = ScrollView(self.context)
            self.scroll.setFillViewport(True)
            self.scroll.setClipToPadding(False)
            scroll_top_padding = self._header_content_height_px + dp(self.context, SCROLL_TOP_PADDING_DP)
            _plain_text = not result.synced
            _cover_bottom_px = self._header_cover_bottom_px
            if _plain_text and _cover_bottom_px:
                _cover_bottom_px = _cover_bottom_px - dp(self.context, TOP_FADE_END_BELOW_COVER_DP)
            self.scroll.setPadding(0, scroll_top_padding, 0, dp(self.context, SCROLL_BOTTOM_PADDING_DP - LINES_CONTAINER_BOTTOM_PAD_DP))
            try:
                self._top_fade_clip_top_px = min(scroll_top_padding, _cover_bottom_px or scroll_top_padding)
                self.scroll.setClipBounds(Rect(0, self._top_fade_clip_top_px if self._header_expanded else 0, Integer.MAX_VALUE, Integer.MAX_VALUE))
            except Exception:
                pass
            scroll_host = FrameLayout(self.context)
            scroll_host.addView(self.scroll, FrameLayout.LayoutParams(-1, -1))
            try:
                fade_len = dp(self.context, 24 if _plain_text else TOP_FADE_LENGTH_DP)
                fade_end = _cover_bottom_px or scroll_top_padding
                self._top_fade_len_px = fade_len
                xfer = PorterDuffXfermode(PorterDuff.Mode.DST_OUT)
                mask = ShapeDrawable(RectShape())
                mask.getPaint().setShader(self._make_top_fade_shader(fade_end, fade_len))
                mask.getPaint().setXfermode(xfer)
                scroll_host.setLayerType(View.LAYER_TYPE_HARDWARE, None)
                foreground = mask
                self._top_fade_compact_mask = None
                if JARRAY_AVAILABLE:
                    try:
                        from android.graphics.drawable import LayerDrawable
                        cmask = ShapeDrawable(RectShape())
                        cmask.getPaint().setShader(
                            self._make_top_fade_shader(self._compact_fade_end_px(), fade_len))
                        cmask.getPaint().setXfermode(PorterDuffXfermode(PorterDuff.Mode.DST_OUT))
                        drawable_cls = jclass("android.graphics.drawable.Drawable")
                        foreground = LayerDrawable(jarray(drawable_cls)([mask, cmask]))
                        self._top_fade_compact_mask = cmask
                        if self._header_expanded:
                            cmask.setAlpha(0)
                    except Exception as e:
                        foreground = mask
                        self._top_fade_compact_mask = None
                        self._dbg("fade", "compact fade mask failed: " + str(e))
                scroll_host.setForeground(foreground)
                self._top_fade_mask = mask
                self._top_fade_host = scroll_host
                if not self._header_expanded:
                    mask.setAlpha(0)
            except Exception as e:
                self._dbg("fade", "top fade mask failed: " + str(e))
            self.root.addView(scroll_host, LinearLayout.LayoutParams(-1, 0, 1.0))
            try:
                self.scroll.setClickable(True)
                self._screen_double_tap_listener = DoubleTapLineClickListener(
                    lambda _view: self._on_screen_tapped()
                )
                self.scroll.setOnClickListener(self._screen_double_tap_listener)
            except Exception:
                pass

            try:
                self._scroll_touch_listener = ScrollTouchListener(self._on_scroll_touch_activity)
                self.scroll.setOnTouchListener(self._scroll_touch_listener)
            except Exception:
                pass

            self.lines_container = LinearLayout(self.context)
            self.lines_container.setOrientation(LinearLayout.VERTICAL)
            self.lines_container.setGravity(Gravity.CENTER_HORIZONTAL)
            try:
                self.lines_container.setClipToPadding(False)
            except Exception:
                pass
            self.lines_container.setPadding(dp(self.context, self._side_padding_dp()), 0, dp(self.context, self._side_padding_dp()),
                                            dp(self.context, LINES_CONTAINER_BOTTOM_PAD_DP))
            self.scroll.addView(self.lines_container, ScrollView.LayoutParams(-1, -2))
            self._intro_spacer = None
            self._intro_countdown_view = None
            self._intro_countdown_views = []
            self._intro_countdown_front = 0
            self._intro_countdown_last = 0
            self._intro_note_view = None
            self._intro_note_hidden = False
            if result.synced:
                try:
                    spacer = FrameLayout(self.context)
                    try:
                        spacer.setClipChildren(False)
                    except Exception:
                        pass
                    align = self._lyric_align()
                    hgrav = Gravity.LEFT if align == LYRIC_ALIGN_LEFT else (
                        Gravity.RIGHT if align == LYRIC_ALIGN_RIGHT else Gravity.CENTER_HORIZONTAL)
                    cd_views = []
                    cd = TextView(self.context)
                    cd.setText("3")
                    cd.setTextColor(Color.argb(235, 255, 255, 255))
                    cd.setTextSize(44)
                    cd.setTypeface(Typeface.DEFAULT_BOLD)
                    cd.setIncludeFontPadding(False)
                    cd.setAlpha(1.0)
                    cd.setVisibility(View.INVISIBLE)
                    cd_lp = FrameLayout.LayoutParams(-2, -2, Gravity.BOTTOM | hgrav)
                    cd_lp.setMargins(0, 0, 0, dp(self.context, 14))
                    spacer.addView(cd, cd_lp)
                    cd_views.append(cd)
                    cd = cd_views[0]
                    self.lines_container.addView(
                        spacer, LinearLayout.LayoutParams(-1, dp(self.context, INTRO_SPACER_MIN_DP)))
                    self._intro_spacer = spacer
                    self._intro_countdown_views = cd_views
                    self._intro_countdown_view = cd
                except Exception as e:
                    self._dbg("intro", "intro spacer failed: " + str(e))
            self.lines_container.setAlpha(0.0)
            self._reveal_busy = False

            with self._ui_lock:
                self.lines = []
                self.line_times = []
                self.line_views = []
                self.line_rows = []
                self.line_click_listeners = []
                self._line_animators = {}
                self._chain_group_start = []
                self._chain_tie_earlier = []
                self._line_backing = []
                self._line_backing_join = []
                self._chain_recheck_done = set()

            _lines: List[str] = []
            _times: List[Optional[float]] = []
            _views: List[TextView] = []
            _rows: List[FrameLayout] = []
            _listeners: List[Any] = []
            _gap_note_views: List[TextView] = []
            self._stop_gap_note_pulse()
            try:
                _bk_items = [it for it in (result.lines if result.synced else []) if isinstance(it, dict)]
                if self._backing_vocal_enabled():
                    _bk_flags, _bk_join = _detect_backing_lines(_bk_items)
                else:
                    _bk_flags = [False] * len(_bk_items)
                    _bk_join = [False] * len(_bk_items)
                if getattr(result, "source", "") == "AI-Sync":
                    _bk_flags = [False] * len(_bk_items)
                    _bk_join = [False] * len(_bk_items)
            except Exception as _e:
                self.plugin.log("backing detect failed: " + safe_str(_e))
                _bk_flags, _bk_join = [], []

            _h_gravity = self._lyric_line_gravity()
            _h_inactive_color = self._inactive_text_color()
            _h_active_size = self._active_line_text_size()
            _h_unsynced_size = self._unsynced_text_size()
            _h_ratio = self._inactive_scale_ratio()
            _h_empty_h = dp(self.context, EMPTY_LINE_HEIGHT_DP)
            _h_margin_v = dp(self.context, LINE_MARGIN_VERTICAL_DP)
            _h_margin_tie = dp(self.context, BACKING_TIE_MARGIN_DP)

            def _build_row(index, item):
                if not isinstance(item, dict):
                    return
                line = safe_str(item.get("text"))
                tv = item.get("time")
                _lines.append(line)
                _times.append(None if tv is None else float_safe(tv, None))

                v = TextView(self.context)
                v.setGravity(_h_gravity)
                v.setTextColor(_h_inactive_color if result.synced else COLOR_TEXT_ACTIVE)
                v.setTextSize(_h_active_size if result.synced else _h_unsynced_size)
                v.setTypeface(Typeface.DEFAULT_BOLD)
                v.setIncludeFontPadding(True)
                v.setText(line if line else " ")
                v.setScaleX(1.0)
                v.setScaleY(1.0)
                v.setAlpha(1.0)
                v.setTranslationY(0.0)
                if result.synced and line.strip() == MUSIC_GAP_MARKER:
                    try:
                        v.setText("\u266b")
                        v.setTypeface(Typeface.DEFAULT_BOLD)
                        try:
                            v.getPaint().setFakeBoldText(True)
                        except Exception:
                            pass
                        v.setTextSize(float(_h_active_size) * 1.25)
                        v.setLetterSpacing(0.12)
                        v.setGravity(_h_gravity)
                        _gap_note_views.append((index, v))
                    except Exception:
                        pass
                if result.synced:
                    self._set_line_blur(v, blurred=True)

                if tv is not None:
                    try:
                        listener = LineGestureClickListener(
                            on_single_tap=lambda _view, i=index: self._on_line_single_tap(i),
                            on_double_tap=lambda _view, i=index: self._on_line_double_tap(i),
                        )
                        v.setClickable(True)
                        v.setOnClickListener(listener)
                        _listeners.append(listener)
                    except Exception:
                        pass

                row = FrameLayout(self.context)
                row.addView(v, FrameLayout.LayoutParams(-1, -2, Gravity.CENTER_VERTICAL))
                if result.synced:
                    ratio = _h_ratio
                    row.setScaleX(ratio)
                    row.setScaleY(ratio)
                else:
                    row.setScaleX(1.0)
                    row.setScaleY(1.0)
                row.setTranslationY(0.0)
                
                self._apply_row_alpha_instant(row, is_active=(not result.synced))

                lp = LinearLayout.LayoutParams(-1, -2 if line else _h_empty_h)
                tied_with_prev = (
                    tv is not None and index > 0 and _times[index - 1] is not None
                    and float_safe(tv) <= float_safe(_times[index - 1])
                )
                next_tv = None
                if index + 1 < len(result.lines):
                    nxt = result.lines[index + 1]
                    if isinstance(nxt, dict):
                        next_tv = nxt.get("time")
                tied_with_next = (
                    tv is not None and next_tv is not None
                    and float_safe(next_tv) <= float_safe(tv)
                )
                if index < len(_bk_join) and _bk_join[index]:
                    tied_with_prev = True
                if index + 1 < len(_bk_join) and _bk_join[index + 1]:
                    tied_with_next = True
                top_margin = BACKING_TIE_MARGIN_DP if tied_with_prev else LINE_MARGIN_VERTICAL_DP
                bottom_margin = BACKING_TIE_MARGIN_DP if tied_with_next else LINE_MARGIN_VERTICAL_DP
                lp.setMargins(0, _h_margin_tie if tied_with_prev else _h_margin_v,
                              0, _h_margin_tie if tied_with_next else _h_margin_v)
                self.lines_container.addView(row, lp)
                _views.append(v)
                _rows.append(row)

            def _finish():
                if not result.synced:
                    try:
                        _texts = [safe_str(it.get("text")) for it in result.lines if isinstance(it, dict)]
                        _full = "\n".join(_texts).strip()
                        pv = TextView(self.context)
                        pv.setGravity(self._lyric_line_gravity())
                        pv.setTextColor(COLOR_TEXT_ACTIVE)
                        pv.setTextSize(self._unsynced_text_size())
                        pv.setTypeface(Typeface.DEFAULT_BOLD)
                        pv.setIncludeFontPadding(True)
                        pv.setText(_full if _full else " ")
                        try:
                            pv.setTextIsSelectable(True)
                        except Exception as _e:
                            self._dbg("plain", "selectable failed: " + str(_e))
                        prow = FrameLayout(self.context)
                        prow.addView(pv, FrameLayout.LayoutParams(-1, -2, Gravity.CENTER_VERTICAL))
                        self._apply_row_alpha_instant(prow, is_active=True)
                        plp = LinearLayout.LayoutParams(-1, -2)
                        plp.setMargins(0, dp(self.context, LINE_MARGIN_VERTICAL_DP), 0, dp(self.context, LINE_MARGIN_VERTICAL_DP))
                        self.lines_container.addView(prow, plp)
                        _lines.append(_full)
                        _times.append(None)
                        _views.append(pv)
                        _rows.append(prow)
                    except Exception as _e:
                        self.plugin.log("plain text view failed: " + safe_str(_e))

                with self._ui_lock:
                    self.lines = _lines
                    self.line_times = _times
                    self.line_views = _views
                    self.line_rows = _rows
                    self.line_click_listeners = _listeners
                    self._line_backing = list(_bk_flags)
                    self._line_backing_join = list(_bk_join)

                self._compute_chain_groups()
                self._start_gap_note_pulse(_gap_note_views)
                try:
                    if (result.synced and _rows and _lines and _lines[0].strip() == MUSIC_GAP_MARKER
                            and self._intro_spacer is not None and self._intro_countdown_view is not None):
                        cd0 = self._intro_countdown_view
                        self._intro_spacer.removeView(cd0)
                        _al = self._lyric_align()
                        _hg = Gravity.LEFT if _al == LYRIC_ALIGN_LEFT else (
                            Gravity.RIGHT if _al == LYRIC_ALIGN_RIGHT else Gravity.CENTER_HORIZONTAL)
                        _rows[0].setMinimumHeight(dp(self.context, 56))
                        _rows[0].addView(cd0, FrameLayout.LayoutParams(-2, -2, Gravity.CENTER_VERTICAL | _hg))
                        self._intro_note_view = _views[0]
                except Exception as e:
                    self._dbg("intro", "countdown reparent failed: " + str(e))

                self.source_text = TextView(self.context)
                self.source_text.setGravity(Gravity.CENTER)
                self.source_text.setTextColor(self._muted_text_color())
                self.source_text.setTextSize(12)
                src = safe_str(result.source, "LRCLIB")
                self.source_text.setText(f"Источник текста: {src} ♪" if result.synced else f"Источник текста: {src} • без таймкодов")
                lp_s = LinearLayout.LayoutParams(-1, -2)
                lp_s.setMargins(0, dp(self.context, 24), 0, dp(self.context, 30))
                self.lines_container.addView(self.source_text, lp_s)

                if result.synced:
                    self._update_current_line(force=True, instant_scroll=True)
                    self._schedule_initial_scroll(generation)
                else:
                    self.current_index = -1
                    self._reveal_lines()

            self._show_token = getattr(self, "_show_token", 0) + 1
            _my_token = self._show_token
            _build_items = list(enumerate(result.lines if result.synced else []))
            _build_state = {"pos": 0}

            def _build_chunk():
                try:
                    if (not self.running) or _my_token != self._show_token:
                        return
                    if generation is not None and generation != self.load_generation:
                        return
                    try:
                        if not self.dialog or not self.dialog.isShowing():
                            return
                    except Exception:
                        return
                    total = len(_build_items)
                    pos = _build_state["pos"]
                    t0 = time.perf_counter()
                    while pos < total:
                        _build_row(*_build_items[pos])
                        pos += 1
                        if pos < total and (pos & 7) == 0 and (time.perf_counter() - t0) > 0.012:
                            break
                    _build_state["pos"] = pos
                    if pos < total:
                        run_on_ui_thread_safe(_build_chunk, 1)
                        return
                    _finish()
                except Exception as e:
                    self.plugin.log("_show_lyrics crashed: " + str(e))
                    plog_crash("Viewer", "_show_lyrics упал", e)
                    self._show_error("Не удалось отрисовать текст песни", generation)

            _build_chunk()
        except Exception as e:
            self.plugin.log("_show_lyrics crashed: " + str(e))
            plog_crash("Viewer", "_show_lyrics упал", e)
            self._show_error("Не удалось отрисовать текст песни", generation)

    # цикл синхронизации с плеером
    def _sync_loop(self):
        while self.running:
            delay = self._next_tick_delay()
            time.sleep(delay)
            try:
                if not self.dialog or not self.dialog.isShowing():
                    self.running = False
                    break
                _now = time.time()
                if getattr(self, "_tick_busy", False) and _now - getattr(self, "_tick_posted_at", 0.0) < 0.4:
                    continue
                self._tick_busy = True
                self._tick_posted_at = _now
                run_on_ui_thread_safe(self._sync_tick)
            except Exception:
                self.running = False
                break
        self.sync_loop_started = False
        _gil_boost_off(self)

    # задержка до следующего тика
    def _next_tick_delay(self) -> float:
        try:
            if not self.has_synced or not self.line_times:
                return SYNC_INTERVAL_SEC
            cur = self.current_index
            ni = cur + 1
            if ni >= len(self.line_times):
                return SYNC_INTERVAL_SEC
            nt = self.line_times[ni]
            if nt is None:
                return SYNC_INTERVAL_SEC
            progress = max(0.0, get_current_progress_sec() + self._sync_offset_sec())
            remaining = float(nt) - progress
            if remaining <= 0:
                return MIN_SYNC_INTERVAL_SEC
            cap = min(SYNC_INTERVAL_SEC, remaining)
            ni2 = ni + 1
            if ni2 < len(self.line_times):
                nt2 = self.line_times[ni2]
                if nt2 is not None:
                    gap_after = float(nt2) - float(nt)
                    if 0.0 < gap_after < (SYNC_INTERVAL_SEC * 2.0):
                        cap = min(cap, max(MIN_SYNC_INTERVAL_SEC, gap_after / 2.0))
            return max(MIN_SYNC_INTERVAL_SEC, cap)
        except Exception:
            return SYNC_INTERVAL_SEC

    # один тик синхронизации
    def _sync_tick(self):
        try:
            now = time.time()
            if now - getattr(self, "_last_track_check", 0.0) >= 0.8:
                self._last_track_check = now
                if self._check_track_changed():
                    return
            if now - getattr(self, "_last_loading_check", 0.0) >= 0.5:
                self._last_loading_check = now
                if self._check_loading_timeout():
                    return
            self._update_current_line()
            self._update_intro_countdown()
        except Exception as e:
            self.plugin.log("_sync_tick crashed: " + str(e))
        finally:
            self._tick_busy = False

    # таймаут загрузки
    def _check_loading_timeout(self) -> bool:
        try:
            if self.loading_started_at <= 0 or self.line_views:
                return False
            if time.time() - self.loading_started_at < SEARCH_UI_TIMEOUT_SEC:
                return False
            self.load_generation += 1
            self.loading_started_at = 0.0
            self._show_error(SEARCH_TIMEOUT_MESSAGE, None)
            return True
        except Exception:
            return False

    # лог ошибки
    def log_dbg_fail(self, where: str, e: Exception) -> None:
        try:
            self.plugin.log("LyricFy quick-settings: " + where + " failed: " + repr(e))
        except Exception:
            pass

    # тап по экрану
    def _on_screen_tapped(self) -> None:
        try:
            if is_track_paused():
                resume_current_track()
            else:
                pause_current_track()
        except Exception as e:
            self._dbg("core", "_on_screen_tapped crashed: " + str(e))

    # одиночный тап по строке
    def _on_line_single_tap(self, index: int) -> None:
        try:
            if self._seek_requires_double_tap():
                return
            if self._pause_on_active_line_tap():
                active = self._active_chain_indices(self.current_index) if self.current_index >= 0 else []
                if index in active:
                    return
            self._seek_to_line_index(index)
        except Exception as e:
            self._dbg("core", "_on_line_single_tap crashed: " + str(e))

    # двойной тап по строке
    def _on_line_double_tap(self, index: int) -> None:
        try:
            if not self._pause_on_active_line_tap():
                self._seek_to_line_index(index)
                return
            active = self._active_chain_indices(self.current_index) if self.current_index >= 0 else []
            if is_track_paused():
                if index not in active:
                    self._seek_to_line_index(index)
                resume_current_track()
                return
            if index in active:
                pause_current_track()
                return
            self._seek_to_line_index(index)
        except Exception as e:
            self._dbg("core", "_on_line_double_tap crashed: " + str(e))

    # перемотка к строке
    def _seek_to_line_index(self, index: int) -> None:
        try:
            if index < 0 or index >= len(self.line_times):
                return
            tv = self.line_times[index]
            if tv is None:
                return
            seconds = max(0.0, float_safe(tv, 0.0))
            ok = seek_current_track_to_sec(seconds, self.track.duration)
            if ok:
                self._last_seek_at = time.time()
                self._update_current_line(force=True, instant_scroll=False, override_index=index)
                try:
                    row = self.line_rows[index]
                    row.animate().cancel()
                    row.setScaleX(row.getScaleX() * 0.97)
                    row.setScaleY(row.getScaleY() * 0.97)
                    row.animate().scaleX(1.0).scaleY(1.0).setDuration(120).start()
                except Exception:
                    pass
        except Exception as e:
            self.plugin.log("line double-tap seek failed: " + str(e))

    # смена активной строки
    def _update_current_line(self, force: bool = False, instant_scroll: bool = False, override_index: Optional[int] = None):
        with self._ui_lock:
            if not self.line_views:
                return
            snap = list(self.line_views)
            rows_snap = list(self.line_rows)
        if not snap:
            return
        try:
            if not self.has_synced:
                if self.current_index != -1:
                    self.current_index = -1
                    for i, v in enumerate(snap):
                        try:
                            prev = self._line_animators.pop(i, None)
                            if prev is not None:
                                prev.cancel()
                            self._reset_line_color(i, v, is_active=False)
                            row = rows_snap[i] if i < len(rows_snap) else None
                            if row is not None:
                                row.animate().cancel()
                                row.setScaleX(1.0)
                                row.setScaleY(1.0)
                                row.setTranslationY(0.0)
                                row.setAlpha(1.0)
                            v.animate().cancel()
                            v.setTextColor(self._inactive_text_color())
                            v.setTextSize(self._line_text_size())
                            v.setTypeface(Typeface.DEFAULT_BOLD)
                        except Exception:
                            pass
                return

            index = override_index if override_index is not None else self._calculate_current_index()
            if index < 0 or index >= len(snap):
                return
            if (override_index is None and self.current_index < 0 and index == 0
                    and not self._row0_is_marker() and self._intro_pending()):
                return
            if not force and index == self.current_index:
                self._recheck_chain_disconnects(index, rows_snap, snap)
                return

            old = self.current_index
            self.current_index = index
            self._sync_gap_note_pulse()

            if not force and old >= 0 and old != index:
                try:
                    if is_track_paused():
                        raw_now = _get_current_progress_sec_raw()
                        interp_now = get_current_progress_sec()
                        self._dbg(
                            "sync",
                            "index changed {}->{} while track reported PAUSED "
                            "(raw={:.3f}s interpolated={:.3f}s) -- unexpected, please "
                            "attach this log if lyrics visibly jumped just now".format(
                                old, index, raw_now, interp_now
                            ),
                        )
                except Exception:
                    pass

            now_wall = time.time()
            if not force and old >= 0:
                held_ms = int((now_wall - self._current_index_set_at) * 1000) if self._current_index_set_at > 0 else None
                if held_ms is not None and held_ms < SHORT_LINE_WARN_MS:
                    old_text = self.lines[old] if 0 <= old < len(self.lines) else None
                    self._dbg(
                        "sync",
                        "short dwell: line [{}]={!r} was current for only {}ms before -> {}".format(
                            old, old_text if old_text else "(пусто)", held_ms, index
                        ),
                    )
            self._current_index_set_at = now_wall

            old_active = self._active_chain_indices(old) if old >= 0 else []
            new_active = self._active_chain_indices(index)
            old_active_set = set(old_active)
            new_active_set = set(new_active)

            if not force and old >= 0 and index - old > 1:
                gap_ms = None
                try:
                    t_old = self.line_times[old] if old < len(self.line_times) else None
                    t_new = self.line_times[index] if index < len(self.line_times) else None
                    if t_old is not None and t_new is not None:
                        gap_ms = int((float(t_new) - float(t_old)) * 1000)
                except Exception:
                    pass
                skipped_texts = []
                try:
                    for skipped_i in range(old + 1, index):
                        if skipped_i in new_active_set:
                            continue
                        raw = self.lines[skipped_i] if skipped_i < len(self.lines) else None
                        skipped_texts.append("[{}]={!r}".format(skipped_i, raw if raw else "(пусто)"))
                except Exception:
                    pass
                if skipped_texts:
                    self._dbg(
                        "sync",
                        "jumped {}->{} (gap {} ms), skipped: {}".format(
                            old, index, gap_ms if gap_ms is not None else "?",
                            ", ".join(skipped_texts)
                        ),
                    )

            if old in new_active_set:
                primary_old_row, primary_old_view, primary_old_index = None, None, -1
            else:
                primary_old_row = rows_snap[old] if 0 <= old < len(rows_snap) else None
                primary_old_view = snap[old] if 0 <= old < len(snap) else None
                primary_old_index = old
            new_row = rows_snap[index] if index < len(rows_snap) else None
            self._animate_transition(primary_old_row, primary_old_view, primary_old_index,
                                      new_row, snap[index], index, force=force,
                                      is_backing=self._is_backing_index(index))

            for i in new_active_set - old_active_set - {index}:
                if 0 <= i < len(rows_snap) and rows_snap[i] is not None and i < len(snap):
                    self._chain_recheck_done.discard(i)
                    self._animate_transition(None, None, -1, rows_snap[i], snap[i], i,
                                              force=force, is_backing=self._is_backing_index(i))
            self._chain_recheck_done.discard(index)
            for i in old_active_set - new_active_set - {primary_old_index}:
                if i in self._chain_recheck_done:
                    continue
                if 0 <= i < len(rows_snap) and rows_snap[i] is not None and i < len(snap):
                    self._chain_recheck_done.add(i)
                    self._disconnect_line(i, rows_snap[i], snap[i], force=force)

            if force or not self._is_auto_scroll_suppressed():
                self._scroll_to_range(new_active[0], index, instant=instant_scroll)
        except Exception as e:
            self._dbg("core", "_update_current_line crashed: " + str(e) + " | \n" + traceback.format_exc().replace("\n", " ¶ "))

    # целевое состояние строки
    def _line_target_state(self, is_active: bool, is_backing: bool = False) -> Tuple[float, int, float, float]:
        _now = time.monotonic()
        _memo = self.__dict__.get("_lts_memo")
        _key = (bool(is_active), bool(is_backing))
        if _memo is not None and _now - _memo[0] < 0.4:
            _hit = _memo[1].get(_key)
            if _hit is not None:
                return _hit
        else:
            _memo = (_now, {})
            self._lts_memo = _memo
        _val = self._line_target_state_compute(is_active, is_backing)
        _memo[1][_key] = _val
        return _val

    # расчет состояния строки
    def _line_target_state_compute(self, is_active: bool, is_backing: bool = False) -> Tuple[float, int, float, float]:
        ratio = self._inactive_scale_ratio()
        backing = is_backing and is_active
        if backing:
            scale = (ratio + 1.0) / 2.0
        else:
            scale = 1.0 if is_active else ratio
        color = COLOR_TEXT_ACTIVE if is_active else self._inactive_text_color()
        translation = 0.0
        if backing:
            alpha = self._backing_vocal_alpha()
        else:
            alpha = 1.0 if is_active else INACTIVE_VIEW_ALPHA
        return scale, color, translation, alpha

    # центр масштабирования строки
    def _apply_scale_pivot(self, row: FrameLayout, align=None) -> None:
        try:
            width = float(row.getWidth())
            height = float(row.getHeight())
            if width <= 0.0:
                return
            if align is None:
                align = self._lyric_align()
            if align == LYRIC_ALIGN_LEFT:
                row.setPivotX(0.0)
            elif align == LYRIC_ALIGN_RIGHT:
                row.setPivotX(width)
            else:
                row.setPivotX(width / 2.0)
            row.setPivotY(height / 2.0)
        except Exception:
            pass

    # мгновенный масштаб
    def _apply_scale_state_instant(self, row: FrameLayout, is_active: bool, is_backing: bool = False) -> None:
        scale, _color, translation, _alpha = self._line_target_state(is_active, is_backing)
        self._apply_scale_pivot(row)
        try:
            row.setScaleX(scale)
            row.setScaleY(scale)
        except Exception:
            pass

    # мгновенная прозрачность
    def _apply_row_alpha_instant(self, row: FrameLayout, is_active: bool, is_backing: bool = False) -> None:
        _scale, _color, _translation, alpha = self._line_target_state(is_active, is_backing)
        try:
            row.setAlpha(alpha)
        except Exception:
            pass

    # размытие строки
    def _set_line_blur(self, view: Optional[TextView], blurred: bool, animate: bool = False) -> None:
        if view is None:
            return
        want = bool(blurred)
        if want and not setting_bool(self.plugin, "blur_enabled", DEFAULT_BLUR_ENABLED):
            want = False
        try:
            cur = view.getTag()
            if cur is not None and bool(cur) == want:
                return
        except Exception:
            pass
        try:
            radius_px = float(dp(self.context, INACTIVE_LINE_BLUR_RADIUS_DP))
            if RENDER_EFFECT_AVAILABLE and RenderEffect is not None and radius_px > 0:
                if animate and ANIMATOR_AVAILABLE:
                    try:
                        _tag = view.getTag()
                        was = _tag is not None and bool(_tag)
                    except Exception:
                        was = False
                    view.setTag(want)
                    _af_blur_animate(self, view, want, radius_px, was)
                    return
                try:
                    _hk = int(view.hashCode())
                    getattr(self, "_blur_cur", {}).pop(_hk, None)
                    getattr(self, "_blur_applied_q", {}).pop(_hk, None)
                except Exception:
                    pass
                if want:
                    effect = getattr(self, "_blur_effect", None)
                    if effect is None:
                        sigma = max(0.5, radius_px * 0.6)
                        effect = RenderEffect.createBlurEffect(sigma, sigma, Shader.TileMode.CLAMP)
                        self._blur_effect = effect
                    view.setRenderEffect(effect)
                else:
                    view.setRenderEffect(None)
                view.setTag(want)
                return
            if not BLUR_MASK_FILTER_AVAILABLE:
                return
            paint = view.getPaint()
            if paint is None:
                return
            if want and radius_px > 0:
                paint.setMaskFilter(BlurMaskFilter(radius_px, BlurMaskFilter.Blur.NORMAL))
                view.setLayerType(View.LAYER_TYPE_SOFTWARE, None)
            else:
                paint.setMaskFilter(None)
                view.setLayerType(View.LAYER_TYPE_NONE, None)
            view.setTag(want)
            view.invalidate()
        except Exception:
            pass

    # мгновенный цвет
    def _apply_color_state_instant(self, view: TextView, line_index: int, is_active: bool, is_backing: bool = False) -> None:
        _scale, color, _translation, _alpha = self._line_target_state(is_active, is_backing)
        self._reset_line_color(line_index, view, is_active, is_backing)
        try:
            view.getPaint().setAlpha(255)
        except Exception:
            pass
        try:
            view.setTextColor(color)
        except Exception:
            pass
        self._set_line_blur(view, blurred=not is_active)

    # мгновенное состояние строки
    def _apply_line_state_instant(self, row: FrameLayout, view: TextView, line_index: int, is_active: bool, is_backing: bool = False) -> None:
        self._apply_scale_state_instant(row, is_active, is_backing)
        self._apply_row_alpha_instant(row, is_active, is_backing)
        self._apply_color_state_instant(view, line_index, is_active, is_backing)

    # остановка анимации строки
    def _cancel_line_animator(self, line_index: int, row: FrameLayout, is_active: bool, is_backing: bool = False) -> None:
        prev = self._line_animators.pop(line_index, None)
        if prev is not None:
            try:
                prev.cancel()
            except Exception:
                pass
        try:
            row.animate().cancel()
        except Exception:
            pass
        try:
            view = self.line_views[line_index] if 0 <= line_index < len(self.line_views) else None
        except Exception:
            view = None
        self._reset_line_color(line_index, view, is_active, is_backing)

    # анимированный переход строки
    def _animate_transition(self, old_row, old_view, old_index, new_row, new_view,
                             new_index, force: bool = False, is_backing: bool = False) -> None:
        if not self.running:
            return

        if old_row is not None:
            self._cancel_line_animator(old_index, old_row, is_active=False)
        if new_row is not None:
            self._cancel_line_animator(new_index, new_row, is_active=True, is_backing=is_backing)

        if not force:
            try:
                if _af_line_transition_strategy(self, old_row, old_view, old_index, new_row, new_view, new_index, is_backing):
                    return
            except Exception as e:
                self._dbg("core", "line_transition_strategy failed, "
                                  "falling back to instant snap: " + str(e))

        if old_row is not None and old_view is not None:
            self._apply_line_state_instant(old_row, old_view, old_index, is_active=False)
        if new_row is not None and new_view is not None:
            self._apply_line_state_instant(new_row, new_view, new_index, is_active=True, is_backing=is_backing)

    # сброс цвета строки
    def _reset_line_color(self, line_index: int, view: Optional[TextView], is_active: bool = False, is_backing: bool = False) -> None:
        if view is None:
            return
        try:
            _af_cancel_line_transition(self, line_index, view, is_active, is_backing)
        except Exception as e:
            self._dbg("core", "cancel_line_transition failed: " + str(e))

    # группы объединенных строк
    def _compute_chain_groups(self) -> None:
        times = self.line_times
        n = len(times)
        starts = [0] * n
        tie_earlier = [False] * n
        if n == 0:
            self._chain_group_start = starts
            self._chain_tie_earlier = tie_earlier
            return
        try:
            threshold_sec = self._line_merge_threshold_ms() / 1000.0
        except Exception:
            threshold_sec = DEFAULT_LINE_MERGE_THRESHOLD_MS / 1000.0
        if self.line_source == "AI-Sync":
            threshold_sec = 0.0
        group_start = 0
        for i in range(1, n):
            prev_t = times[i - 1]
            cur_t = times[i]
            if prev_t is None or cur_t is None:
                group_start = i
                starts[i] = group_start
                continue
            gap = float_safe(cur_t) - float_safe(prev_t)
            bk_join = False
            try:
                bk_join = (self.line_source != "AI-Sync" and i < len(self._line_backing_join)
                           and bool(self._line_backing_join[i]))
            except Exception:
                bk_join = False
            if gap < threshold_sec or bk_join:
                starts[i] = group_start
            else:
                group_start = i
                starts[i] = group_start
            if gap <= 0 or bk_join:
                tie_earlier[i - 1] = True
        self._chain_group_start = starts
        self._chain_tie_earlier = tie_earlier

    # отключение строки из цепочки
    def _disconnect_line(self, i: int, row, view, force: bool = False) -> None:
        self._cancel_line_animator(i, row, is_active=False)
        handled = False
        if not force:
            try:
                handled = bool(_af_line_disconnect_strategy(self, row, view, i))
            except Exception as e:
                self._dbg("core", "line_disconnect_strategy failed, "
                                  "falling back to instant snap: " + str(e))
        if not handled:
            self._apply_line_state_instant(row, view, i, is_active=False)

    # проверка отключений цепочки
    def _recheck_chain_disconnects(self, index: int, rows_snap: List[Any], snap: List[Any]) -> None:
        try:
            if index < 0 or index >= len(self._chain_group_start):
                return
            naive_start = self._chain_group_start[index]
            if naive_start >= index:
                return
            effective = set(self._active_chain_indices(index))
            disconnected_any = False
            for i in range(naive_start, index):
                if i in effective or i in self._chain_recheck_done:
                    continue
                self._chain_recheck_done.add(i)
                if not (0 <= i < len(rows_snap) and rows_snap[i] is not None and i < len(snap)):
                    continue
                disconnected_any = True
                self._disconnect_line(i, rows_snap[i], snap[i], force=False)
            if disconnected_any:
                remaining = self._active_chain_indices(index)
                start = remaining[0] if remaining else index
                self._scroll_to_range(start, index, instant=False)
        except Exception as e:
            self._dbg("sync", "_recheck_chain_disconnects crashed: " + str(e))

    # активные строки цепочки
    def _active_chain_indices(self, idx: int) -> List[int]:
        if idx < 0:
            return []
        if idx >= len(self._chain_group_start):
            return [idx]
        start = self._chain_group_start[idx]
        if start < 0 or start > idx:
            start = idx
        chain = list(range(start, idx + 1))
        if len(chain) <= 1:
            return chain
        try:
            threshold_sec = self._line_merge_threshold_ms() / 1000.0
            progress = get_current_progress_sec() + self._sync_offset_sec()
        except Exception:
            return chain
        exempt_from = idx
        j = idx - 1
        while j >= start:
            if j < len(self._chain_tie_earlier) and self._chain_tie_earlier[j]:
                exempt_from = j
                j -= 1
            else:
                break
        result = []
        for i in chain:
            if i >= exempt_from:
                result.append(i)
                continue
            t = self.line_times[i] if i < len(self.line_times) else None
            if t is None:
                result.append(i)
                continue
            try:
                if (progress - float(t)) < threshold_sec:
                    result.append(i)
            except Exception:
                result.append(i)
        return result

    # бэк-вокал ли строка
    def _is_backing_index(self, idx: int) -> bool:
        try:
            if not self._backing_vocal_enabled():
                return False
        except Exception:
            return False
        if idx < 0:
            return False
        try:
            if idx < len(self._line_backing) and self._line_backing[idx]:
                return True
        except Exception:
            pass
        if idx == 0:
            return False
        return (idx - 1) < len(self._chain_tie_earlier) and self._chain_tie_earlier[idx - 1]

    # индекс таймкодов
    def _times_index(self):
        times = self.line_times
        c = self.__dict__.get("_times_idx_cache")
        if c is not None and c[0] is times and c[1] == len(times):
            return c[2], c[3]
        pm: List[float] = []
        lv_list: List[int] = []
        cur_max, lv = float("-inf"), -1
        for i, tv in enumerate(times):
            if tv is not None:
                f = float_safe(tv)
                if f > cur_max:
                    cur_max = f
                lv = i
            pm.append(cur_max)
            lv_list.append(lv)
        self._times_idx_cache = (times, len(times), pm, lv_list)
        return pm, lv_list

    # индексы непустых строк
    def _non_empty_indices(self) -> List[int]:
        lines = self.lines
        c = self.__dict__.get("_non_empty_cache")
        if c is not None and c[0] is lines and c[1] == len(lines):
            return c[2]
        ne = [i for i, l in enumerate(lines) if l.strip()]
        self._non_empty_cache = (lines, len(lines), ne)
        return ne

    # текущая строка по времени
    def _calculate_current_index(self) -> int:
        progress = max(0.0, get_current_progress_sec() + self._sync_offset_sec())
        if self.has_synced and self.line_times:
            pm, lv = self._times_index()
            p = bisect.bisect_right(pm, progress)
            best = lv[p - 1] if p > 0 else -1
            if best >= 0:
                return max(0, min(len(self.line_views) - 1, best))
            return 0
        duration = self.track.duration if self.track.duration > 0 else get_current_duration_sec()
        non_empty = self._non_empty_indices()
        if not non_empty:
            return 0
        if duration <= 0:
            return non_empty[0]
        ratio = max(0.0, min(1.0, progress / duration))
        pos = int(round(ratio * (len(non_empty) - 1)))
        return non_empty[max(0, min(len(non_empty) - 1, pos))]

    # время первой строки
    def _first_line_time(self) -> Optional[float]:
        times = self.line_times or []
        lines = self.lines
        c = self.__dict__.get("_first_time_cache")
        if c is not None and c[0] is times and c[1] == len(times) and c[2] is lines and c[3] == len(lines):
            return c[4]
        result = None
        for i, tv in enumerate(times):
            if tv is None:
                continue
            text = lines[i].strip() if i < len(lines) else ""
            if not text or text == MUSIC_GAP_MARKER:
                continue
            result = float_safe(tv, 0.0)
            break
        self._first_time_cache = (times, len(times), lines, len(lines), result)
        return result

    # служебная ли первая строка
    def _row0_is_marker(self) -> bool:
        try:
            if not self.lines:
                return False
            text = self.lines[0].strip()
            return (not text) or text == MUSIC_GAP_MARKER
        except Exception:
            return False

    # прогресс вступления
    def _intro_progress_and_first(self):
        ft = self._first_line_time()
        if ft is None:
            return None, None
        progress = max(0.0, get_current_progress_sec() + self._sync_offset_sec())
        return progress, float(ft)

    # идет ли вступление
    def _intro_pending(self) -> bool:
        try:
            if not self.has_synced or not self.line_times:
                return False
            progress, ft = self._intro_progress_and_first()
            if ft is None:
                return False
            return ft > INTRO_COUNTDOWN_MIN_SEC and progress < ft
        except Exception:
            return False

    # отступ над первой строкой
    def _update_intro_spacer(self) -> bool:
        sp = self._intro_spacer
        if sp is None or not self.scroll or not self.line_rows:
            return False
        sh = self.scroll.getHeight()
        if sh <= 0:
            return False
        index = 0
        active = self._active_chain_indices(index)
        start = active[0] if active else index
        if start < 0 or start >= len(self.line_rows) or index >= len(self.line_rows):
            return False
        top_row = self.line_rows[start]
        bottom_row = self.line_rows[index]
        if bottom_row is None or top_row is None or bottom_row.getHeight() <= 0:
            return False
        cur_h = int(sp.getHeight())
        top = top_row.getTop() - cur_h
        bottom = bottom_row.getTop() + bottom_row.getHeight() - cur_h
        mid = (top + bottom) / 2.0
        pt = self.scroll.getPaddingTop()
        bias_px = dp(self.context, ACTIVE_LINE_UPWARD_BIAS_DP)
        need = int(sh / 2.0 - bias_px - pt - mid)
        need = max(need, dp(self.context, INTRO_SPACER_MIN_DP))
        lp = sp.getLayoutParams()
        if abs(int(lp.height) - need) <= 1:
            return False
        lp.height = need
        sp.setLayoutParams(lp)
        return True

    # остановка пульса ноты
    def _stop_gap_note_pulse(self) -> None:
        anims = getattr(self, "_gap_note_anims", None) or []
        for a in anims:
            try:
                a.cancel()
            except Exception:
                pass
        self._gap_note_anims = []
        running = getattr(self, "_gap_note_running", None) or {}
        self._gap_note_running = {}
        for pair in list(running.values()):
            for a in pair:
                try:
                    a.cancel()
                except Exception:
                    pass

    # запуск пульса ноты
    def _start_gap_note_pulse(self, views) -> None:
        self._gap_note_anims = []
        self._gap_note_running = {}
        self._gap_note_items = list(views) if views else []
        if not views or not ANIMATOR_AVAILABLE:
            return
        self._sync_gap_note_pulse()

    # центр масштабирования ноты
    def _apply_note_pivot(self, nv) -> None:
        al = self._lyric_align()
        w = float(nv.getWidth())
        nv.setPivotX(0.0 if al == LYRIC_ALIGN_LEFT else (w if al == LYRIC_ALIGN_RIGHT else w / 2.0))
        nv.setPivotY(float(nv.getHeight()) / 2.0)

    # пульс активной ноты
    def _sync_gap_note_pulse(self) -> None:
        try:
            items = getattr(self, "_gap_note_items", None)
            if not items or not ANIMATOR_AVAILABLE:
                return
            running = getattr(self, "_gap_note_running", None)
            if running is None:
                running = {}
                self._gap_note_running = running
            cur = self.current_index
            for idx, nv in items:
                if idx == cur:
                    try:
                        if nv.getParent() is None:
                            continue
                        self._apply_note_pivot(nv)
                        if idx in running:
                            continue
                        ax = ObjectAnimator.ofFloat(nv, "scaleX", 0.97, 1.03)
                        ay = ObjectAnimator.ofFloat(nv, "scaleY", 0.97, 1.03)
                        for a in (ax, ay):
                            a.setDuration(1400)
                            a.setRepeatCount(-1)
                            a.setRepeatMode(ValueAnimator.REVERSE)
                            a.setInterpolator(AccelerateDecelerateInterpolator())
                        ax.start()
                        ay.start()
                        running[idx] = (ax, ay)
                    except Exception as e:
                        self._dbg("note", "gap note pulse failed: " + str(e))
                else:
                    pair = running.pop(idx, None)
                    if pair is not None:
                        for a in pair:
                            try:
                                a.cancel()
                            except Exception:
                                pass
                        try:
                            nv.setScaleX(1.0)
                            nv.setScaleY(1.0)
                        except Exception:
                            pass
        except Exception:
            pass

    # плавная смена прозрачности
    def _fade_view(self, view, target: float, dur_ms: int) -> None:
        store = getattr(self, "_fade_anims", None)
        if store is None:
            store = {}
            self._fade_anims = store
        prev = store.pop(id(view), None)
        if prev is not None:
            try:
                prev.cancel()
            except Exception:
                pass
        try:
            start = float(view.getAlpha())
            if not ANIMATOR_AVAILABLE or dur_ms <= 0 or abs(start - target) < 0.01:
                view.setAlpha(float(target))
                return
            animator = ValueAnimator.ofFloat(start, float(target))
            animator.setDuration(int(dur_ms))
            animator.setInterpolator(AccelerateDecelerateInterpolator())

            class _FadeV(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self_inner, anim):
                    try:
                        view.setAlpha(float(anim.getAnimatedValue()))
                    except Exception:
                        pass

            animator.addUpdateListener(_FadeV())
            animator.start()
            store[id(view)] = animator
        except Exception:
            try:
                view.setAlpha(float(target))
            except Exception:
                pass

    # отсчет 3-2-1 во вступлении
    def _update_intro_countdown(self) -> None:
        tv = self._intro_countdown_view
        if tv is None:
            return
        n = 0
        in_zone = False
        try:
            if self.has_synced and self.line_times:
                progress, ft = self._intro_progress_and_first()
                if ft is not None and ft > INTRO_COUNTDOWN_MIN_SEC:
                    remaining = ft - progress
                    in_zone = remaining <= float(INTRO_COUNTDOWN_FROM)
                    if 0.0 < remaining <= float(INTRO_COUNTDOWN_FROM):
                        n = max(1, min(INTRO_COUNTDOWN_FROM, int(math.ceil(remaining))))
        except Exception:
            n = 0
        note = getattr(self, "_intro_note_view", None)
        if note is not None and in_zone != getattr(self, "_intro_note_hidden", False):
            self._intro_note_hidden = in_zone
            self._fade_view(note, 0.0 if in_zone else 1.0, 160)
        if n == self._intro_countdown_last:
            return
        prev_n = self._intro_countdown_last
        self._intro_countdown_last = n
        try:
            if n <= 0:
                tv.setVisibility(View.INVISIBLE)
                return
            tv.setText(str(n))
            if prev_n <= 0 and note is not None:
                tv.setAlpha(0.0)
                tv.setVisibility(View.VISIBLE)
                self._fade_view(tv, 1.0, 160)
            else:
                tv.setAlpha(1.0)
                tv.setVisibility(View.VISIBLE)
        except Exception:
            pass

    # первый скролл к строке
    def _schedule_initial_scroll(self, generation: Optional[int] = None):
        def worker():
            time.sleep(0.05)
            run_on_ui_thread_safe(lambda g=generation: self._scroll_to_current_after_layout(g, True))
            time.sleep(0.20)
            run_on_ui_thread_safe(lambda g=generation: self._scroll_to_current_after_layout(g, True))

        try:
            threading.Thread(target=worker, name="LyricsInitialScroll", daemon=True).start()
        except Exception:
            pass

    # скролл после раскладки
    def _scroll_to_current_after_layout(self, generation: Optional[int] = None, instant: bool = True):
        if generation is not None and generation != self.load_generation:
            return
        if not self.scroll or not self.line_views:
            return
        try:
            try:
                if self._update_intro_spacer():
                    def _again(g=generation, ins=instant):
                        time.sleep(0.06)
                        run_on_ui_thread_safe(lambda: self._scroll_to_current_after_layout(g, ins))
                    threading.Thread(target=_again, name="LyricsIntroSpacer", daemon=True).start()
                    return
            except Exception as e:
                self._dbg("intro", "spacer update failed: " + str(e))
            index = self._calculate_current_index()
            layout_ready = False
            rows_all = list(self.line_rows)
            n_rows = len(rows_all)
            try:
                align_now = self._lyric_align()
            except Exception:
                align_now = None
            near_lo = max(0, index - 30)
            near_hi = min(n_rows, index + 31)
            for k in range(near_lo, near_hi):
                row = rows_all[k]
                if row is not None:
                    self._apply_scale_pivot(row, align_now)
                    if row.getWidth() > 0:
                        layout_ready = True
            if layout_ready and (near_lo > 0 or near_hi < n_rows):
                _tok = (self.load_generation, id(self.line_rows))
                if self.__dict__.get("_pivot_far_token") != _tok:
                    self._pivot_far_token = _tok
                    far = [k for k in range(n_rows) if k < near_lo or k >= near_hi]
                    far.sort(key=lambda k: abs(k - index))
                    _gen_snapshot = self.load_generation

                    def _far_chunk(start=0, far=far, rows_all=rows_all, g=_gen_snapshot, al=align_now):
                        try:
                            if not self.running or g != self.load_generation:
                                return
                            end = min(len(far), start + 40)
                            for k in far[start:end]:
                                row = rows_all[k]
                                if row is not None:
                                    self._apply_scale_pivot(row, al)
                            if end < len(far):
                                run_on_ui_thread_safe(lambda s=end: _far_chunk(s), 30)
                        except Exception:
                            pass

                    run_on_ui_thread_safe(lambda: _far_chunk(0), 30)
            try:
                self._sync_gap_note_pulse()
            except Exception:
                pass
            active = self._active_chain_indices(index)
            start = active[0] if active else index
            self._scroll_to_range(start, index, instant=instant)
            if layout_ready:
                self._reveal_lines()
        except Exception:
            pass

    # касание во время скролла
    def _on_scroll_touch_activity(self, action=None) -> None:
        try:
            self._auto_scroll_resume_at = time.time() + MANUAL_SCROLL_RESUME_DELAY_SEC
        except Exception:
            pass
        try:
            if getattr(self, "_wave_animator", None) is not None:
                _af_wave_cancel(self, reset=True)
        except Exception:
            pass
        try:
            if action in (MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE):
                self._finger_down = True
                self._return_token = getattr(self, "_return_token", 0) + 1
            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                self._finger_down = False
                self._return_token = getattr(self, "_return_token", 0) + 1
                tok = self._return_token
                t = threading.Timer(
                    MANUAL_SCROLL_RESUME_DELAY_SEC + 0.1,
                    lambda: run_on_ui_thread_safe(lambda: self._return_to_active_line(tok)))
                t.daemon = True
                t.start()
        except Exception as e:
            self._dbg("scroll", "return schedule failed: " + str(e))

    # возврат к активной строке
    def _return_to_active_line(self, token: int) -> None:
        try:
            if token != getattr(self, "_return_token", 0):
                return
            if (not self.running or not self.scroll or getattr(self, "_finger_down", False)
                    or not self.has_synced or not self.line_times):
                return
            if time.time() < self._auto_scroll_resume_at:
                return
            idx = int(self.current_index)
            if idx < 0:
                return
            active = self._active_chain_indices(idx)
            start = active[0] if active else idx
            self.last_scroll_target = -1
            self._scroll_to_range(start, idx, instant=False)
        except Exception as e:
            self._dbg("scroll", "_return_to_active_line crashed: " + str(e))

    # заблокирован ли автоскролл
    def _is_auto_scroll_suppressed(self) -> bool:
        try:
            return time.time() < self._auto_scroll_resume_at
        except Exception:
            return False


    # скролл к диапазону строк
    def _scroll_to_range(self, start_index: int, end_index: int, instant: bool = False) -> None:
        if not self.running or not self.scroll or start_index < 0 or end_index < 0:
            return
        if start_index >= len(self.line_rows) or end_index >= len(self.line_rows):
            return
        if end_index < start_index:
            start_index, end_index = end_index, start_index
        try:
            top_row = self.line_rows[start_index]
            bottom_row = self.line_rows[end_index]
            top = top_row.getTop()
            bottom = bottom_row.getTop() + bottom_row.getHeight()
            sh = self.scroll.getHeight()
            pt = self.scroll.getPaddingTop()
            span = bottom - top
            if sh <= 0 or span <= 0:
                return
            mid = (top + bottom) / 2.0
            bias_px = dp(self.context, ACTIVE_LINE_UPWARD_BIAS_DP)
            target = max(0, int(mid - sh / 2.0 + pt + bias_px))
            index = end_index

            if instant:
                self._cancel_scroll_animation()
                self.last_scroll_target = target
                self._scroll_target_index = index
                self.scroll.scrollTo(0, target)
                return

            if target == self.last_scroll_target:
                return
            self.last_scroll_target = target
            self._scroll_target_index = index

            try:
                if _af_scroll_strategy(self, target):
                    return
            except Exception as e:
                self._dbg("scroll", "scroll_strategy failed, "
                                     "falling back to instant: " + str(e))

            self._cancel_scroll_animation()
            self.scroll.scrollTo(0, target)
        except Exception as e:
            self._dbg("scroll", "_scroll_to_range crashed: " + str(e))

    # остановка скролла
    def _cancel_scroll_animation(self) -> None:
        try:
            _af_wave_cancel(self, reset=True)
        except Exception:
            pass
        try:
            if self.scroll_animator is not None:
                self.scroll_animator.cancel()
                self.scroll_animator = None
        except Exception:
            pass

    # целая настройка
    def _setting_int(self, key, default, mn, mx):
        return setting_int(self.plugin, key, default, mn, mx)

    # прозрачность неактивных строк
    def _inactive_alpha(self):
        return self._setting_int("inactive_alpha", DEFAULT_INACTIVE_ALPHA, 70, 230)

    # цвет неактивных строк
    def _inactive_text_color(self):
        return argb_gray(self._inactive_alpha(), 255)

    # приглушенный цвет текста
    def _muted_text_color(self):
        return argb_gray(self._inactive_alpha(), 185)

    # размер текста строки
    def _line_text_size(self):
        return self._setting_int("line_text_size", DEFAULT_LINE_TEXT_SIZE, 18, 42)

    # размер активной строки
    def _active_line_text_size(self):
        return self._setting_int("active_line_text_size", DEFAULT_ACTIVE_LINE_TEXT_SIZE, 20, 50)

    # размер текста без синхронизации
    def _unsynced_text_size(self):
        return self._setting_int("unsynced_text_size", DEFAULT_UNSYNCED_TEXT_SIZE, 18, 50)

    # масштаб неактивных строк
    def _inactive_scale_ratio(self):
        active = float(self._active_line_text_size())
        inactive = float(self._line_text_size())
        if active <= 0:
            return 1.0
        return max(0.3, min(1.0, inactive / active))

    # сдвиг синхронизации
    def _sync_offset_sec(self):
        return setting_float(self.plugin, "sync_offset_sec", DEFAULT_SYNC_OFFSET_SEC, -5.0, 5.0)

    # порог объединения строк
    def _line_merge_threshold_ms(self):
        return self._setting_int("line_merge_threshold_ms", DEFAULT_LINE_MERGE_THRESHOLD_MS, 0, 2000)

    # включен ли бэк-вокал
    def _backing_vocal_enabled(self):
        return setting_bool(self.plugin, "backing_vocal_enabled", DEFAULT_BACKING_VOCAL_ENABLED)

    # прозрачность бэк-вокала
    def _backing_vocal_alpha(self) -> float:
        pct = self._setting_int("backing_vocal_alpha_pct", DEFAULT_BACKING_VOCAL_ALPHA_PCT, 0, 100)
        return pct / 100.0

    # боковые отступы
    def _side_padding_dp(self) -> int:
        return self._setting_int("side_padding_dp", DEFAULT_SIDE_PADDING_DP, 0, 80)

    # перемотка по двойному тапу
    def _seek_requires_double_tap(self) -> bool:
        return setting_bool(self.plugin, "seek_requires_double_tap", DEFAULT_SEEK_REQUIRES_DOUBLE_TAP)

    # пауза по тапу на активную строку
    def _pause_on_active_line_tap(self) -> bool:
        return setting_bool(self.plugin, "pause_on_active_line_tap", DEFAULT_PAUSE_ON_ACTIVE_LINE_TAP)

    # выравнивание текста
    def _lyric_align(self):
        return self._setting_int("lyric_align", DEFAULT_LYRIC_ALIGN, 0, len(LYRIC_ALIGN_LABELS) - 1)

    # gravity строки
    def _lyric_line_gravity(self):
        a = self._lyric_align()
        if a == LYRIC_ALIGN_LEFT:
            return Gravity.LEFT | Gravity.CENTER_VERTICAL
        if a == LYRIC_ALIGN_RIGHT:
            return Gravity.RIGHT | Gravity.CENTER_VERTICAL
        return Gravity.CENTER

    # включена ли отладка
    def _debug_enabled(self):
        return setting_bool(self.plugin, "debug_enabled", DEFAULT_DEBUG_ENABLED)

    # отладочный лог
    def _dbg(self, tag: str, message: str, source: Optional[str] = None) -> None:
        src = source or "LyricsPlus"
        full = "[LyricsPlus:{}] [{}] {}".format(tag, src, message)
        stamped = time.strftime("%H:%M:%S") + " " + full
        try:
            _dbg_enqueue((0, self.plugin.log, full, None))
        except Exception:
            pass
        try:
            _dbg_enqueue((1, "Viewer/" + tag, message[:400], "W"))
        except Exception:
            pass
        try:
            _debug_log_append(stamped)
        except Exception:
            pass
        if self._debug_enabled():
            try:
                now = time.time()
                last = self._dbg_last_bulletin_at.get(tag, 0.0)
                if now - last >= DEBUG_BULLETIN_COOLDOWN_SEC:
                    self._dbg_last_bulletin_at[tag] = now
                    BulletinHelper.show_error(full[:180])
            except Exception:
                pass

    # закрытие окна
    def close(self):
        self.running = False
        try:
            self._stop_gap_note_pulse()
        except Exception:
            pass
        _gil_boost_off(self)
        try:
            _af_wave_cancel(self, reset=False)
        except Exception:
            pass
        try:
            if self.scroll_animator is not None:
                self.scroll_animator.cancel()
                self.scroll_animator = None
        except Exception:
            pass
        try:
            with self._ui_lock:
                views = list(self.line_views)
                rows = list(self.line_rows)
            for v in views:
                try:
                    v.animate().cancel()
                except Exception:
                    pass
            for r in rows:
                try:
                    r.animate().cancel()
                except Exception:
                    pass
            for anim in list(self._line_animators.values()):
                try:
                    anim.cancel()
                except Exception:
                    pass
            self._line_animators = {}
        except Exception:
            pass
        try:
            if self.dialog and self.dialog.isShowing():
                self.dialog.dismiss()
        except Exception:
            pass
        try:
            if getattr(self.plugin, '_active_viewer', None) is self:
                self.plugin._active_viewer = None
        except Exception:
            pass


    # путь к обложке трека
    def _extract_album_art_path(self) -> Optional[str]:
        try:
            mc = get_media_controller().getInstance()

            try:
                ai = mc.getAudioInfo()
                if ai is not None:
                    cf = ai.getCoverFile()
                    if cf is not None and cf.exists():
                        return cf.getAbsolutePath()
            except Exception:
                pass

            mo = mc.getPlayingMessageObject()
            if mo is None:
                return None
            try:
                doc = mo.getDocument()
            except Exception:
                doc = None
            if doc is None:
                return None

            best_thumb = None
            max_area = -1
            thumbs = getattr(doc, "thumbs", None)
            if thumbs:
                iterator = None
                try:
                    iterator = thumbs.iterator()
                except Exception:
                    iterator = None

                if iterator is not None:
                    while iterator.hasNext():
                        t = iterator.next()
                        area = self._thumb_area(t)
                        if area > max_area:
                            max_area = area
                            best_thumb = t
                else:
                    try:
                        for t in thumbs:
                            area = self._thumb_area(t)
                            if area > max_area:
                                max_area = area
                                best_thumb = t
                    except Exception:
                        pass

            if best_thumb is None:
                return None

            FileLoader = jclass("org.telegram.messenger.FileLoader")
            UserConfig = jclass("org.telegram.messenger.UserConfig")
            fl = FileLoader.getInstance(UserConfig.selectedAccount)
            pf = fl.getPathToAttach(best_thumb, True)
            if pf is not None and pf.exists():
                return pf.getAbsolutePath()

            try:
                fl.loadFile(best_thumb, True, False)
            except Exception:
                pass
            for _ in range(8):
                try:
                    time.sleep(0.15)
                    pf = fl.getPathToAttach(best_thumb, True)
                    if pf is not None and pf.exists():
                        return pf.getAbsolutePath()
                except Exception:
                    break
        except Exception as e:
            self.plugin.log("extract album art failed: " + str(e))
        return None

    # размер области обложки
    def _thumb_area(self, thumb: Any) -> int:
        try:
            return int(getattr(thumb, "w", 0)) * int(getattr(thumb, "h", 0))
        except Exception:
            return 0

    # обложка из сети
    def _fetch_cover_online(self, title: str, artist: str) -> Optional[str]:
        try:
            return _fetch_cover_online_path(title, artist)
        except Exception as e:
            self.plugin.log("fetch online cover failed: " + str(e))
            return None


# главный класс плагина
class Plugin(BasePlugin):
    instance = None

    # запуск плагина
    def on_plugin_load(self) -> None:
        Plugin.instance = self
        self._cache_lock = threading.RLock()
        self._cache_write_lock = threading.Lock()
        self._cache_mem = None
        self._ensure_dir()
        threading.Thread(target=self._cache_ensure_loaded, name="LyricsCacheWarm", daemon=True).start()
        plog("Plugin", "=== Lyrics+ v{} загружен (сессия {}) ===".format(__version__, _plog_session_id))
        self._in_player_menu = False
        new_menu_hooked = False
        try:
            if ItemOptions is not None:
                show_menu_method = None
                for m in AudioPlayerAlert.getClass().getDeclaredMethods():
                    if m.getName() == "showMenuOptions":
                        show_menu_method = m
                        break
                show_method = None
                for m in ItemOptions.getClass().getDeclaredMethods():
                    if m.getName() == "show" and len(m.getParameterTypes()) == 0:
                        show_method = m
                        break
                if show_menu_method is not None and show_method is not None:
                    self.hook_method(show_menu_method, ShowMenuOptionsHook(self))
                    self.hook_method(show_method, ItemOptionsShowHook(self))
                    new_menu_hooked = True
                    plog("Plugin", "hook showMenuOptions + ItemOptions.show OK")
        except Exception as e:
            plog_exc("Plugin", "hook new player menu FAILED", e)

        if not new_menu_hooked:
            try:
                self.hook_method(AudioPlayerAlert.getClass().getDeclaredConstructors()[0], AudioPlayerAlertHook())
                plog("Plugin", "hook AudioPlayerAlert constructor OK")
            except Exception as e:
                plog_exc("Plugin", "hook AudioPlayerAlert constructor FAILED", e)
            try:
                self.hook_method(AudioPlayerAlert.getClass().getDeclaredMethod("updateTitle", Boolean.TYPE), UpdateHook())
                plog("Plugin", "hook updateTitle OK")
            except Exception as e:
                plog_exc("Plugin", "hook updateTitle FAILED", e)
            try:
                self.hook_method(AudioPlayerAlert.getClass().getDeclaredMethod("onSubItemClick", Integer.TYPE), SubItemClickHook(self))
                plog("Plugin", "hook onSubItemClick OK")
            except Exception as e:
                plog_exc("Plugin", "hook onSubItemClick FAILED", e)
        self.log("LRCLIB Lyrics Editable loaded")
        self._update_checking = False
        self._start_auto_update_check()

    # экземпляр плагина
    @staticmethod
    def get_instance() -> "Plugin":
        return Plugin.instance

    # папка плагина
    @staticmethod
    def dir_path() -> str:
        directory = File(ApplicationLoader.applicationContext.getExternalCacheDir(), __id__)
        if not directory.exists():
            directory.mkdirs()
        return directory.getAbsolutePath()

    # создание папки
    def _ensure_dir(self):
        try:
            os.makedirs(self.dir_path(), exist_ok=True)
        except Exception:
            pass

    # настройки плагина
    def create_settings(self) -> List[Any]:
        if not SETTINGS_UI_AVAILABLE:
            return []
        items: List[Any] = []

        items += [
            Header(text="Обновления · v{}".format(__version__)),
            Text(text="Проверить обновления", icon="msg_download", accent=True,
                 on_click=self._on_check_updates_click),
            Switch(key="auto_update_check", text="Авто-проверка", default=True, icon="msg_timer",
                   subtext="Раз в сутки при запуске Telegram. Личные данные не отправляются."),
            Divider(),
        ]

        items.append(Header(text="Текст"))
        if SELECTOR_AVAILABLE:
            items.append(Selector(key="lyric_align", text="Выравнивание", default=DEFAULT_LYRIC_ALIGN,
                                  items=LYRIC_ALIGN_LABELS, icon="msg_customize"))
        else:
            items.append(Input(key="lyric_align", text="Выравнивание", default=str(DEFAULT_LYRIC_ALIGN),
                               icon="msg_customize", subtext="0 — слева, 1 — по центру, 2 — справа."))
        items += [
            Input(key="line_text_size", text="Размер обычной строки", default=str(DEFAULT_LINE_TEXT_SIZE),
                  subtext="От 18 до 42. По умолчанию {}.".format(DEFAULT_LINE_TEXT_SIZE)),
            Input(key="active_line_text_size", text="Размер активной строки",
                  default=str(DEFAULT_ACTIVE_LINE_TEXT_SIZE),
                  subtext="От 20 до 50. По умолчанию {}.".format(DEFAULT_ACTIVE_LINE_TEXT_SIZE)),
            Input(key="unsynced_text_size", text="Размер без синхронизации", default=str(DEFAULT_UNSYNCED_TEXT_SIZE),
                  subtext="От 18 до 50. Для песен, где текст не синхронизирован со звуком. "
                          "По умолчанию {}.".format(DEFAULT_UNSYNCED_TEXT_SIZE)),
            Input(key="inactive_alpha", text="Яркость строки", default=str(DEFAULT_INACTIVE_ALPHA),
                  subtext="От 70 до 230. Больше — ярче, меньше — бледнее. "
                          "По умолчанию {}.".format(DEFAULT_INACTIVE_ALPHA)),
            Input(key="side_padding_dp", text="Отступы по бокам", default=str(DEFAULT_SIDE_PADDING_DP),
                  subtext="От 0 до 80. По умолчанию {}.".format(DEFAULT_SIDE_PADDING_DP)),
            Divider(),
        ]

        items += [
            Header(text="Бэк-вокал"),
            Switch(key="backing_vocal_enabled", text="Приглушать бэк-вокал",
                   default=DEFAULT_BACKING_VOCAL_ENABLED, icon="msg_mute",
                   subtext="Бэк-вокал (строки в скобках, помеченные источником или звучащие поверх "
                           "основной строки) показывается бледнее и мельче; основная строка остается яркой."),
            Input(key="backing_vocal_alpha_pct", text="Яркость бэк-вокала", default=str(DEFAULT_BACKING_VOCAL_ALPHA_PCT),
                  subtext="От 0 до 100 (%). По умолчанию {}.".format(DEFAULT_BACKING_VOCAL_ALPHA_PCT), icon="msg_customize"),
            Divider(),
        ]

        items += [
            Header(text="Синхронизация"),
            Input(key="sync_offset_sec", text="Сдвиг текста (сек)", default=str(DEFAULT_SYNC_OFFSET_SEC),
                  subtext="От -5 до 5. Текст опаздывает — увеличьте число, спешит — уменьшите. "
                          "По умолчанию {}.".format(DEFAULT_SYNC_OFFSET_SEC), icon="msg_timer"),
            Divider(),
        ]

        items += [
            Header(text="Касания"),
            Switch(key="seek_requires_double_tap", text="Перемотка двойным тапом",
                   default=DEFAULT_SEEK_REQUIRES_DOUBLE_TAP, icon="msg_text",
                   subtext="Выключено — перемотка к строке одним тапом. Включено — двойным "
                           "(защита от случайных нажатий)."),
            Switch(key="pause_on_active_line_tap", text="Пауза по тапу на строку",
                   default=DEFAULT_PAUSE_ON_ACTIVE_LINE_TAP, icon="msg_pause",
                   subtext="Тап по текущей строке ставит песню на паузу, повторный — продолжает."),
            Divider(),
        ]

        items += [
            Header(text="Анимации"),
            Switch(key="scale_animation_enabled", text="Увеличение строки",
                   default=DEFAULT_SCALE_ANIMATION_ENABLED, icon="msg_zoomin",
                   subtext="Текущая строка плавно становится крупнее."),
            Switch(key="blur_enabled", text="Размытие строк",
                   default=DEFAULT_BLUR_ENABLED, icon="msg_photo_settings",
                   subtext="Другие строки слегка размыты. Выключите, если анимация идет рывками: "
                           "размытие сильнее всего нагружает видеочип."),
            Switch(key="wave_enabled", text="Пружинная прокрутка",
                   default=DEFAULT_WAVE_ENABLED, icon="msg_replace",
                   subtext="Строки двигаются волной с легкой пружиной. Выключите для обычной "
                           "плавной прокрутки."),
            Input(key="animation_ms", text="Скорость анимации (мс)", default=str(DEFAULT_ANIMATION_MS),
                  subtext="От 60 до 900. Больше — медленнее и плавнее. По умолчанию {}.".format(DEFAULT_ANIMATION_MS),
                  icon="msg_speed"),
            Divider(),
        ]

        items += [
            Header(text="Диагностика"),
            Switch(key="search_log_enabled", text="Лог поиска текста", default=DEFAULT_SEARCH_LOG_ENABLED,
                   icon="msg_log",
                   subtext="Включите, если находится не тот текст, и отправьте лог разработчику."),
            Text(text="Сохранить лог в «Загрузки»", icon="msg_download", accent=True,
                 on_click=self._on_export_search_log_click),
            Text(text="Очистить лог", icon="msg_delete", on_click=self._on_clear_search_log_click),
            Text(text="Очистить кэш текстов", icon="msg_delete", on_click=self._on_clear_lyrics_cache_click),
            Divider(),
            Text(text="Канал автора", on_click=self._on_channel_click),
        ]
        return items


    # клик проверки обновлений
    def _on_check_updates_click(self, view) -> None:
        self._check_for_updates(manual=True)

    # автопроверка обновлений
    def _start_auto_update_check(self) -> None:
        def _run():
            try:
                time.sleep(UPDATE_AUTO_DELAY_SEC)
                if not setting_bool(self, "auto_update_check", True):
                    return
                try:
                    last = float(str(self.get_setting("update_last_check", "0") or "0"))
                except Exception:
                    last = 0.0
                if time.time() - last < UPDATE_CHECK_INTERVAL_SEC:
                    return
                self._check_for_updates(manual=False)
            except Exception as e:
                plog_exc("Update", "auto check failed", e)
        threading.Thread(target=_run, name="LyricsUpdateAuto", daemon=True).start()

    # уведомление об обновлении
    def _update_toast(self, kind: str, text: str) -> None:
        def _show():
            try:
                fn = getattr(BulletinHelper, "show_" + kind, None) or BulletinHelper.show_success
                fn(text)
            except Exception as e:
                self.log("bulletin failed: " + str(e))
        run_on_ui_thread_safe(_show)

    # проверка обновлений
    def _check_for_updates(self, manual: bool) -> None:
        if getattr(self, "_update_checking", False):
            if manual:
                self._update_toast("info", "Проверка уже идет…")
            return
        self._update_checking = True
        if manual:
            self._update_toast("info", "Проверяю обновления…")

        def _worker():
            try:
                info = fetch_update_info()
                try:
                    self.set_setting("update_last_check", str(int(time.time())))
                except Exception:
                    pass
                remote = (info.get("version") or "").strip()
                if not remote:
                    if manual:
                        self._update_toast("error", "В файле обновлений не найдена версия")
                    return
                if not is_newer_version(remote, __version__):
                    if manual:
                        self._update_toast("success", "У вас последняя версия (v{})".format(__version__))
                    return
                if not manual:
                    try:
                        if str(self.get_setting("update_notified_version", "")) == remote:
                            return
                    except Exception:
                        pass
                run_on_ui_thread_safe(lambda: self._show_update_dialog(info, manual))
            except Exception as e:
                plog_exc("Update", "check failed", e)
                if manual:
                    self._update_toast("error", "Не удалось проверить обновления. Проверьте интернет.")
            finally:
                self._update_checking = False

        threading.Thread(target=_worker, name="LyricsUpdateCheck", daemon=True).start()

    # диалог обновления
    def _show_update_dialog(self, info: Dict[str, str], manual: bool) -> None:
        remote = (info.get("version") or "").strip()
        url = (info.get("download") or "").strip()
        changelog = (info.get("changelog") or "").strip()
        message = "Доступна версия v{} (у вас v{}).".format(remote, __version__)
        if changelog:
            message += "\n\nЧто нового:\n" + changelog
        activity = None
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
        except Exception:
            activity = None
        if activity is None or not url:
            if manual or not url:
                self._update_toast("info", message if url else "Вышла версия v{}, но ссылка на скачивание не указана".format(remote))
            return
        try:
            from android.app import AlertDialog as _AlertDialog
            from android.content import DialogInterface

            class _DownloadListener(dynamic_proxy(DialogInterface.OnClickListener)):
                def onClick(self, dialog, which):
                    try:
                        open_external_url(url)
                    except Exception as e:
                        plog_exc("Update", "open url failed", e)

            class _CloseListener(dynamic_proxy(DialogInterface.OnClickListener)):
                def onClick(self, dialog, which):
                    pass

            builder = _AlertDialog.Builder(activity)
            builder.setTitle("Обновление LyricsPlus")
            builder.setMessage(message)
            builder.setPositiveButton("Обновить", _DownloadListener())
            builder.setNegativeButton("Позже", _CloseListener())
            builder.show()
            try:
                self.set_setting("update_notified_version", remote)
            except Exception:
                pass
        except Exception as e:
            plog_exc("Update", "dialog failed", e)
            self._update_toast("info", message)

    # клик экспорта лога поиска
    def _on_export_search_log_click(self, view) -> None:
        try:
            file_name = export_search_log_to_downloads()
            BulletinHelper.show_success("Сохранено в Downloads: " + file_name)
        except Exception as e:
            self.log("export search log failed: " + str(e))
            BulletinHelper.show_error("Не удалось сохранить лог: " + str(e))

    # клик очистки лога поиска
    def _on_clear_search_log_click(self, view) -> None:
        try:
            clear_search_log()
            BulletinHelper.show_success("Лог поиска очищен")
        except Exception as e:
            self.log("clear search log failed: " + str(e))
            BulletinHelper.show_error("Не удалось очистить лог: " + str(e))

    # клик очистки кэша текстов
    def _on_clear_lyrics_cache_click(self, view) -> None:
        try:
            path = self.cache_path()
            with self._cache_lock:
                self._cache_mem = {}
            if os.path.exists(path):
                os.remove(path)
            BulletinHelper.show_success("Кэш текстов очищен")
        except Exception as e:
            self.log("clear lyrics cache failed: " + str(e))
            BulletinHelper.show_error("Не удалось очистить кэш: " + str(e))

    # клик канала автора
    def _on_channel_click(self, view) -> None:
        try:
            open_external_url(AUTHOR_CHANNEL_URL)
        except Exception as e:
            self.log("channel link failed: " + str(e))

    # путь к кэшу
    def cache_path(self) -> str:
        return os.path.join(self.dir_path(), "lrclib_lyrics_cache.json")


    # загрузка кэша с диска
    def _cache_ensure_loaded(self) -> Dict[str, Any]:
        mem = getattr(self, "_cache_mem", None)
        if mem is not None:
            return mem
        lock = getattr(self, "_cache_lock", None)
        if lock is None:
            lock = threading.RLock()
            self._cache_lock = lock
        with lock:
            mem = getattr(self, "_cache_mem", None)
            if mem is not None:
                return mem
            data: Dict[str, Any] = {}
            try:
                path = self.cache_path()
                if os.path.exists(path):
                    with open(path, "r", encoding="utf-8") as f:
                        loaded = json.load(f)
                    if isinstance(loaded, dict):
                        data = loaded
            except Exception as e:
                self.log("cache load failed: " + str(e))
                data = {}
            now = time.time()
            def _legacy_key(k: str) -> bool:
                return ("gapnotes_v1" in k) or k.startswith(("final_v3_parallel|", "fp_v3_parallel|", "neg_v3_parallel|", "final_v4|", "fp_v4|", "neg_v4|", "final_v5|", "fp_v5|", "neg_v5|"))
            data = {k: v for k, v in data.items()
                    if isinstance(v, dict) and not self._cache_expired(v, now) and not _legacy_key(str(k))}
            self._cache_mem = data
            return data

    # просрочена ли запись
    @staticmethod
    def _cache_expired(item: Dict[str, Any], now: float) -> bool:
        try:
            ttl = float(item.get("ttl") or (CACHE_TTL_DAYS * 24 * 60 * 60))
            return now - float(item.get("saved_at", 0)) > ttl
        except Exception:
            return True

    # отложенная запись кэша
    def _cache_flush(self) -> None:
        flock = getattr(self, "_cache_flush_lock", None)
        if flock is None:
            flock = threading.Lock()
            self._cache_flush_lock = flock
        with flock:
            self._cache_dirty = True
            if getattr(self, "_cache_flush_pending", False):
                return
            self._cache_flush_pending = True

        def _runner():
            try:
                time.sleep(0.8)
                while True:
                    with flock:
                        self._cache_dirty = False
                    self._cache_flush_now()
                    with flock:
                        if not self._cache_dirty:
                            self._cache_flush_pending = False
                            return
                    time.sleep(0.4)
            except Exception as e:
                self.log("cache flush runner failed: " + str(e))
                with flock:
                    self._cache_flush_pending = False

        threading.Thread(target=_runner, name="LyricsCacheFlush", daemon=True).start()

    # немедленная запись кэша
    def _cache_flush_now(self) -> None:
        lock = getattr(self, "_cache_lock", None)
        wlock = getattr(self, "_cache_write_lock", None)
        if wlock is None:
            wlock = threading.Lock()
            self._cache_write_lock = wlock
        try:
            with lock:
                snapshot = dict(self._cache_mem or {})
            with wlock:
                path = self.cache_path()
                tmp_path = path + ".tmp"
                parts = []
                for n, (k, v) in enumerate(snapshot.items()):
                    parts.append(json.dumps(k, ensure_ascii=False) + ":" +
                                 json.dumps(v, ensure_ascii=False, separators=(",", ":")))
                    if n % 25 == 24:
                        time.sleep(0.001)
                data = "{" + ",".join(parts) + "}"
                with open(tmp_path, "w", encoding="utf-8") as f:
                    f.write(data)
                os.replace(tmp_path, path)
        except Exception as e:
            self.log("cache flush failed: " + str(e))

    # разрешение алиасов кэша
    def _cache_resolve(self, mem: Dict[str, Any], key: str, now: float):
        for _ in range(3):
            item = mem.get(key)
            if not item or self._cache_expired(item, now):
                return None, None
            target = item.get("alias")
            if not target:
                return key, item
            key = target
        return None, None

    # чтение из кэша
    def cache_get(self, key: str) -> Optional[Dict[str, Any]]:
        if not key:
            return None
        try:
            mem = self._cache_ensure_loaded()
            now = time.time()
            with self._cache_lock:
                real_key, item = self._cache_resolve(mem, key, now)
                if not item or not item.get("lines"):
                    return None
                age = now - float(item.get("saved_at", 0))
                touched = age > CACHE_TOUCH_AFTER_DAYS * 24 * 60 * 60
                if touched:
                    item["saved_at"] = int(now)
            if touched:
                self._cache_flush()
            return item
        except Exception as e:
            self.log("cache_get failed: " + str(e))
            return None

    # нечеткий поиск в кэше
    def cache_find_similar(self, track: "TrackInfo"):
        mem = self._cache_ensure_loaded()
        norm = getattr(self, "_cache_norm", None)
        if norm is None:
            norm = {}
            self._cache_norm = norm
        tt = normalize_key(track.title or track.query_fallback)
        ta = _split_artists(track.artist)
        if not tt:
            return None
        now = time.time()
        with self._cache_lock:
            entries = [(k, v) for k, v in mem.items()
                       if not v.get("alias") and not v.get("negative") and v.get("lines") and v.get("matched_title")]
        best_key, best_item, best_score = None, None, 0.0
        for _n, (k, v) in enumerate(entries):
            if _n % 64 == 63:
                time.sleep(0)
            if self._cache_expired(v, now):
                continue
            cached = norm.get(k)
            if cached is None:
                cached = (normalize_key(v.get("matched_title")), _split_artists(safe_str(v.get("matched_artist"))))
                norm[k] = cached
            ct, ca = cached
            if not ct or abs(len(ct) - len(tt)) > max(6, len(tt) // 2):
                continue
            t = string_sim(tt, ct)
            if t < 0.90:
                continue
            if set(v.get("versions") or []) != set(track.versions):
                continue
            vd = float_safe(v.get("matched_duration"), 0.0)
            if track.duration > 0 and vd > 0 and abs(track.duration - vd) > 8.0:
                continue
            a = _artist_list_similarity(ta, ca) if (ta and ca) else 0.5
            if ta and ca and a < 0.85:
                continue
            score = t * 0.7 + a * 0.3
            if score > best_score:
                best_key, best_item, best_score = k, v, score
        if best_item is not None and best_score >= 0.92:
            return best_key, best_item
        return None

    # чтение кэша неудач
    def cache_get_negative(self, key: str) -> str:
        try:
            mem = self._cache_ensure_loaded()
            with self._cache_lock:
                item = mem.get(key)
                if item and item.get("negative") and not self._cache_expired(item, time.time()):
                    return safe_str(item.get("message"), "Текст не найден")
        except Exception:
            pass
        return ""

    # обрезка кэша
    def _cache_trim_locked(self, mem: Dict[str, Any]) -> None:
        now = time.time()
        for k in [k for k, v in mem.items() if self._cache_expired(v, now)]:
            mem.pop(k, None)
        if len(mem) > CACHE_MAX_ENTRIES:
            real = sorted((k for k, v in mem.items() if not v.get("alias")),
                          key=lambda k: float(mem[k].get("saved_at", 0)))
            for k in real[:len(mem) - CACHE_MAX_ENTRIES]:
                mem.pop(k, None)
        for k in [k for k, v in mem.items() if v.get("alias") and v.get("alias") not in mem]:
            mem.pop(k, None)

    # запись в кэш
    def cache_put(self, key: str, item: Dict[str, Any]) -> None:
        if not key:
            return
        try:
            mem = self._cache_ensure_loaded()
            with self._cache_lock:
                mem[key] = item
                self._cache_trim_locked(mem)
            self._cache_flush()
        except Exception as e:
            self.log("cache_put failed: " + str(e))

    # запись алиаса
    def cache_put_alias(self, alias_key: str, target_key: str) -> None:
        if not alias_key or not target_key or alias_key == target_key:
            return
        try:
            mem = self._cache_ensure_loaded()
            with self._cache_lock:
                real_key, item = self._cache_resolve(mem, target_key, time.time())
                if not item or not item.get("lines") or real_key == alias_key:
                    return
                cur = mem.get(alias_key)
                if cur and not self._cache_expired(cur, time.time()):
                    if cur.get("lines") or cur.get("alias") == real_key:
                        return
                mem[alias_key] = {"alias": real_key, "saved_at": int(time.time()),
                                  "ttl": int(item.get("ttl") or (CACHE_TTL_DAYS * 24 * 60 * 60))}
            self._cache_flush()
        except Exception as e:
            self.log("cache_put_alias failed: " + str(e))

    # запись неудачи
    def cache_put_negative(self, key: str, message: str, ttl_sec: int) -> None:
        try:
            mem = self._cache_ensure_loaded()
            with self._cache_lock:
                mem[key] = {"negative": True, "message": message,
                            "saved_at": int(time.time()), "ttl": int(ttl_sec)}
            self._cache_flush()
        except Exception as e:
            self.log("cache_put_negative failed: " + str(e))

    # удаление из кэша
    def cache_delete(self, key: str) -> None:
        if not key:
            return
        try:
            mem = self._cache_ensure_loaded()
            with self._cache_lock:
                if key not in mem:
                    return
                mem.pop(key, None)
                self._cache_trim_locked(mem)
            self._cache_flush()
        except Exception as e:
            self.log("cache_delete failed: " + str(e))

    # сброс кэша трека
    def cache_forget_track(self, track: "TrackInfo") -> None:
        try:
            mem = self._cache_ensure_loaded()
            try:
                http_cache_clear()
            except Exception:
                pass
            keys = [track.cache_key, track.final_key, track.negative_key]
            keys += ["fp_v6|" + fp for fp in track.fingerprints]
            with self._cache_lock:
                for k in keys:
                    mem.pop(k, None)
                self._cache_trim_locked(mem)
            self._cache_flush()
        except Exception as e:
            self.log("cache_forget_track failed: " + str(e))

    # показ окна с текстом
    def present_viewer(self):
        prev = getattr(self, '_active_viewer', None)
        if prev is not None:
            try:
                prev.close()
            except Exception:
                pass
            self._active_viewer = None

        track = get_current_track_info()
        plog("Viewer", "Открытие текста: '{}' - '{}' длительность={:.0f}с".format(
            safe_str(track.title), safe_str(track.artist), track.duration))
        try:
            viewer = LyricsViewer(self, track)
            self._active_viewer = viewer
            viewer.show()
            plog("Viewer", "LyricsViewer.show() вызван успешно")
        except Exception as e:
            self._active_viewer = None
            plog_crash("Viewer", "present_viewer упал", e)
            raise


_RUN_UI_FN = [None]


# запуск в UI-потоке
def run_on_ui_thread_safe(callback, delay_ms: int = 0):
    def _guarded():
        try:
            callback()
        except BaseException as e:
            try:
                plog_exc("UI", "callback упал в UI-потоке", e)
            except Exception:
                pass
    try:
        fn = _RUN_UI_FN[0]
        if fn is None:
            from android_utils import run_on_ui_thread as _rut
            fn = _rut
            _RUN_UI_FN[0] = fn
        if delay_ms and delay_ms > 0:
            fn(_guarded, int(delay_ms))
        else:
            fn(_guarded)
        return
    except Exception:
        pass
    try:
        from org.telegram.messenger import AndroidUtilities
        if delay_ms and delay_ms > 0:
            AndroidUtilities.runOnUIThread(_RunnableProxy(_guarded), int(delay_ms))
        else:
            AndroidUtilities.runOnUIThread(_RunnableProxy(_guarded))
    except Exception as e:
        plog_exc("UI", "не удалось выполнить в UI-потоке", e)


# сообщение играющего трека
def get_playing_message_object() -> Optional[MessageObject]:
    try:
        return get_media_controller().getInstance().getPlayingMessageObject()
    except Exception:
        return None


# музыка ли сообщение
def is_music() -> bool:
    msg = get_playing_message_object()
    if not msg:
        return False
    try:
        return bool(msg.isMusic())
    except Exception:
        return False


# поле java-объекта
def java_field(obj: Any, name: str, default: Any = None) -> Any:
    if obj is None:
        return default
    try:
        return getattr(obj, name)
    except Exception:
        pass
    try:
        return get_private_field(obj, name)
    except Exception:
        return default


# вызов метода по списку имен
def call_any(obj: Any, names: List[str], default: Any = None, args_variants: Optional[List[Tuple[Any, ...]]] = None) -> Any:
    if obj is None:
        return default
    if args_variants is None:
        args_variants = [tuple(), (False,), (True,)]
    for name in names:
        try:
            method = getattr(obj, name)
        except Exception:
            continue
        for args in args_variants:
            try:
                value = method(*args)
                if value is not None:
                    return value
            except Exception:
                continue
    return default


# то же без исключений
def try_call_any(obj: Any, names: List[str], args_variants: List[Tuple[Any, ...]]) -> bool:
    if obj is None:
        return False
    for name in names:
        try:
            method = getattr(obj, name)
        except Exception:
            continue
        for args in args_variants:
            try:
                method(*args)
                return True
            except Exception:
                continue
    return False


# перемотка трека
def seek_current_track_to_sec(seconds: float, duration_hint: float = 0.0) -> bool:
    try:
        msg = get_playing_message_object()
        if not msg:
            return False

        duration = float_safe(duration_hint, 0.0)
        if duration <= 0:
            duration = get_current_duration_sec()
        if duration <= 0:
            return False

        seconds = max(0.0, min(float_safe(seconds, 0.0), duration))
        progress = max(0.0, min(1.0, seconds / duration))

        try:
            controller = get_media_controller().getInstance()
        except Exception:
            controller = None

        return try_call_any(controller, [
            "seekToProgress",
            "seekTo",
            "seekToTime",
            "setPlaybackPosition",
        ], [
            (msg, float(progress)),
            (msg, float(progress), False),
            (float(progress),),
            (int(seconds * 1000),),
            (float(seconds),),
        ])
    except Exception:
        return False


# чтение данных трека
def _read_track_raw():
    msg = get_playing_message_object()

    title = safe_str(call_any(msg, ["getMusicTitle", "getTitle", "getDocumentName"], ""))
    artist = safe_str(call_any(msg, ["getMusicAuthor", "getAuthorName", "getPerformer"], ""))
    duration = float_safe(call_any(msg, ["getDuration", "getAudioDuration"], 0, [tuple()]))

    if duration <= 0:
        duration = get_current_duration_sec()

    fallback = ""
    if not title:
        fallback = safe_str(call_any(msg, ["getDocumentName", "getFileName"], "", [tuple()]))
    if not title and fallback:
        title = cleanup_filename(fallback)

    return msg, title, artist, duration, fallback


# данные текущего трека
def get_current_track_info() -> TrackInfo:
    msg, title, artist, duration, fallback = _read_track_raw()
    return TrackInfo(title=title, artist=artist, duration=duration, query_fallback=fallback, source_msg=msg)


# очистка имени файла
def cleanup_filename(name: str) -> str:
    name = safe_str(name)
    name = re.sub(r"\.(mp3|flac|wav|m4a|ogg|opus|aac)$", "", name, flags=re.I)
    name = name.replace("_", " ")
    name = re.sub(r"^\s*\d{1,3}\s*[\.\)]\s+", "", name)
    name = re.sub(r"^\s*\d{1,3}\s+[-–—]\s+", "", name)
    name = re.sub(r"\s*[-–—]\s*", " - ", name) if re.search(r"\s[-–—]\s", name) else name.replace("-", " ")
    return re.sub(r"\s+", " ", name).strip()


# длительность трека
def get_current_duration_sec() -> float:
    msg = get_playing_message_object()
    duration = float_safe(call_any(msg, ["getDuration", "getAudioDuration"], 0, [tuple()]))
    if duration > 0:
        return duration
    duration = float_safe(java_field(msg, "duration", 0))
    return duration


# на паузе ли трек
def is_track_paused() -> bool:
    try:
        controller = get_media_controller().getInstance()
        return bool(call_any(controller, ["isMessagePaused"], False, [tuple()]))
    except Exception:
        return False


# пауза трека
def pause_current_track() -> bool:
    try:
        controller = get_media_controller().getInstance()
        msg = get_playing_message_object()
        if not msg:
            return False
        return try_call_any(controller, ["pauseMessage"], [(msg,), tuple()])
    except Exception:
        return False


# продолжение трека
def resume_current_track() -> bool:
    try:
        controller = get_media_controller().getInstance()
        msg = get_playing_message_object()
        if not msg:
            return False
        return try_call_any(controller, ["playMessage"], [(msg,), tuple()])
    except Exception:
        return False


# документ играющего трека
def _get_playing_document() -> Tuple[Optional[Any], Optional[Any]]:
    try:
        msg = get_playing_message_object()
        if not msg:
            return None, None
        return call_any(msg, ["getDocument"], None, [tuple()]), msg
    except Exception:
        return None, None


# превью документа
def _document_thumbs(document: Any) -> List[Any]:
    try:
        thumbs = java_field(document, "thumbs", None)
        if thumbs is None:
            return []
        count = thumbs.size()
        return [thumbs.get(i) for i in range(count)]
    except Exception:
        return []


# четкое превью обложки
def try_get_sharp_thumb_bitmap() -> Optional[Any]:
    if not IMAGE_LOADER_AVAILABLE or not BITMAP_FACTORY_AVAILABLE:
        return None
    try:
        document, msg = _get_playing_document()
        if document is None:
            return None
        account = java_field(msg, "currentAccount", None)
        if account is None:
            return None
        best = None
        best_area = -1
        for thumb in _document_thumbs(document):
            try:
                cls_name = thumb.getClass().getSimpleName()
            except Exception:
                continue
            if "Stripped" in cls_name:
                continue
            w = int(java_field(thumb, "w", 0) or 0)
            h = int(java_field(thumb, "h", 0) or 0)
            area = w * h
            if area > best_area:
                best_area = area
                best = thumb
        if best is None:
            return None
        loader = FileLoader.getInstance(account)
        local_file = call_any(loader, ["getPathToAttach"], None, [(best, True), (best,)])
        if local_file is None:
            return None
        exists = bool(call_any(local_file, ["exists"], False, [tuple()]))
        if not exists:
            return None
        path = safe_str(call_any(local_file, ["getAbsolutePath"], ""))
        if not path:
            return None
        bitmap = BitmapFactory.decodeFile(path)
        return bitmap
    except Exception:
        return None


_PROGRESS_PROBE_LAST_VALUE = [None]
_PROGRESS_PROBE_LAST_CHANGE_AT = [0.0]
_PROGRESS_PROBE_LOGGED_SAMPLES = [0]

_PROGRESS_INTERP_LAST_RAW = [None]
_PROGRESS_INTERP_ANCHOR_AT = [0.0]
_PROGRESS_INTERP_MAX_OVERSHOOT_SEC = 1.05


_PROGRESS_MEMO = [(0.0, 0.0)]


# текущая позиция трека
def get_current_progress_sec() -> float:
    now_m = time.monotonic()
    ts, val = _PROGRESS_MEMO[0]
    if now_m - ts < 0.008:
        return val
    v = _get_current_progress_sec_uncached()
    _PROGRESS_MEMO[0] = (now_m, v)
    return v


# позиция без кэша
def _get_current_progress_sec_uncached() -> float:
    raw = _get_current_progress_sec_raw()
    now = time.time()
    try:
        last_raw = _PROGRESS_INTERP_LAST_RAW[0]
        if last_raw is None or raw != last_raw:
            _PROGRESS_INTERP_LAST_RAW[0] = raw
            _PROGRESS_INTERP_ANCHOR_AT[0] = now
            return raw
        if is_track_paused():
            return raw
        elapsed = now - _PROGRESS_INTERP_ANCHOR_AT[0]
        elapsed = max(0.0, min(elapsed, _PROGRESS_INTERP_MAX_OVERSHOOT_SEC))
        return raw + elapsed
    except Exception:
        return raw


# позиция напрямую из плеера
def _get_current_progress_sec_raw() -> float:
    msg = get_playing_message_object()
    value = java_field(msg, "audioProgressSec", None)
    if value is not None:
        result = float_safe(value)
    else:
        value = java_field(msg, "audioProgress", None)
        duration = get_current_duration_sec()
        if value is not None and duration > 0:
            p = float_safe(value)
            if 0 <= p <= 1.2:
                result = p * duration
            else:
                result = p
        else:
            controller = None
            try:
                controller = get_media_controller().getInstance()
            except Exception:
                pass
            result = float_safe(call_any(controller, ["getProgress", "getPlayingProgress"], 0, [tuple()]))

    try:
        now = time.time()
        prev = _PROGRESS_PROBE_LAST_VALUE[0]
        if prev is None:
            _PROGRESS_PROBE_LAST_VALUE[0] = result
            _PROGRESS_PROBE_LAST_CHANGE_AT[0] = now
        elif result != prev:
            held_ms = (now - _PROGRESS_PROBE_LAST_CHANGE_AT[0]) * 1000.0
            _PROGRESS_PROBE_LAST_VALUE[0] = result
            _PROGRESS_PROBE_LAST_CHANGE_AT[0] = now
            if _PROGRESS_PROBE_LOGGED_SAMPLES[0] < 40:
                _PROGRESS_PROBE_LOGGED_SAMPLES[0] += 1
                _debug_log_append(
                    "[LyricFy:progress_probe] value held at {:.3f}s for {:.0f}ms before changing (sample {}/40)".format(
                        prev, held_ms, _PROGRESS_PROBE_LOGGED_SAMPLES[0]
                    )
                )
    except Exception:
        pass

    return result


# хук окна плеера
class AudioPlayerAlertHook(MethodHook):

    # после показа окна плеера
    def after_hooked_method(self, param):
        try:
            options_button: ActionBarMenuItem = get_private_field(param.thisObject, "optionsButton")
            options_button.addSubItem(
                SHOW_LYRICS_ITEM_ID,
                TelegramUtils.get_icon_id("msg_photo_text2"),
                "Показать текст"
            )
            options_button.setSubItemShown(SHOW_LYRICS_ITEM_ID, is_music())
            plog("Hook", "AudioPlayerAlert меню добавлено, is_music={}".format(is_music()))
        except Exception as e:
            inst = Plugin.get_instance()
            if inst:
                inst.log("AudioPlayerAlertHook failed: " + str(e))
            plog_exc("Hook", "AudioPlayerAlertHook.after_hooked_method", e)


# хук обновления UI
class UpdateHook(MethodHook):

    # после обновления UI
    def after_hooked_method(self, param):
        try:
            options_button: ActionBarMenuItem = get_private_field(param.thisObject, "optionsButton")
            options_button.setSubItemShown(SHOW_LYRICS_ITEM_ID, is_music())
        except Exception as e:
            plog_exc("Hook", "UpdateHook.after_hooked_method", e)


# хук пункта меню
class SubItemClickHook(MethodHook):

    def __init__(self, plugin: Plugin):
        self.plugin = plugin

    # перед кликом по пункту
    def before_hooked_method(self, param):
        if param.args[0] != SHOW_LYRICS_ITEM_ID:
            return
        param.setResult(None)
        plog("Hook", "SubItemClick: пользователь нажал 'Показать текст', is_music={}".format(is_music()))
        if not is_music():
            BulletinHelper.show_error("Это не музыкальный трек")
            plog("Hook", "SubItemClick: отклонено — не музыка")
            return
        try:
            self.plugin.present_viewer()
        except Exception as e:
            self.plugin.log("present_viewer failed: " + str(e))
            self.plugin.log(traceback.format_exc())
            plog_crash("Hook", "present_viewer упал в SubItemClickHook", e)
            BulletinHelper.show_error("Не удалось открыть текст")


# обертка над Runnable
class _RunnableProxy(dynamic_proxy(Runnable)):

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    # вызов функции
    def run(self):
        try:
            self.fn()
        except BaseException as e:
            plog_exc("Hook", "_RunnableProxy.run", e)


# хук построения меню плеера
class ShowMenuOptionsHook(MethodHook):

    def __init__(self, plugin: Plugin):
        self.plugin = plugin

    # до построения меню
    def before_hooked_method(self, param):
        self.plugin._in_player_menu = True

    # после построения меню
    def after_hooked_method(self, param):
        self.plugin._in_player_menu = False


# хук показа меню
class ItemOptionsShowHook(MethodHook):

    def __init__(self, plugin: Plugin):
        self.plugin = plugin

    # добавление пункта «Показать текст»
    def before_hooked_method(self, param):
        if not getattr(self.plugin, "_in_player_menu", False):
            return
        self.plugin._in_player_menu = False
        try:
            if not is_music():
                return
            options = param.thisObject

            def on_click():
                try:
                    options.dismiss()
                except Exception:
                    pass
                try:
                    self.plugin.present_viewer()
                except Exception as e:
                    self.plugin.log("present_viewer failed: " + str(e))
                    plog_crash("Hook", "present_viewer упал из меню", e)
                    BulletinHelper.show_error("Не удалось открыть текст")

            options.add(
                TelegramUtils.get_icon_id("msg_photo_text2"),
                "Показать текст",
                _RunnableProxy(on_click),
            )
            plog("Hook", "ItemOptions: пункт 'Показать текст' добавлен")
        except Exception as e:
            plog_exc("Hook", "ItemOptionsShowHook.before_hooked_method", e)

