        self._art_note_view: Optional[TextView] = None
        self.title_view: Optional[TextView] = None
        self.artist_view: Optional[TextView] = None
        self.menu_button: Optional[TextView] = None
        self._art_load_generation = 0
        self._header_art_holder: Optional[FrameLayout] = None
