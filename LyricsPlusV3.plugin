_BACKING_FLAG_KEYS = ("backing", "background", "isBackground", "is_background", "isBacking",
                      "bg", "backgroundVocal", "backingVocal", "isBackup", "backup", "echo")
_BACKING_TYPE_KEYS = ("type", "role", "kind", "voice", "voiceType", "lineType")
_BACKING_TYPE_VALUES = ("background", "backing", "bg", "backup", "echo", "backing_vocal", "background_vocal")
_BACKING_PAREN_RE = re.compile(r"^\s*[\(\[（].+[\)\]）]\s*$")
BACKING_JOIN_NO_WORDS_SEC = 3.0


# помечена ли строка как бэк-вокал
def _entry_backing_flag(entry) -> bool:
    try:
        if not isinstance(entry, dict):
            return False
        for k in _BACKING_FLAG_KEYS:
            v = entry.get(k)
            if isinstance(v, bool):
                if v:
                    return True
            elif isinstance(v, (int, float)):
                if v:
                    return True
            elif isinstance(v, str) and v.strip().lower() in ("1", "true", "yes", "y"):
                return True
        for k in _BACKING_TYPE_KEYS:
            v = entry.get(k)
            if isinstance(v, str) and v.strip().lower() in _BACKING_TYPE_VALUES:
                return True
    except Exception:
        pass
    return False


# конец строки по таймингам слов
def _line_end_from_words(item):
    try:
        words = item.get("words")
        if isinstance(words, list) and words:
            ends = [float_safe(w.get("end"), 0.0) for w in words if isinstance(w, dict)]
            e = max(ends) if ends else 0.0
            if e > float_safe(item.get("time"), 0.0):
                return e
    except Exception:
        pass
    return None


# поиск строк бэк-вокала
def _detect_backing_lines(items) -> Tuple[List[bool], List[bool]]:
    n = len(items)
    flags = [False] * n
    joins = [False] * n
    prev_real = -1
    for i, it in enumerate(items):
        if not isinstance(it, dict) or it.get("pause"):
            continue
        text = safe_str(it.get("text")).strip()
        if not text or text == MUSIC_GAP_MARKER:
            continue
        tv = it.get("time")
        is_bk = _entry_backing_flag(it) or bool(_BACKING_PAREN_RE.match(text))
        prev_end = None
        if prev_real >= 0 and tv is not None:
            pit = items[prev_real]
            prev_end = _line_end_from_words(pit)
        flags[i] = is_bk
        if is_bk and prev_real == i - 1 and tv is not None and not joins[prev_real]:
            pt = items[prev_real].get("time")
            if pt is not None:
                if prev_end is not None:
                    joins[i] = float_safe(tv) <= prev_end + 0.3
                else:
                    joins[i] = (float_safe(tv) - float_safe(pt)) < BACKING_JOIN_NO_WORDS_SEC
        prev_real = i
    real = sum(1 for it in items if isinstance(it, dict) and not it.get("pause"))
    if real and sum(flags) > 0.25 * real:
        return [False] * n, [False] * n
    return flags, joins

