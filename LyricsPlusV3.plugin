    r"re-?master\w*|live|version\w*|ver\.|edit\b|mix\w*|remix\w*|rmx|explicit|clean|deluxe|bonus|"
    r"mono|stereo|official|video|audio|lyrics?|lyric\s+video|visuali[sz]er|acoustic|unplugged|stripped|"
    r"sped\s*up|speed(?:ed)?\s*up|nightcore|slowed|reverb|extended|radio|single|album|original|"
    r"soundtrack|ost\b|instrumental|karaoke|demo\b|cover|bootleg|mashup|rework|flip\b|a\s*cappella|"
    r"acapella|piano|prod\b.*|produced.*|from\b.*|\d{4}|\d+\s*(?:th\s*)?anniversary|"
    r"ремикс\w*|версия|кавер|караоке|минус|инструментал\w*|акустик\w*|лайв|концерт\w*|ускорен\w*|"
    r"замедлен\w*|оригинал\w*|саундтрек|клип|аудио|видео|текст"
)
_BRACKET_RE = re.compile(r"[\(\[\{]([^\)\]\}]*)[\)\]\}]")
_CREDIT_BRACKET_RE = re.compile(
    r"^\s*(?:feat(?:uring)?|ft|with|w/|при\s+уч(?:астии|\.)?|фит)\b\.?\s*(.+?)\s*$", re.I)
_NOISE_START_RE = re.compile(r"^\s*(?:" + _NOISE_STEMS + r")", re.I)
_NOISE_END_RE = re.compile(r"(?:" + _NOISE_STEMS + r")\s*$", re.I)
_TAIL_FEAT_RE = re.compile(
    r"\s+(?:feat(?:uring)?\.?|ft\.?|при\s+уч(?:астии|\.)?|фит)\s+(.+)$", re.I)
_TAIL_NOISE_RE = re.compile(
    r"\s+[-–—]\s+(?:\d{4}\s+)?(?:" + _NOISE_STEMS + r").*$", re.I)
_PLUS_CREDIT_RE = re.compile(r"\s+\+\s*([^+]+)$")
_ARTIST_SPLIT_RE = re.compile(
    r"\s*(?:,|;|\||/|\+|&|\s+and\s+|\s+и\s+|\s+(?:feat(?:uring)?|ft|with|vs|versus)\b\.?\s+"
    r"|\s+при\s+уч(?:астии|\.)?\s+|\s+[x×х]\s+)\s*", re.I)
_ID_SUFFIX_RE = re.compile(r"\*\s*\d{2,}$")

_TAIL_JUNK_RE = re.compile(
    r"\s+(?:pitched|nightcore|sped\s*up|speed(?:ed)?\s*up|slowed|remix(?:ed)?\s+by|prod\.?\s+by)\b.*$", re.I)
_QCLEAN_DROP_CATS = ("So", "Sk", "Cf", "Co", "Cn", "Cs")
_QCLEAN_DROP_CHARS = "#@*~^|\\<>"


# очистка строки для сетевого запроса
def qclean(text: str) -> str:
    t = safe_str(text)
    if not t:
        return ""
    out = []
    for ch in t:
        if ch in _QCLEAN_DROP_CHARS or _ud.category(ch) in _QCLEAN_DROP_CATS:
            out.append(" ")
        else:
            out.append(ch)
    res = re.sub(r"\s+", " ", "".join(out))
    res = re.sub(r"\s+([,;])", r"\1", res)
    return res.strip(" ,;")

_PROTECTED_ARTIST_RES = [re.compile(p, re.I) for p in (
    r"\bAC\s*/\s*DC\b", r"\bTyler,\s*the\s+Creator\b", r"\bEarth,\s*Wind\s*(?:&|and)\s*Fire\b",
    r"\bEmerson,\s*Lake\s*(?:&|and)\s*Palmer\b", r"\bCrosby,\s*Stills,?\s*Nash(?:\s*(?:&|and)\s*Young)?\b",
    r"\bOf\s+Monsters\s+and\s+Men\b", r"\bFlorence\s*(?:\+|&|and)\s*the\s+Machine\b",
    r"\bSimon\s*(?:&|and)\s*Garfunkel\b", r"\bHall\s*(?:&|and)\s*Oates\b", r"\bKool\s*(?:&|and)\s*the\s+Gang\b",
    r"\bMumford\s*(?:&|and)\s*Sons\b", r"\bYears\s*(?:&|and)\s*Years\b", r"\bSam\s*(?:&|and)\s*Dave\b",
    r"\bEcho\s*(?:&|and)\s*the\s+Bunnymen\b", r"\bHuey\s+Lewis\s*(?:&|and)\s*the\s+News\b",
    r"\bBob\s+Marley\s*(?:&|and)\s*the\s+Wailers\b", r"\bIron\s*(?:&|and)\s*Wine\b",
    r"\bMarina\s*(?:&|and)\s*the\s+Diamonds\b", r"\bThe\s+Mamas\s*(?:&|and)\s*the\s+Papas\b",
    r"\bBelle\s*(?:&|and)\s*Sebastian\b", r"\bTegan\s*(?:&|and)\s*Sara\b", r"\bBrooks\s*(?:&|and)\s*Dunn\b",
    r"\bPrince\s*(?:&|and)\s*the\s+Revolution\b", r"\bKC\s*(?:&|and)\s*the\s+Sunshine\s+Band\b",
    r"\bMatt\s*(?:&|and)\s*Kim\b", r"\bAngus\s*(?:&|and)\s*Julia\s+Stone\b", r"\bBig\s*(?:&|and)\s*Rich\b",
    r"\bDarius\s*(?:&|and)\s*Finlay\b", r"\bT\.?\s*A\.?\s*T\.?\s*u\.?\b",
)]


# нормализация строки для сравнения
def _fold(text: str) -> str:
    t = safe_str(text)
    if not t:
        return ""
    try:
        t = _html_mod.unescape(t)
    except Exception:
        pass
    t = _ud.normalize("NFKC", t)
    t = t.replace("’", "'").replace("`", "'").replace("´", "'").replace("‘", "'")
    t = t.replace("\u200b", "").replace("\u200e", "").replace("\u200f", "").replace("\u00a0", " ")
    t = t.lower().replace("ё", "е")
    t = re.sub(r"<\s*/?\s*3+(?![0-9a-zа-я])|[♡♥❤❥🖤💔💜🤍]", " ", t)
    t = "".join(_CHAR_FOLD.get(ch, ch) for ch in t)
    t = _ud.normalize("NFD", t)
    t = "".join(ch for ch in t if _ud.category(ch) != "Mn")
    t = re.sub(r"(?<=[a-z])!(?=[a-z])", "i", t)
    t = re.sub(r"(?<=[a-z])\$(?=[a-z])", "s", t)
    t = re.sub(r"\b(\w)\.(?=\w\b)", r"\1", t)
    t = t.replace("&", " and ")
    return t


# скобки с мусором в названии
def _is_noise_bracket(content: str) -> bool:
    c = safe_str(content).lower()
    if not c:
        return True
    if _CREDIT_BRACKET_RE.match(c):
        return True
    return bool(_NOISE_START_RE.match(c) or _NOISE_END_RE.search(c))


# исполнители из feat/ft в названии
def _extract_credits(raw: str) -> List[str]:
    out: List[str] = []
    text = safe_str(raw)
    for m in _BRACKET_RE.finditer(text):
        cm = _CREDIT_BRACKET_RE.match(m.group(1))
        if cm:
            out.extend(_split_artists_raw(cm.group(1)))
    stripped = _BRACKET_RE.sub(" ", text)
    tm = _TAIL_FEAT_RE.search(stripped)
    if tm:
        out.extend(_split_artists_raw(tm.group(1)))
    pm = _PLUS_CREDIT_RE.search(stripped)
    if pm:
        out.extend(_split_artists_raw(pm.group(1)))
    return out


# название для показа без мусора
def _clean_display_title(raw: str) -> str:
    text = safe_str(raw)
    if not text:
        return ""

    def _repl(m):
        return " " if _is_noise_bracket(m.group(1)) else m.group(0)

    cleaned = _BRACKET_RE.sub(_repl, text)
    cleaned = _TAIL_FEAT_RE.sub("", cleaned)
    cleaned = _PLUS_CREDIT_RE.sub("", cleaned)
    cleaned = _TAIL_NOISE_RE.sub("", cleaned)
    _jt = _TAIL_JUNK_RE.sub("", cleaned)
    if len(_jt.strip()) >= 2:
        cleaned = _jt
    cleaned = re.sub(r"<\s*/?\s*3+(?![0-9A-Za-zА-Яа-я])|[♡♥❤❥🖤💔💜🤍]", " ", cleaned)
    cleaned = re.sub(r"\s+", " ", cleaned).strip(" -–—_.,;:")
    return cleaned or text


# нормализация части названия
def _normalize_part(text: str) -> str:
    return _normalize_part_cached(safe_str(text))


# то же с кэшем
@_lru_cache(maxsize=4096)
def _normalize_part_cached(text: str) -> str:
    raw = safe_str(text)
    if not raw:
        return ""
    t = _fold(raw)
    no_br = _BRACKET_RE.sub(" ", t)
    core = _TAIL_FEAT_RE.sub("", no_br)
    core = _TAIL_NOISE_RE.sub("", core)
    core = re.sub(r"[']", "", core)
    core = re.sub(r"[^\w]+", " ", core, flags=re.UNICODE)
    core = re.sub(r"\s+", " ", core).strip()
    if not core:
        inner = re.sub(r"[']", "", t)
        inner = re.sub(r"[^\w]+", " ", inner, flags=re.UNICODE)
        core = re.sub(r"\s+", " ", inner).strip()
    return core


# ключ трека для кэша
def normalize_key(*parts: str) -> str:
    items = [_normalize_part(p) for p in parts if safe_str(p)]
    return re.sub(r"\s+", " ", " ".join(x for x in items if x)).strip()


# приведение имени артиста к единому виду
def _canonical_artist_token(token: str) -> str:
    value = safe_str(token).strip().lower()
    value = _ID_SUFFIX_RE.sub("", value)
    value = re.sub(r"(?<=[a-zа-яё])\d{2,}$", "", value, flags=re.I)
    n = normalize_key(value)
    if n.startswith("the ") and len(n) > 7:
        n = n[4:]
    return n


# разбиение строки артистов
def _split_artists_raw(value: str) -> List[str]:
    text = safe_str(value)
    if not text:
        return []
    holders: Dict[str, str] = {}

    def _protect(m):
        key = "\u0001%d\u0001" % len(holders)
        holders[key] = m.group(0)
        return key

    for rx in _PROTECTED_ARTIST_RES:
        text = rx.sub(_protect, text)
    parts = []
    seen = set()
    for item in _ARTIST_SPLIT_RE.split(text):
        for k, v in holders.items():
            item = item.replace(k, v)
        item = _ID_SUFFIX_RE.sub("", safe_str(item)).strip(" .")
        key = item.lower()
        if item and key not in seen:
            seen.add(key)
            parts.append(item)
    return parts


# список артистов трека
def _split_artists(value: str) -> List[str]:
    out: List[str] = []
    for item in _split_artists_raw(value):
        n = _canonical_artist_token(item)
        if n and n not in out:
            out.append(n)
    return out


# основной артист
def _primary_artist(value: str) -> str:
    parts = _split_artists_raw(value)
    return parts[0] if parts else safe_str(value).strip()


_VERSION_RULES = [
    ("live", re.compile(r"\blive\b|\bлайв\b|\bконцерт\w*")),
    ("acoustic", re.compile(r"\bacoustic\b|\bunplugged\b|\bstripped\b|\bакустик\w*")),
    ("remix", re.compile(r"\bremix\w*|\brmx\b|\bbootleg\b|\bmashup\b|\brework\b|\bflip\b|\bре?микс\w*")),
    ("instrumental", re.compile(r"\binstrumental\b|\bkaraoke\b|\bbacking\s+track\b|\bкараоке\b|\bминус\b|\bинструментал\w*")),
    ("fast", re.compile(r"\bsped\s*up\b|\bspeed(?:ed)?\s*up\b|\bnightcore\b|\bускорен\w*")),
    ("slow", re.compile(r"\bslowed\b|\breverb\b|\bзамедлен\w*")),
    ("cover", re.compile(r"\bcover\b|\btribute\b|\bmade\s+famous\b|\bin\s+the\s+style\s+of\b|\bкавер\b")),
    ("demo", re.compile(r"\bdemo\b|\bдемо\b")),
    ("extended", re.compile(r"\bextended\b|\bfull\s+version\b|\bclub\s+mix\b")),
    ("piano", re.compile(r"\bpiano\b")),
    ("a_cappella", re.compile(r"\ba\s*cappella\b|\bacapella\b")),
]
_LANG_VERSION_RE = re.compile(
    r"\b(spanish|russian|english|french|german|italian|korean|japanese|portuguese|ukrainian|"
    r"русская|английская|испанская)\s+(?:version|ver\b|версия)")
_VERSION_PENALTY = {
    "live": 0.06, "acoustic": 0.05, "remix": 0.12, "instrumental": 0.40, "fast": 0.10, "slow": 0.10,
    "cover": 0.30, "demo": 0.05, "extended": 0.03, "piano": 0.04, "a_cappella": 0.10,
}


# теги версии из названия (live, remix...)
@_lru_cache(maxsize=4096)
def extract_versions(raw: str) -> frozenset:
    t = _fold(raw)
    if not t:
        return frozenset()
    segs = [m.group(1) for m in _BRACKET_RE.finditer(t)]
    tm = re.search(r"\s[-–—]\s(.+)$", t)
    if tm:
        segs.append(tm.group(1))
    jm = _TAIL_JUNK_RE.search(t)
    if jm:
        segs.append(jm.group(0))
    tags = set()
    for s in segs:
        for name, rx in _VERSION_RULES:
            if rx.search(s):
                tags.add(name)
        lm = _LANG_VERSION_RE.search(s)
        if lm:
            tags.add("lang:" + lm.group(1))
    return frozenset(tags)


# штраф за несовпадение версий
def version_penalty(target_tags, cand_tags) -> float:
    pen = 0.0
    for tag in set(cand_tags) - set(target_tags):
        pen += _VERSION_PENALTY.get(tag, 0.08 if tag.startswith("lang:") else 0.05)
    for tag in set(target_tags) - set(cand_tags):
        pen += 0.5 * _VERSION_PENALTY.get(tag, 0.08 if tag.startswith("lang:") else 0.05)
    return min(pen, 0.6)


# транслитерация
def _translit(s: str) -> str:
    return "".join(_TR_MAP.get(ch, ch) for ch in s)


_PHON_STRONG = [
    (re.compile(r"eu"), "ev"),
    (re.compile(r"shch|sch|shh"), "sh"), (re.compile(r"tch"), "ch"), (re.compile(r"kh"), "h"),
    (re.compile(r"zh"), "j"), (re.compile(r"ts|tc|tz"), "c"),
    (re.compile(r"[yij]a"), "a"), (re.compile(r"[yij]u"), "u"), (re.compile(r"[yij]o"), "o"),
    (re.compile(r"[yij]e"), "e"), (re.compile(r"ey|ei|ej"), "ei"),
    (re.compile(r"(?:ii|iy|yi|yy|ij)(?=\b)"), "i"), (re.compile(r"y\b"), "i"),
    (re.compile(r"y"), "i"), (re.compile(r"w"), "v"), (re.compile(r"q"), "k"), (re.compile(r"x"), "ks"),
    (re.compile(r"(.)\1+"), r"\1"),
]
_PHON_MILD = [
    (re.compile(r"shch|sch|shh"), "sh"), (re.compile(r"kh"), "h"), (re.compile(r"zh"), "j"),
    (re.compile(r"(?:ii|iy|yi|ij)(?=\b)"), "i"), (re.compile(r"y\b"), "i"), (re.compile(r"(.)\1+"), r"\1"),
]


# упрощенная фонетика строки
def _phon(s: str, rules) -> str:
    for rx, rep in rules:
        s = rx.sub(rep, s)
    return s


# есть ли не латинские символы
def _has_non_latin(s: str) -> bool:
    return any(ord(ch) > 0x24F and ch.isalpha() for ch in s)


# транслит для запросов
def translit_display(s: str) -> str:
    out = _translit(safe_str(s).replace("ё", "е").replace("Ё", "Е").lower()) if _has_non_latin(s) else safe_str(s)
    return " ".join(w[:1].upper() + w[1:] for w in out.split())


# расстояние Левенштейна
@_lru_cache(maxsize=8192)
def _edit_distance(a: str, b: str) -> int:
    if a == b:
        return 0
    la, lb = len(a), len(b)
    m = la if la < lb else lb
    p = 0
    while p < m and a[p] == b[p]:
        p += 1
    if p:
        a = a[p:]
        b = b[p:]
        la -= p
        lb -= p
        m -= p
    s = 0
    while s < m and a[la - 1 - s] == b[lb - 1 - s]:
        s += 1
    if s:
        a = a[:la - s]
        b = b[:lb - s]
    if len(a) < len(b):
        a, b = b, a
    if not b:
        return len(a)
    la, lb = len(a), len(b)
    prev2 = None
    prev = list(range(lb + 1))
    for i in range(1, la + 1):
        ca = a[i - 1]
        cur = [i] + [0] * lb
        for j in range(1, lb + 1):
            cb = b[j - 1]
            v = prev[j - 1] + (0 if ca == cb else 1)
            x = prev[j] + 1
            if x < v:
                v = x
            x = cur[j - 1] + 1
            if x < v:
                v = x
            if prev2 is not None and i > 1 and j > 1 and ca == b[j - 2] and a[i - 2] == cb:
                x = prev2[j - 2] + 1
                if x < v:
                    v = x
            cur[j] = v
        prev2, prev = prev, cur
    return prev[lb]


# набор n-грамм
def _grams(s: str, n: int):
    s = " " + s + " "
    if len(s) < n:
        return {s}
    return {s[i:i + n] for i in range(len(s) - n + 1)}


# коэффициент Дайса
def _dice(a: str, b: str, n: int) -> float:
    ga, gb = _grams(a, n), _grams(b, n)
    if not ga or not gb:
        return 0.0
    return 2.0 * len(ga & gb) / (len(ga) + len(gb))


# штраф за разные цифры
def _digit_mismatch_factor(a: str, b: str) -> float:
    da = set(re.findall(r"\d+", a))
    db = set(re.findall(r"\d+", b))
    if da == db:
        return 1.0
    if da and db:
        return 0.5 if not (da & db) else 0.8
    return 0.80


# сходство пары слов
@_lru_cache(maxsize=8192)
def _token_pair_sim(x: str, y: str) -> float:
    if x == y:
        return 1.0
    if len(x) <= 2 or len(y) <= 2:
        return 0.0
    return 1.0 - _edit_distance(x, y) / float(max(len(x), len(y)))


# сходство по словам
def _token_similarity(a: str, b: str) -> float:
    ta = [x for x in a.split() if x]
    tb = [x for x in b.split() if x]
    if not ta and not tb:
        return 1.0
    if not ta or not tb:
        return 0.0
    short, long_ = (ta, tb) if len(ta) <= len(tb) else (tb, ta)
    used = set()
    matched = 0.0
    for tok in short:
        best_i, best = -1, 0.0
        for i, other in enumerate(long_):
            if i in used:
                continue
            s = _token_pair_sim(tok, other)
            if s > best:
                best_i, best = i, s
        if best_i >= 0 and best >= 0.75:
            matched += best
            used.add(best_i)
    return matched / float(len(long_))


# вхождение короткой строки в длинную
def _containment_sim(a: str, b: str) -> float:
    ta = a.split()
    tb = b.split()
    if not ta or not tb:
        return 0.0
    short, long_ = (ta, tb) if len(a) <= len(b) else (tb, ta)
    if len(short) == len(long_) and short != long_:
        return 0.0
    pool = list(long_)
    for tok in short:
        hit = None
        for o in pool:
            if tok == o or _token_pair_sim(tok, o) >= 0.85:
                hit = o
                break
        if hit is None:
            return 0.0
        pool.remove(hit)
    ratio = len("".join(short)) / float(max(len("".join(long_)), 1))
    return 0.35 + 0.45 * ratio


# основа сравнения строк
def _sim_core(a: str, b: str) -> float:
    ca, cb = a.replace(" ", ""), b.replace(" ", "")
    if ca == cb:
        return 0.99
    longest = max(len(ca), len(cb), 1)
    shortest = min(len(ca), len(cb))
    best = 0.0
    if shortest / float(longest) >= 0.4:
        best = max(best, 1.0 - _edit_distance(ca, cb) / float(longest))
    best = max(best, _dice(ca, cb, 3) * 0.97 if shortest >= 3 else _dice(ca, cb, 2) * 0.9)
    best = max(best, _token_similarity(a, b) * 0.96)
    best = max(best, _containment_sim(a, b))
    return min(best, 0.99)


# сходство двух строк от 0 до 1
@_lru_cache(maxsize=16384)
def string_sim(a: str, b: str) -> float:
    if a == b:
        return 1.0
    if not a or not b:
        return 0.0
    best = _sim_core(a, b)
    na, nb = _has_non_latin(a), _has_non_latin(b)
    if na or nb:
        ta, tb = _translit(a), _translit(b)
        best = max(best, 0.95 * _sim_core(ta, tb))
        if na != nb:
            pa, pb = _phon(ta, _PHON_STRONG), _phon(tb, _PHON_STRONG)
            if pa == pb:
                best = max(best, 0.975)
            else:
                best = max(best, 0.93 * _sim_core(pa, pb))
    elif best < 0.9:
        pa, pb = _phon(a, _PHON_MILD), _phon(b, _PHON_MILD)
        if (pa != a or pb != b):
            best = max(best, 0.92 * _sim_core(pa, pb))
    return max(0.0, min(1.0, best * _digit_mismatch_factor(a, b)))


# сходство по n-граммам
def ngram_similarity(a: str, b: str, n: int = 3) -> float:
    return string_sim(normalize_key(a), normalize_key(b))


# сходство списков артистов
def _artist_list_similarity(la: List[str], lb: List[str]) -> float:
    if not la and not lb:
        return 1.0
    if not la or not lb:
        return 0.0
    joined = string_sim(" ".join(la), " ".join(lb))
    short, long_ = (la, lb) if len(la) <= len(lb) else (lb, la)
    cov = 0.0
    for x in short:
        cov += max(string_sim(x, y) for y in long_)
    cov /= float(len(short))
    if len(la) != len(lb):
        cov *= 0.97
    return max(joined, cov)


# сходство артистов
def artist_similarity(a: str, b: str) -> float:
    s = _artist_list_similarity(_split_artists(a), _split_artists(b))
    wa, wb = normalize_key(a), normalize_key(b)
    if wa and wb:
        s = max(s, 0.98 * string_sim(wa, wb))
    return s


_SLASH_SPLIT_RE = re.compile(r"\s*/{2,}\s*|\s+a\.?k\.?a\.?\s+", re.I)
_GLUED_ARTIST_RE = re.compile(r"^([^\s\-–—]{2,30})[-–—]([^\s\-–—].{2,})$")
_FILE_EXT_RE = re.compile(r"\.(?:mp3|мп3|wav|flac|m4a|ogg|opus|aac)\s*$", re.I)


# разделение слепленных артиста и названия
def _glued_artist_split(text: str):
    t = safe_str(text)
    if _TITLE_SPLIT_RE_EARLY.search(t):
        return None
    m = _GLUED_ARTIST_RE.match(t)
    if not m:
        return None
    left, right = m.group(1), m.group(2).strip()
    if (any(ch.isdigit() for ch in left) or (left.isupper() and len(left) >= 3)) and len(right) >= 3:
        return left, right
    return None


_TITLE_SPLIT_RE_EARLY = re.compile(r"\s+[-–—]\s+")


# альтернативные куски названия
def _alt_title_pieces(text: str) -> List[str]:
    out: List[str] = []
    t = safe_str(text)
    if not t:
        return out
    parts = [x.strip() for x in _SLASH_SPLIT_RE.split(t) if x and x.strip()]
    if len(parts) > 1:
        out.append(parts[0])
    g = _glued_artist_split(t)
    if g:
        out.append(g[1])
    ext = _FILE_EXT_RE.sub("", t).strip()
    if ext and ext != t:
        out.append(ext)
    return out


# варианты записи названия
@_lru_cache(maxsize=4096)
def _title_forms(raw: str) -> Tuple[Tuple[str, float], ...]:
    raw = safe_str(raw)
    forms: List[Tuple[str, float]] = []

    def _add(text: str, w: float):
        n = normalize_key(text)
        if n and all(n != f for f, _ in forms):
            forms.append((n, w))

    _add(raw, 1.0)
    clean = _clean_display_title(raw)
    for m in _BRACKET_RE.finditer(clean):
        inner = m.group(1)
        if not _is_noise_bracket(inner) and len(normalize_key(inner).replace(" ", "")) >= 3:
            _add(inner, 0.94)
    no_br = _BRACKET_RE.sub(" ", clean)
    pieces = re.split(r"\s+[-–—/]\s+|:\s+|\s*\|\s*", no_br, maxsplit=1)
    if len(pieces) == 2:
        for p in pieces:
            if len(normalize_key(p).replace(" ", "")) >= 3:
                _add(p, 0.94)
    for piece in _alt_title_pieces(no_br):
        if len(normalize_key(piece).replace(" ", "")) >= 3:
            _add(piece, 0.92)
    return tuple(forms[:7])


# лучшее сходство названия
def _best_title_sim(fa, fb) -> float:
    best = 0.0
    for x, wx in fa:
        for y, wy in fb:
            s = string_sim(x, y) * min(wx, wy)
            if s > best:
                best = s
    return best


# поправка по длительности
def _duration_factor(diff: float) -> float:
    if diff <= 2:
        return 1.0
    if diff <= 4:
        return 0.92
    if diff <= 7:
        return 0.75
    if diff <= 12:
        return 0.50
    if diff <= 25:
        return 0.25
    return 0.0


# порог по названию
def _title_gate(t: float, tlen: int, have_dur: bool, diff: float, artist_known: bool) -> bool:
    if t >= 0.97:
        return True
    short = tlen <= 8
    if have_dur and diff <= 3.0:
        need = 0.88 if short else 0.78
    elif have_dur and diff <= 8.0:
        need = 0.93 if short else 0.84
    else:
        need = 0.97 if short else 0.88
    if not artist_known:
        need = min(0.99, need + 0.07)
    return t >= need


# подготовленный запрос для сравнения
class MatchTarget:

    def __init__(self, title: str, artist: str, duration: float = 0.0, raw_title: str = ""):
        self.title_n = normalize_key(title)
        forms = list(_title_forms(title))
        if raw_title and safe_str(raw_title) != safe_str(title):
            for f in _title_forms(raw_title):
                if all(f[0] != x[0] for x in forms):
                    forms.append(f)
        self.forms = tuple(forms)
        self.artists = _split_artists(artist)
        self.artist_whole = normalize_key(artist)
        self.versions = extract_versions(raw_title or title)
        self.duration = float(duration or 0.0)


# длительность в секунды
def _norm_duration(value: Any) -> float:
    d = float_safe(value, 0.0)
    return d / 1000.0 if d > 3000 else d


# оценка кандидата
def score_candidate(target: "MatchTarget", cand_title: str, cand_artist: str,
                    cand_duration: float = 0.0, synced: bool = False, plain: bool = False,
                    artist_only_query: bool = False, ambiguous: bool = False,
                    cand_versions=None, instrumental: bool = False) -> Dict[str, Any]:
    cforms = _title_forms(cand_title)
    ca = _split_artists(cand_artist)
    for item in _extract_credits(safe_str(cand_title)):
        c = _canonical_artist_token(item)
        if c and c not in ca:
            ca.append(c)
    c_whole = normalize_key(cand_artist)
    has_t = bool(target.forms and cforms)
    t = _best_title_sim(target.forms, cforms) if has_t else 0.5
    artists_known = bool(target.artists and ca)

    def _a_sim(tl, cl, tw, cw):
        s = _artist_list_similarity(tl, cl)
        if tw and cw:
            s = max(s, 0.98 * string_sim(tw, cw))
        return s

    a = _a_sim(target.artists, ca, target.artist_whole, c_whole) if artists_known else 0.5
    swapped = False
    if has_t and artists_known and t < 0.8:
        t2 = _best_title_sim(target.forms, _title_forms(cand_artist))
        a2 = _a_sim(target.artists, _split_artists(cand_title), target.artist_whole, normalize_key(cand_title))
        if t2 >= 0.85 and a2 >= 0.85:
            t, a, swapped = 0.97 * t2, 0.97 * a2, True

    cd = _norm_duration(cand_duration)
    have_dur = target.duration > 0 and cd > 0
    diff = abs(cd - target.duration) if have_dur else -1.0
    cv = frozenset(cand_versions) if cand_versions is not None else extract_versions(safe_str(cand_title))
    if instrumental:
        cv = cv | {"instrumental"}
    dur_ignored = bool(have_dur and diff > 4.0 and ({"fast", "slow"} & set(target.versions))
                       and not ({"fast", "slow"} & set(cv)))
    untitled = not target.forms
    if dur_ignored:
        have_dur, df = False, 0.0
    df = _duration_factor(diff) if have_dur else 0.0

    identity = (0.46 * t + 0.28 * a + 0.26 * df) if have_dur else (0.62 * t + 0.38 * a)
    reject, reason = False, ""
    if untitled and not (artists_known and have_dur and 0 <= diff <= 1.5):
        reject, reason = True, "untitled"
    tlen = len(target.title_n.replace(" ", ""))
    if has_t and not _title_gate(t, tlen, have_dur, diff, bool(target.artists)):
        reject, reason = True, "title"
    relaxed = False
    if not reject and artists_known:
        if a < 0.40:
            if (synced and have_dur and t >= 0.97
                    and diff <= 1.5 and tlen >= 5 and (len(target.title_n.split()) >= 2 or tlen >= 9)):
                relaxed = True
                identity = min(identity, 0.74)
            else:
                reject, reason = True, "artist"
        elif a < 0.65:
            identity -= (0.65 - a) * 0.9
    if not reject and have_dur and diff > 45 and t < 0.999:
        reject, reason = True, "duration"
    if synced and have_dur and diff > 25 and t < 0.999:
        reject, reason = True, "duration"
    elif synced and have_dur and diff > 25:
        identity -= 0.15
    if artist_only_query and t < 0.5:
        identity -= 0.2

    vpen = version_penalty(target.versions, cv)
    score = max(0.0, identity - vpen) + (0.04 if synced else (0.01 if plain else 0.0))
    score = min(1.0, score)
    if relaxed or (untitled and not reject):
        score = min(score, 0.79)
    exact = bool(t >= 0.99 and a >= 0.90 and (not have_dur or diff <= 4.0) and vpen <= 0.0001 and not reject)
    return {"score": score, "title_sim": t, "artist_sim": a, "dur_diff": diff, "reject": reject,
            "reason": reason, "synced": synced, "ver_pen": vpen, "exact": exact, "swapped": swapped,
            "relaxed": relaxed, "untitled": untitled, "dur_ignored": dur_ignored}


ACCEPT_SCORE = 0.72


# варианты поискового запроса
def build_query_variants(title: str, artist: str) -> List[Dict[str, str]]:
    clean_title = _clean_display_title(title)
    primary = _primary_artist(artist)
    full = ", ".join(_split_artists_raw(artist)[:3])
    out: List[Dict[str, str]] = []
    seen = set()

    def _add(t: str, a: str):
        t, a = qclean(t), qclean(a)
        key = (normalize_key(t), normalize_key(a))
        if t and key[0] and key not in seen:
            seen.add(key)
            out.append({"title": t, "artist": a})

    _add(clean_title, primary)
    if full and full != primary:
        _add(clean_title, full)
    if title and safe_str(title) != clean_title:
        _add(title, primary)
    forms = _title_forms(title)
    if len(forms) > 1 and primary:
        no_br = _BRACKET_RE.sub(" ", clean_title)
        pieces = [p.strip() for p in re.split(r"\s+[-–—/]\s+|:\s+|\s*\|\s*", no_br, maxsplit=1) if p.strip()]
        for p in pieces[:2]:
            if len(p) >= 3:
                _add(p, primary)
        for m in _BRACKET_RE.finditer(clean_title):
            if not _is_noise_bracket(m.group(1)) and len(m.group(1).strip()) >= 3:
                _add(m.group(1).strip(), primary)
    for tv in (_alt_title_pieces(clean_title)[:3] + [_CAMEL_SPLIT_RE.sub(" ", clean_title)]):
        _add(tv, primary)
    if _has_non_latin(clean_title) or _has_non_latin(primary):
        _add(translit_display(clean_title), translit_display(primary))
    _add(clean_title, "")
    return out[:9]


_CAMEL_SPLIT_RE = re.compile(r"(?<=[a-zа-яё])(?=[A-ZА-ЯЁ])")
_TITLE_SYMBOLS_RE = re.compile(r"[<>♥❤♡★☆*#@~^|\\/_=+•·]+")


# варианты написания названия
def build_title_variants(title: str) -> List[str]:
    base = _clean_display_title(title) or safe_str(title)
    out: List[str] = []
    seen = set()

    def _add(s: str):
        s = re.sub(r"\s+", " ", qclean(s)).strip(" -–—_.,;:")
        key = normalize_key(s)
        if s and key and key not in seen:
            seen.add(key)
            out.append(s)

    _add(base)
    for _piece in _alt_title_pieces(base):
        _add(_piece)
    _add(_CAMEL_SPLIT_RE.sub(" ", base))
    _add(re.sub(r"\s*<\s*3\b", "", base))
    _add(_TITLE_SYMBOLS_RE.sub(" ", base))
    _add(re.sub(r"\s*[\(\[].*?[\)\]]", "", base))
    _add(re.sub(r"[^\w\s']", " ", base, flags=re.UNICODE))
    if _has_non_latin(base):
        _add(translit_display(base))
    return out[:8]


import queue as _queue_mod

_HTTP_SESSIONS: Dict[str, Any] = {}
_HTTP_LOCK = threading.Lock()
_HOST_STATE: Dict[str, Dict[str, float]] = {}
HOST_FAIL_LIMIT = 3
HOST_COOLDOWN_SEC = 40.0
HOST_POLICY = {
    "api.liriqo-alfarrizi.my.id": (7, 8.0),
    "lrclib.net": (7, 8.0),
    "karalyr.com": (6, 10.0),
}
HOST_MAX_RETRY_AFTER_SEC = 30.0
HOST_CONCURRENCY = {
    "api.liriqo-alfarrizi.my.id": 4,
    "genius.com": 3,
    "lrclib.net": 5,
}
_HOST_SEMS: Dict[str, Any] = {}


# исключение ожидания семафора
class _SemWaitTimeout(Exception):
    pass


# семафор для хоста
def _host_sem(host: str):
    lim = HOST_CONCURRENCY.get(host)
    if not lim:
        return None
    with _HTTP_LOCK:
        sem = _HOST_SEMS.get(host)
        if sem is None:
            sem = threading.BoundedSemaphore(lim)
            _HOST_SEMS[host] = sem
        return sem


# выполнение GET-запроса
def _do_get(host: str, url: str, params, headers, connect_t: float, read_t: float, deadline: float):
    sem = _host_sem(host)
    if sem is None:
        return _http_session(host).get(url, params=params, headers=headers, timeout=(connect_t, read_t))
    wait_t = 4.0 if deadline <= 0 else max(0.1, min(4.0, deadline - time.time() - 0.3))
    if not sem.acquire(timeout=wait_t):
        raise _SemWaitTimeout()
    try:
        return _http_session(host).get(url, params=params, headers=headers, timeout=(connect_t, read_t))
    finally:
        sem.release()


# общая http-сессия
def _http_session(host: str):
    with _HTTP_LOCK:
        sess = _HTTP_SESSIONS.get(host)
        if sess is not None:
            return sess
        sess = requests.Session()
        try:
            from requests.adapters import HTTPAdapter
            adapter = HTTPAdapter(pool_connections=4, pool_maxsize=8, max_retries=0)
            sess.mount("https://", adapter)
            sess.mount("http://", adapter)
        except Exception:
            pass
        _HTTP_SESSIONS[host] = sess
        return sess


# хост из url
def _host_of(url: str) -> str:
    try:
        return url.split("//", 1)[1].split("/", 1)[0].lower()
    except Exception:
        return url


# заблокирован ли хост
def host_blocked(host: str) -> bool:
    st = _HOST_STATE.get(host)
    return bool(st and st.get("until", 0.0) > time.time())


# учет успехов и ошибок хоста
def _host_report(host: str, ok: bool, cooldown: float = 0.0) -> None:
    with _HTTP_LOCK:
        st = _HOST_STATE.setdefault(host, {"fails": 0.0, "until": 0.0})
        if ok:
            st["fails"] = 0.0
            return
        if cooldown > 0:
            st["until"] = time.time() + cooldown
            return
        st["fails"] += 1
        limit, cool = HOST_POLICY.get(host, (HOST_FAIL_LIMIT, HOST_COOLDOWN_SEC))
        if st["fails"] >= limit:
            st["until"] = time.time() + cool
            st["fails"] = 0.0


_HTTP_CACHE: Dict[str, Tuple[float, Any, int]] = {}
HTTP_CACHE_MAX = 300


# очистка http-кэша
def http_cache_clear() -> None:
    with _HTTP_LOCK:
        _HTTP_CACHE.clear()


# ключ http-кэша
def _http_cache_key(url: str, params: Optional[Dict[str, Any]]) -> str:
    if not params:
        return url
    return url + "?" + "&".join("{}={}".format(k, params[k]) for k in sorted(params))


# GET-запрос с повторами
def http_get(url: str, params: Optional[Dict[str, Any]] = None, headers: Optional[Dict[str, str]] = None,
             timeout: Tuple[float, float] = (1.5, 3.5), deadline: float = 0.0,
             tag: str = "", retry_timeout: bool = True) -> Tuple[Optional[Any], int]:
    host = _host_of(url)
    if host_blocked(host):
        search_log("{}: хост {} временно отключен (серия сбоев), пропуск".format(tag or "HTTP", host))
        return None, -1
    connect_t, read_t = timeout
    resp = None
    code = 0
    for attempt in range(2):
        clamped = False
        if deadline > 0:
            remaining = deadline - time.time()
            if remaining <= 0.15:
                return None, -2
            if remaining < read_t:
                read_t_eff, clamped = max(0.4, remaining), True
            else:
                read_t_eff = read_t
            connect_eff = max(0.3, min(connect_t, remaining))
        else:
            read_t_eff, connect_eff = read_t, connect_t
        try:
            resp = _do_get(host, url, params, headers, connect_eff, read_t_eff, deadline)
        except _SemWaitTimeout:
            search_log("{}: очередь к хосту {} занята, пропуск".format(tag or host, host))
            return None, -2
        except Exception as e:
            is_timeout = "Timeout" in type(e).__name__
            if not (is_timeout and clamped):
                _host_report(host, False)
            search_log("{}: сетевая ошибка {}: {}".format(tag or host, type(e).__name__, str(e)[:120]))
            if is_timeout:
                can_retry = (retry_timeout and not clamped and attempt == 0
                             and (deadline <= 0 or deadline - time.time() > read_t + 0.8))
            else:
                can_retry = attempt == 0 and (deadline <= 0 or deadline - time.time() > 1.0)
            if can_retry:
                time.sleep(0.12)
                continue
            return None, 0
        code = int(getattr(resp, "status_code", 0) or 0)
        if code == 429 and attempt == 0:
            try:
                _w = float(resp.headers.get("Retry-After", "1.5"))
            except Exception:
                _w = 1.5
            _w = max(0.8, min(_w, 4.0))
            if deadline <= 0 or deadline - time.time() > _w + 1.2:
                search_log("{}: HTTP 429, жду {:.1f}с и повторяю".format(tag or host, _w))
                time.sleep(_w)
                continue
        if code in (502, 503, 504) and attempt == 0 and (deadline <= 0 or deadline - time.time() > 1.0):
            time.sleep(0.15)
            continue
        break
    if code == 429:
        try:
            wait = float(resp.headers.get("Retry-After", "5"))
        except Exception:
            wait = 5.0
        _host_report(host, False, cooldown=max(2.0, min(wait, HOST_MAX_RETRY_AFTER_SEC)))
        search_log("{}: HTTP 429, пауза для хоста".format(tag or host))
    elif code >= 500:
        _host_report(host, False)
    else:
        _host_report(host, True)
    return resp, code


# GET-запрос с разбором json
def http_get_json(url: str, params: Optional[Dict[str, Any]] = None, headers: Optional[Dict[str, str]] = None,
                  timeout: Tuple[float, float] = (1.5, 3.5), deadline: float = 0.0,
                  tag: str = "", cache_ttl: float = 0.0, retry_timeout: bool = True) -> Tuple[Optional[Any], int]:
    ckey = _http_cache_key(url, params) if cache_ttl > 0 else ""
    if ckey:
        with _HTTP_LOCK:
            hit = _HTTP_CACHE.get(ckey)
        if hit and time.time() - hit[0] < cache_ttl:
            return hit[1], hit[2]
    resp, code = http_get(url, params, headers, timeout, deadline, tag, retry_timeout)
    if resp is None:
        return None, code
    if code != 200:
        if code != 429 and not (code == 404 and (tag or "").startswith("LRCLIB get")):
            search_log("{}: HTTP {}".format(tag or _host_of(url), code))
        if ckey and code == 404:
            with _HTTP_LOCK:
                _HTTP_CACHE[ckey] = (time.time(), None, 404)
        return None, code
    try:
        data = resp.json()
    except Exception as e:
        search_log("{}: некорректный JSON: {}".format(tag or url, str(e)[:100]))
        return None, -3
    if ckey:
        with _HTTP_LOCK:
            if len(_HTTP_CACHE) >= HTTP_CACHE_MAX:
                for k in sorted(_HTTP_CACHE, key=lambda x: _HTTP_CACHE[x][0])[:HTTP_CACHE_MAX // 3]:
                    _HTTP_CACHE.pop(k, None)
            _HTTP_CACHE[ckey] = (time.time(), data, 200)
    return data, code


# параллельный запуск задач
def run_parallel(tasks: List[Tuple[str, Any]], deadline: float, on_result=None) -> Dict[str, Any]:
    q: "_queue_mod.Queue" = _queue_mod.Queue()
    results: Dict[str, Any] = {}

    def _worker(name, fn):
        try:
            q.put((name, fn(), None))
        except BaseException as e:
            q.put((name, None, e))

    for name, fn in tasks:
        threading.Thread(target=_worker, args=(name, fn), name="LP-" + str(name)[:12], daemon=True).start()
    left = len(tasks)
    while left > 0:
        remaining = deadline - time.time()
        if remaining <= 0:
            break
        try:
            name, value, err = q.get(timeout=min(remaining, 0.5))
        except _queue_mod.Empty:
            continue
        left -= 1
        if err is not None:
            search_log("{}: исключение {}: {}".format(name, type(err).__name__, str(err)[:120]))
            continue
        results[name] = value
        if on_result is not None:
            try:
                if on_result(name, value):
                    break
            except Exception as e:
                search_log("on_result error: {}".format(e))
    return results


_DP_CACHE = [0, 1.0, 0.0]


# dp в пиксели
def dp(context: Any, value: int) -> int:
    try:
        c = _DP_CACHE
        now = time.monotonic()
        cid = id(context)
        if c[0] == cid and now - c[2] < 20.0:
            density = c[1]
        else:
            density = float(context.getResources().getDisplayMetrics().density)
            c[0], c[1], c[2] = cid, density, now
        return int(value * density + 0.5)
    except Exception:
        return value


# загрузка bitmap с ограничением размера
def _decode_bitmap_bounded(path: str, max_dimension: int) -> Optional["Bitmap"]:
    try:
        bounds = BitmapFactory.Options()
        bounds.inJustDecodeBounds = True
        BitmapFactory.decodeFile(path, bounds)
        src_w = int(bounds.outWidth)
        src_h = int(bounds.outHeight)
        if src_w <= 0 or src_h <= 0:
            return None

        sample = 1
        largest_side = max(src_w, src_h)
        while largest_side // (sample * 2) >= max_dimension:
            sample *= 2

        options = BitmapFactory.Options()
        options.inPreferredConfig = Bitmap.Config.ARGB_8888
        options.inSampleSize = sample
        return BitmapFactory.decodeFile(path, options)
    except BaseException as e:
        _log_safe("_decode_bitmap_bounded", e)
        return None


