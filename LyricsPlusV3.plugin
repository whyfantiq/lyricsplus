COPY_BTN_SIZE_DP = 46
PLACEHOLDER_DELAY_SEC = 0.1
PLACEHOLDER_FADE_MS = 300
_no_cover_cache: List[Any] = []


# bitmap-заглушка без обложки
def _no_cover_bitmap() -> Optional["Bitmap"]:
    try:
        if _no_cover_cache and _no_cover_cache[0] is not None:
            return _no_cover_cache[0]
        import base64
        path = os.path.join(Plugin.dir_path(), "no_cover_v2.jpg")
        if not os.path.exists(path) or os.path.getsize(path) < 1000:
            with open(path, "wb") as f:
                f.write(base64.b64decode(_NO_COVER_B64))
        bmp = _decode_bitmap_bounded(path, 512)
        if bmp is not None:
            _no_cover_cache[:] = [bmp]
        return bmp
    except BaseException as e:
        _log_safe("no cover bitmap", e)
        return None


# подготовка bitmap для PIL
def _safe_pil_source(src_path: str, max_dimension: int) -> Optional[str]:
    try:
        if not src_path or not os.path.exists(src_path):
            return None
        cache_dir = os.path.join(Plugin.dir_path(), "cover_cache")
        os.makedirs(cache_dir, exist_ok=True)
        suffix = hashlib.md5(
            "{}|{}".format(src_path, max_dimension).encode("utf-8", "ignore")
        ).hexdigest()[:16]
        out_path = os.path.join(cache_dir, "pil_safe_{}.jpg".format(suffix))

        try:
            if os.path.exists(out_path) and os.path.getmtime(out_path) >= os.path.getmtime(src_path):
                return out_path
        except Exception:
            pass

        bmp = _decode_bitmap_bounded(src_path, max_dimension)
        if bmp is None:
            return None
        fos = FileOutputStream(out_path)
        try:
            bmp.compress(Bitmap.CompressFormat.JPEG, 90, fos)
            fos.flush()
        finally:
            fos.close()
        return out_path
    except BaseException as e:
        _log_safe("_safe_pil_source", e)
        return None


# drawable из иконки
def make_icon_drawable(context: Any, size_dp: int, color: int, draw_fn) -> Optional["BitmapDrawable"]:
    size_px = max(1, dp(context, size_dp))
    for cfg in [Bitmap.Config.ARGB_8888, Bitmap.Config.ARGB_4444, Bitmap.Config.RGB_565]:
        try:
            bmp = Bitmap.createBitmap(size_px, size_px, cfg)
            cv = Canvas(bmp)
            draw_fn(cv, size_px, color)
            d = BitmapDrawable(context.getResources(), bmp)
            d.setBounds(0, 0, size_px, size_px)
            return d
        except BaseException as e:
            _log_safe("make_icon_drawable cfg=" + str(cfg), e)
    return None


# высота статус-бара
def status_bar_height_px(context: Any) -> int:
    try:
        res_id = context.getResources().getIdentifier("status_bar_height", "dimen", "android")
        if res_id > 0:
            return context.getResources().getDimensionPixelSize(res_id)
    except Exception:
        pass
    return dp(context, 24)


# средний цвет обложки
def average_color_from_bitmap(bitmap: Any) -> Optional[int]:
    try:
        if bitmap is None:
            return None
        w = int(bitmap.getWidth())
        h = int(bitmap.getHeight())
        if w <= 0 or h <= 0:
            return None
        steps = 6
        step_x = max(1, w // steps)
        step_y = max(1, h // steps)
        r_total = g_total = b_total = count = 0
        y = 0
        while y < h:
            x = 0
            while x < w:
                pixel = int(bitmap.getPixel(x, y))
                r_total += (pixel >> 16) & 0xFF
                g_total += (pixel >> 8) & 0xFF
                b_total += pixel & 0xFF
                count += 1
                x += step_x
            y += step_y
        if count == 0:
            return None
        return Color.rgb(r_total // count, g_total // count, b_total // count)
    except Exception:
        return None


# затемнение цвета
def darken_color(color: int, factor: float) -> int:
    try:
        r = clamp_int(int(((color >> 16) & 0xFF) * factor), 0, 255)
        g = clamp_int(int(((color >> 8) & 0xFF) * factor), 0, 255)
        b = clamp_int(int((color & 0xFF) * factor), 0, 255)
        return Color.rgb(r, g, b)
    except Exception:
        return int(COLOR_BG)


# безопасный float
def float_safe(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except Exception:
        return default


# ограничение числа диапазоном
def clamp_int(value: int, minimum: int, maximum: int) -> int:
    return max(minimum, min(maximum, int(value)))


_GIL_USERS: set = set()
_GIL_PREV: List[Any] = [None]


# ускорение переключения потоков
def _gil_boost_on(owner: Any) -> None:
    try:
        if not _GIL_USERS:
            _GIL_PREV[0] = sys.getswitchinterval()
            sys.setswitchinterval(0.001)
        _GIL_USERS.add(id(owner))
    except Exception:
        pass


# возврат переключения потоков
def _gil_boost_off(owner: Any) -> None:
    try:
        _GIL_USERS.discard(id(owner))
        if not _GIL_USERS and _GIL_PREV[0] is not None:
            sys.setswitchinterval(_GIL_PREV[0])
            _GIL_PREV[0] = None
    except Exception:
        pass


_SETTING_CACHE: Dict[Tuple, Tuple[float, Any]] = {}
_SETTING_TTL = 0.4


# сброс кэша настроек
def settings_cache_clear() -> None:
    try:
        _SETTING_CACHE.clear()
    except Exception:
        pass


# целая настройка
def setting_int(plugin: Any, key: str, default: int, minimum: int, maximum: int) -> int:
    if not plugin:
        return clamp_int(default, minimum, maximum)
    ck = ("i", key, default, minimum, maximum)
    now = time.monotonic()
    hit = _SETTING_CACHE.get(ck)
    if hit is not None and now - hit[0] < _SETTING_TTL:
        return hit[1]
    try:
        raw = plugin.get_setting(key, str(default))
        val = clamp_int(int(float(str(raw).replace(',', '.').strip())), minimum, maximum)
    except Exception:
        val = clamp_int(default, minimum, maximum)
    _SETTING_CACHE[ck] = (now, val)
    return val


# дробная настройка
def setting_float(plugin: Any, key: str, default: float, minimum: float, maximum: float) -> float:
    if not plugin:
        return max(minimum, min(maximum, float(default)))
    ck = ("f", key, default, minimum, maximum)
    now = time.monotonic()
    hit = _SETTING_CACHE.get(ck)
    if hit is not None and now - hit[0] < _SETTING_TTL:
        return hit[1]
    try:
        raw = plugin.get_setting(key, str(default))
        value = float(str(raw).replace(',', '.').strip())
        val = max(minimum, min(maximum, value))
    except Exception:
        val = max(minimum, min(maximum, float(default)))
    _SETTING_CACHE[ck] = (now, val)
    return val


# логическая настройка
def setting_bool(plugin: Any, key: str, default: bool) -> bool:
    if not plugin:
        return default
    ck = ("b", key, default)
    now = time.monotonic()
    hit = _SETTING_CACHE.get(ck)
    if hit is not None and now - hit[0] < _SETTING_TTL:
        return hit[1]
    try:
        raw = plugin.get_setting(key, default)
        if isinstance(raw, bool):
            val = raw
        else:
            val = str(raw).strip().lower() in ("1", "true", "yes", "да", "on")
    except Exception:
        val = default
    _SETTING_CACHE[ck] = (now, val)
    return val


# серый цвет с альфой
def argb_gray(alpha: int, value: int) -> int:
    return Color.argb(clamp_int(alpha, 0, 255), clamp_int(value, 0, 255), clamp_int(value, 0, 255), clamp_int(value, 0, 255))


# безопасный вывод в лог
def _log_safe(tag: str, e: BaseException) -> None:
    try:
        inst = Plugin.get_instance()
        if inst:
            inst.log(f"[{tag}] " + str(e))
            inst.log(traceback.format_exc())
    except BaseException:
        pass


# обработка свайпов
class SwipeTouchListener(dynamic_proxy(View.OnTouchListener)):

    SWIPE_THRESHOLD_DP = 60
    SWIPE_MAX_VERTICAL_DP = 80
    SWIPE_MIN_VELOCITY_DP_PER_SEC = 120

    def __init__(self, ctx, on_swipe_left, on_swipe_right):
        super().__init__()
        self.ctx = ctx
        self.on_swipe_left = on_swipe_left
        self.on_swipe_right = on_swipe_right
        self._start_x = 0.0
        self._start_y = 0.0
        self._start_t = 0.0
        self._tracking = False

    # определение жеста свайпа
    def onTouch(self, view, event) -> bool:
        try:
            action = event.getAction()
            if action == MotionEvent.ACTION_DOWN:
                self._start_x = event.getRawX()
                self._start_y = event.getRawY()
                self._start_t = time.time()
                self._tracking = True
                return False
            if action == MotionEvent.ACTION_UP and self._tracking:
                self._tracking = False
                dx = event.getRawX() - self._start_x
                dy = event.getRawY() - self._start_y
                dt = max(time.time() - self._start_t, 0.001)

                threshold_px = dp(self.ctx, self.SWIPE_THRESHOLD_DP)
                max_vertical_px = dp(self.ctx, self.SWIPE_MAX_VERTICAL_DP)
                min_velocity_px = dp(self.ctx, self.SWIPE_MIN_VELOCITY_DP_PER_SEC)

                if abs(dy) > max_vertical_px:
                    return False
                if abs(dx) < threshold_px:
                    return False
                velocity = abs(dx) / dt
                if velocity < min_velocity_px:
                    return False

                if dx < 0:
                    self.on_swipe_left(view)
                else:
                    self.on_swipe_right(view)
                return True
            if action == MotionEvent.ACTION_CANCEL:
                self._tracking = False
            return False
        except BaseException as e:
            _log_safe("SwipeTouchListener", e)
            return False


# клик с колбэком
class ViewClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    # вызов колбэка по клику
    def onClick(self, view):
        try:
            self.callback(view)
        except BaseException as e:
            _log_safe("ViewClickListener", e)


# двойной тап по строке
class DoubleTapLineClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, callback, threshold_sec: float = 0.34):
        super().__init__()
        self.callback = callback
        self.threshold_sec = threshold_sec
        self.last_click_at = 0.0

    # определение двойного тапа
    def onClick(self, view):
        try:
            now = time.time()
            if now - self.last_click_at <= self.threshold_sec:
                self.last_click_at = 0.0
                self.callback(view)
            else:
                self.last_click_at = now
        except BaseException as e:
            _log_safe("DoubleTapLineClickListener", e)


# доступ к ресурсам Telegram
class TelegramUtils:
    # id иконки Telegram
    @staticmethod
    def get_icon_id(name: str) -> int:
        context = get_last_fragment().getContext()
        return context.getResources().getIdentifier(name, "drawable", context.getPackageName())

    # id строки локализации
    @staticmethod
    def get_locale_id(name: str) -> int:
        context = get_last_fragment().getContext()
        return context.getResources().getIdentifier(name, "string", context.getPackageName())


_FP_MEMO: Dict[Tuple[str, int, int], str] = {}

COVER_MAX_DIM = 512
COVER_CACHE_MAX_FILES = 400
COVER_CACHE_MAX_AGE_DAYS = 120
COVER_NEGATIVE_TTL_SEC = 24 * 60 * 60
COVER_ONLINE_MIN_SCORE = 0.62
_COVER_TAG_LIMIT = 16 * 1024 * 1024
_cover_prune_done = [False]


# папка кэша обложек
def _cover_dir() -> str:
    d = os.path.join(Plugin.dir_path(), "cover_cache")
    os.makedirs(d, exist_ok=True)
    return d


# хэш для имени файла обложки
def _cover_md5(text: str) -> str:
    return hashlib.md5(text.encode("utf-8", "ignore")).hexdigest()[:20]


# чистка старых обложек
def _prune_cover_cache() -> None:
    if _cover_prune_done[0]:
        return
    _cover_prune_done[0] = True
    try:
        d = _cover_dir()
        now = time.time()
        files = []
        for name in os.listdir(d):
            path = os.path.join(d, name)
            if os.path.isfile(path):
                files.append((os.path.getmtime(path), path))
        files.sort()
        keep = []
        for mtime, path in files:
            if now - mtime > COVER_CACHE_MAX_AGE_DAYS * 24 * 3600:
                os.remove(path)
            else:
                keep.append(path)
        for path in keep[:max(0, len(keep) - COVER_CACHE_MAX_FILES)]:
            os.remove(path)
    except Exception:
        pass


# сохранение bitmap в jpeg
def _save_bitmap_jpeg(bitmap: Any, path: str) -> bool:
    try:
        tmp = path + ".tmp"
        fos = FileOutputStream(tmp)
        try:
            ok = bool(bitmap.compress(Bitmap.CompressFormat.JPEG, 90, fos))
        finally:
            fos.close()
        if ok:
            os.replace(tmp, path)
            return True
    except Exception:
        pass
    return False


# synchsafe-число ID3
def _synchsafe(b: bytes) -> int:
    return ((b[0] & 0x7F) << 21) | ((b[1] & 0x7F) << 14) | ((b[2] & 0x7F) << 7) | (b[3] & 0x7F)


# пропуск строки с терминатором в ID3
def _id3_skip_terminated(data: bytes, pos: int, enc: int) -> int:
    if enc in (1, 2):
        while pos + 1 < len(data):
            if data[pos] == 0 and data[pos + 1] == 0:
                return pos + 2
            pos += 2
        return len(data)
    i = data.find(b"\x00", pos)
    return len(data) if i < 0 else i + 1


# обложка из ID3
def _id3_cover_bytes(f: Any, head: bytes) -> Optional[bytes]:
    ver = head[3]
    if ver not in (2, 3, 4):
        return None
    flags = head[5]
    size = _synchsafe(head[6:10])
    if size <= 0 or size > _COVER_TAG_LIMIT:
        return None
    data = f.read(size)
    if ver < 4 and flags & 0x80:
        data = data.replace(b"\xff\x00", b"\xff")
    pos = 0
    if flags & 0x40 and len(data) >= 4:
        pos = (4 + int.from_bytes(data[:4], "big")) if ver == 3 else _synchsafe(data[:4])
    hdr = 6 if ver == 2 else 10
    found = []
    while pos + hdr <= len(data):
        fid = data[pos:pos + (3 if ver == 2 else 4)]
        if fid[:1] == b"\x00":
            break
        if ver == 2:
            fsize = int.from_bytes(data[pos + 3:pos + 6], "big")
            fflags = 0
        elif ver == 3:
            fsize = int.from_bytes(data[pos + 4:pos + 8], "big")
            fflags = int.from_bytes(data[pos + 8:pos + 10], "big")
        else:
            fsize = _synchsafe(data[pos + 4:pos + 8])
            fflags = int.from_bytes(data[pos + 8:pos + 10], "big")
        body = data[pos + hdr:pos + hdr + fsize]
        pos += hdr + max(fsize, 0)
        if fsize <= 0 or fid not in (b"APIC", b"PIC"):
            continue
        if ver == 4:
            if fflags & 0x000C:
                continue
            if fflags & 0x0001:
                body = body[4:]
            if fflags & 0x0002:
                body = body.replace(b"\xff\x00", b"\xff")
        elif ver == 3 and fflags & 0x00C0:
            continue
        if len(body) < 8:
            continue
        enc = body[0]
        if fid == b"PIC":
            p = 4
        else:
            p = body.find(b"\x00", 1)
            if p < 0:
                continue
            p += 1
        if p >= len(body):
            continue
        ptype = body[p]
        p = _id3_skip_terminated(body, p + 1, enc)
        img = body[p:]
        if len(img) > 16:
            found.append((ptype, img))
    for want in (3, 0):
        for ptype, img in found:
            if ptype == want:
                return img
    return found[0][1] if found else None


# обложка из FLAC
def _flac_cover_bytes(f: Any) -> Optional[bytes]:
    found = []
    for _ in range(64):
        h = f.read(4)
        if len(h) < 4:
            break
        last = h[0] & 0x80
        btype = h[0] & 0x7F
        length = int.from_bytes(h[1:4], "big")
        if btype == 6 and length <= _COVER_TAG_LIMIT:
            blk = f.read(length)
            try:
                ptype = int.from_bytes(blk[0:4], "big")
                mime_len = int.from_bytes(blk[4:8], "big")
                pos = 8 + mime_len
                desc_len = int.from_bytes(blk[pos:pos + 4], "big")
                pos += 4 + desc_len + 16
                img_len = int.from_bytes(blk[pos:pos + 4], "big")
                pos += 4
                img = blk[pos:pos + img_len]
                if len(img) > 16:
                    found.append((ptype, img))
            except Exception:
                pass
        else:
            f.seek(length, 1)
        if last:
            break
    for want in (3, 0):
        for ptype, img in found:
            if ptype == want:
                return img
    return found[0][1] if found else None


# встроенная обложка без системных вызовов
def _embedded_cover_bytes_py(path: str) -> Optional[bytes]:
    try:
        with open(path, "rb") as f:
            head = f.read(10)
            if head[:3] == b"ID3" and len(head) == 10:
                return _id3_cover_bytes(f, head)
            if head[:4] == b"fLaC":
                f.seek(4)
                return _flac_cover_bytes(f)
    except Exception:
        pass
    return None


# встроенная обложка через MediaMetadataRetriever
def _embedded_cover_bitmap_mmr(path: str) -> Optional[Any]:
    r = None
    try:
        from android.media import MediaMetadataRetriever
        r = MediaMetadataRetriever()
        r.setDataSource(path)
        pic = r.getEmbeddedPicture()
        if pic is None or len(pic) == 0:
            return None
        bounds = BitmapFactory.Options()
        bounds.inJustDecodeBounds = True
        BitmapFactory.decodeByteArray(pic, 0, len(pic), bounds)
        sw, sh = int(bounds.outWidth), int(bounds.outHeight)
        if sw <= 0 or sh <= 0:
            return None
        sample = 1
        while max(sw, sh) // (sample * 2) >= COVER_MAX_DIM:
            sample *= 2
        opts = BitmapFactory.Options()
        opts.inPreferredConfig = Bitmap.Config.ARGB_8888
        opts.inSampleSize = sample
        return BitmapFactory.decodeByteArray(pic, 0, len(pic), opts)
    except Exception:
        return None
    finally:
        try:
            if r is not None:
                r.release()
        except Exception:
            pass


# встроенная обложка файла
def _embedded_cover_bitmap(path: str) -> Optional[Any]:
    if not path:
        return None
    raw = _embedded_cover_bytes_py(path)
    if raw:
        tmp = os.path.join(_cover_dir(), "emb_tmp_%s.bin" % _cover_md5(path + str(len(raw))))
        try:
            with open(tmp, "wb") as f:
                f.write(raw)
            bmp = _decode_bitmap_bounded(tmp, COVER_MAX_DIM)
            if bmp is not None:
                return bmp
        except Exception:
            pass
        finally:
            try:
                os.remove(tmp)
            except Exception:
                pass
    return _embedded_cover_bitmap_mmr(path)


# оценка подходящей обложки
def _cover_score(title: str, artist: str, cand_title: str, cand_artist: str) -> float:
    nt, na = normalize_key(title), normalize_key(artist)
    ct, ca = normalize_key(cand_title), normalize_key(cand_artist)
    ts = ngram_similarity(nt, ct) if nt and ct else 0.5
    if nt and ct and (nt in ct or ct in nt):
        ts = max(ts, 0.85)
    as_ = ngram_similarity(na, ca) if na and ca else 0.5
    if na and ca and (na in ca or ca in na):
        as_ = max(as_, 0.9)
    return ts * 0.6 + as_ * 0.4


# кандидаты обложек iTunes
def _cover_candidates_itunes(term: str) -> Optional[List[Tuple[str, str, str]]]:
    r = requests.get("https://itunes.apple.com/search",
                     params={"term": term, "media": "music", "entity": "song", "limit": 8}, timeout=4.0)
    if r.status_code != 200:
        return None
    out = []
    for it in (r.json().get("results") or []):
        url = safe_str(it.get("artworkUrl100")).replace("100x100bb", "600x600bb")
        if url:
            out.append((safe_str(it.get("trackName")), safe_str(it.get("artistName")), url))
    return out


# кандидаты обложек Deezer
def _cover_candidates_deezer(title: str, artist: str) -> Optional[List[Tuple[str, str, str]]]:
    if artist and title:
        q = 'artist:"{}" track:"{}"'.format(artist.replace('"', " "), title.replace('"', " "))
    else:
        q = title or artist
    r = requests.get("https://api.deezer.com/search", params={"q": q, "limit": 8}, timeout=4.0)
    if r.status_code != 200:
        return None
    out = []
    for it in (r.json().get("data") or []):
        album = it.get("album") or {}
        url = safe_str(album.get("cover_xl") or album.get("cover_big") or album.get("cover_medium"))
        if url:
            out.append((safe_str(it.get("title")), safe_str((it.get("artist") or {}).get("name")), url))
    return out


# загрузка обложки из сети
def _fetch_cover_online_path(title: str, artist: str) -> Optional[str]:
    query = "{} {}".format(artist, title).strip()
    if not query:
        return None
    d = _cover_dir()
    path = os.path.join(d, "cover_online_{}.jpg".format(hashlib.md5(query.encode("utf-8", "ignore")).hexdigest()[:16]))
    if os.path.exists(path) and os.path.getsize(path) > 0:
        return path
    neg = path + ".none"
    try:
        if os.path.exists(neg) and time.time() - os.path.getmtime(neg) < COVER_NEGATIVE_TTL_SEC:
            return None
    except Exception:
        pass

    clean_title = re.sub(r"[\(\[][^)\]]*[\)\]]", " ", title or "")
    clean_title = re.sub(r"\s+", " ", clean_title).strip() or (title or "")
    term = "{} {}".format(artist, clean_title).strip()
    holder: Dict[str, Any] = {"itunes": None, "deezer": None}

    def _run(name, fn):
        try:
            holder[name] = fn()
        except Exception:
            holder[name] = None

    threads = [
        threading.Thread(target=_run, args=("itunes", lambda: _cover_candidates_itunes(term)), daemon=True),
        threading.Thread(target=_run, args=("deezer", lambda: _cover_candidates_deezer(clean_title, artist)), daemon=True),
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=6.0)

    responded = holder["itunes"] is not None or holder["deezer"] is not None
    best_url, best_score = None, 0.0
    for name in ("itunes", "deezer"):
        for c_title, c_artist, url in (holder[name] or []):
            sc = _cover_score(clean_title, artist, c_title, c_artist)
            if sc > best_score + 1e-6:
                best_score, best_url = sc, url
    if best_url and best_score >= COVER_ONLINE_MIN_SCORE:
        try:
            img = requests.get(best_url, timeout=6.0)
            if img.status_code == 200 and len(img.content) > 1000:
                with open(path, "wb") as f:
                    f.write(img.content)
                return path
        except Exception:
            pass
        return None
    if responded:
        try:
            with open(neg, "w") as f:
                f.write("1")
        except Exception:
            pass
    return None


# ссылка на обложку из Telegram
def _artwork_url_path(msg: Any) -> Optional[str]:
    try:
        url = safe_str(call_any(msg, ["getArtworkUrl"], "", [(True,), (False,)]))
        if not url:
            return None
        if url.startswith("http"):
            path = os.path.join(_cover_dir(), "cover_url_{}.jpg".format(_cover_md5(url)))
            if os.path.exists(path) and os.path.getsize(path) > 0:
                return path
            img = requests.get(url, timeout=5.0)
            if img.status_code == 200 and len(img.content) > 1000:
                with open(path, "wb") as f:
                    f.write(img.content)
                return path
            return None
        if os.path.isfile(url):
            return url
    except Exception:
        pass
    return None


# путь к файлу трека
def _track_local_path(msg: Any) -> str:
    if msg is None:
        return ""
    try:
        owner = java_field(msg, "messageOwner")
        p = safe_str(java_field(owner, "attachPath", ""))
        if p and os.path.isfile(p):
            return p
    except Exception:
        pass
    try:
        account = int(java_field(msg, "currentAccount", 0) or 0)
        loader_cls = FileLoader if IMAGE_LOADER_AVAILABLE else jclass("org.telegram.messenger.FileLoader")
        loader = loader_cls.getInstance(account)
        f = call_any(loader, ["getPathToMessage"], None, [(java_field(msg, "messageOwner"),)])
        if f is None:
            doc = call_any(msg, ["getDocument"], None, [tuple()])
            f = call_any(loader, ["getPathToAttach"], None, [(doc, True), (doc,)])
        if f is not None and bool(call_any(f, ["exists"], False, [tuple()])):
            return safe_str(call_any(f, ["getAbsolutePath"], ""))
    except Exception:
        pass
    return ""


# отпечаток файла
def _file_fingerprint(path: str) -> str:
    try:
        st = os.stat(path)
        size = int(st.st_size)
        if size <= 0:
            return ""
        memo_key = (path, size, int(st.st_mtime))
        hit = _FP_MEMO.get(memo_key)
        if hit:
            return hit
        h = hashlib.sha1()
        h.update(("size:%d|" % size).encode("ascii"))
        chunk = FINGERPRINT_CHUNK_BYTES
        with open(path, "rb") as f:
            if size <= chunk * 3:
                h.update(f.read())
            else:
                for off in (0, max(0, size // 2 - chunk // 2), size - chunk):
                    f.seek(off)
                    h.update(f.read(chunk))
        fp = "f:" + h.hexdigest()[:32]
        if len(_FP_MEMO) > 64:
            _FP_MEMO.clear()
        _FP_MEMO[memo_key] = fp
        return fp
    except Exception:
        return ""


_JUNK_ARTISTS = {
    "unknown", "unknown artist", "unknownartist", "various artists", "various", "va", "n a", "none",
    "неизвестен", "неизвестный исполнитель", "неизвестный артист", "неизвестно", "artist", "audio", "track",
    "no artist", "null", "undefined",
}
_TITLE_SPLIT_RE = re.compile(r"\s+[-–—]\s+")


# служебное имя артиста
def _is_junk_artist(value: str) -> bool:
    n = normalize_key(value)
    return (not n) or n in _JUNK_ARTISTS


# данные текущего трека
class TrackInfo:
    def __init__(self, title: str, artist: str, duration: float, query_fallback: str = "", source_msg: Any = None):
        raw_title = safe_str(title)
        raw_artist = "" if _is_junk_artist(artist) else safe_str(artist)
        credits = _extract_credits(raw_title)
        clean_title = _clean_display_title(raw_title)
        parts = _TITLE_SPLIT_RE.split(clean_title, maxsplit=1)
        if len(parts) == 2 and parts[0].strip() and parts[1].strip() and len(parts[0]) <= 60:
            left, right = parts[0].strip(), parts[1].strip()
            if not raw_artist:
                raw_artist, clean_title = left, _clean_display_title(right)
            else:
                ln = normalize_key(left)
                if ln and (ln == normalize_key(raw_artist) or artist_similarity(left, raw_artist) >= 0.85):
                    clean_title = _clean_display_title(right)
        self.raw_title = raw_title
        self.title = clean_title
        artist_parts = _split_artists_raw(raw_artist) if raw_artist else []
        merged: List[str] = []
        seen = set()
        for item in artist_parts + credits:
            key = _canonical_artist_token(item)
            if key and key not in seen:
                seen.add(key)
                merged.append(safe_str(_ID_SUFFIX_RE.sub("", item)).strip())
        _g = _glued_artist_split(clean_title)
        if _g:
            _gk = _canonical_artist_token(_g[0])
            if _gk and _gk not in seen:
                seen.add(_gk)
                merged.append(_g[0])
        self.artist_list = merged
        self.artist = ", ".join(merged)
        self.duration = duration
        self.query_fallback = query_fallback
        self.source_msg = source_msg
        self._fps: Optional[List[str]] = None
        self._target: Optional[MatchTarget] = None
        self._deadline: float = 0.0

    # основной артист трека
    @property
    def primary_artist(self) -> str:
        if not self.artist_list:
            return ""
        return qclean(self.artist_list[0]) or self.artist_list[0]

    # артисты для запроса
    @property
    def query_artists(self) -> List[str]:
        out: List[str] = []
        for a in self.artist_list:
            c = qclean(a)
            if c and c not in out:
                out.append(c)
        return out

    # цель для сравнения
    @property
    def match_target(self) -> "MatchTarget":
        if self._target is None:
            self._target = MatchTarget(self.title or self.query_fallback, self.artist, self.duration,
                                       raw_title=self.raw_title)
        return self._target

    # отпечатки трека для кэша
    @property
    def fingerprints(self) -> List[str]:
        if self._fps is None:
            fps: List[str] = []
            try:
                path = _track_local_path(self.source_msg)
                if path:
                    fp = _file_fingerprint(path)
                    if fp:
                        fps.append(fp)
            except Exception:
                pass
            try:
                doc = call_any(self.source_msg, ["getDocument"], None, [tuple()])
                did = java_field(doc, "id", 0)
                if doc is not None and did:
                    fps.append("d:%s" % did)
            except Exception:
                pass
            self._fps = fps
        return self._fps

    # версии трека
    @property
    def versions(self) -> frozenset:
        v = self.__dict__.get("_versions_memo")
        if v is None:
            v = extract_versions(self.raw_title)
            self.__dict__["_versions_memo"] = v
        return v

    # итоговый ключ кэша
    @property
    def final_key(self) -> str:
        return "final_v6|" + self.cache_key

    # ключ кэша неудач
    @property
    def negative_key(self) -> str:
        return "neg_v6|" + self.cache_key


    # артист для показа
    @property
    def display_artist(self) -> str:
        return self.artist or "Неизвестный артист"

    # строка поискового запроса
    @property
    def query(self) -> str:
        if self.artist and self.title:
            return f"{self.artist} {self.title}"
        if self.title:
            return self.title
        return self.query_fallback

    # ключ кэша
    @property
    def cache_key(self) -> str:
        ck = self.__dict__.get("_cache_key_memo")
        if ck is None:
            ck = self._cache_key_compute()
            self.__dict__["_cache_key_memo"] = ck
        return ck

    # расчет ключа кэша
    def _cache_key_compute(self) -> str:
        base = normalize_key("lrclib", "gapnotes_v4", self.primary_artist, self.title, self.query_fallback)
        ver = ".".join(sorted(self.versions))
        if ver:
            base += " v " + ver
        if not self.primary_artist and self.duration and self.duration > 0:
            base += " d%d" % int(round(float(self.duration) / 15.0))
        return base


# пересчет таймингов под скорость
def _retime_lines(lines: List[Dict[str, Any]], ratio: float) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for l in lines or []:
        if not isinstance(l, dict):
            out.append(l)
            continue
        d = dict(l)
        for k in ("time", "end", "end_time", "start"):
            if isinstance(d.get(k), (int, float)):
                d[k] = float(d[k]) * ratio
        if isinstance(d.get("words"), list):
            nw = []
            for w in d["words"]:
                if isinstance(w, dict):
                    w = dict(w)
                    for k in ("time", "end", "start"):
                        if isinstance(w.get(k), (int, float)):
                            w[k] = float(w[k]) * ratio
                nw.append(w)
            d["words"] = nw
        out.append(d)
    return out


# результат поиска текста
class LyricsResult:
    def __init__(
        self,
        lines: List[Dict[str, Any]],
        synced: bool,
        source: str = "LRCLIB",
        source_url: Optional[str] = None,
        matched_title: str = "",
        matched_artist: str = "",
        matched_duration: float = 0.0,
        versions: Optional[List[str]] = None,
        verified: bool = True,
        score: float = 0.0,
    ):
        self.matched_duration = float(matched_duration or 0.0)
        self.versions = list(versions or [])
        self.verified = bool(verified)
        self.score = float(score or 0.0)
        self.lines = lines
        self.synced = synced
        self.source = source
        self.source_url = source_url
        self.matched_title = matched_title
        self.matched_artist = matched_artist

    # в формат кэша
    def to_cache(self) -> Dict[str, Any]:
        return {
            "lines": self.lines,
            "synced": self.synced,
            "source": self.source,
            "source_url": self.source_url,
            "matched_title": self.matched_title,
            "matched_artist": self.matched_artist,
            "matched_duration": self.matched_duration,
            "versions": list(self.versions),
            "verified": self.verified,
            "score": self.score,
            "saved_at": int(time.time()),
        }

    # из формата кэша
    @classmethod
    def from_cache(cls, item: Dict[str, Any]) -> Optional["LyricsResult"]:
        try:
            lines = item.get("lines") or []
            if not lines:
                return None
            return cls(
                lines=lines,
                synced=bool(item.get("synced", False)),
                source=safe_str(item.get("source"), "LRCLIB"),
                source_url=item.get("source_url"),
                matched_title=safe_str(item.get("matched_title")),
                matched_artist=safe_str(item.get("matched_artist")),
                matched_duration=float_safe(item.get("matched_duration"), 0.0),
                versions=list(item.get("versions") or []),
                verified=bool(item.get("verified", True)),
                score=float_safe(item.get("score"), 0.0),
            )
        except Exception:
            return None


# штраф за неправдоподобные тайминги
def _sync_sanity_penalty(lines: List[Dict[str, Any]], duration: float) -> float:
    if not lines or not duration or duration <= 0:
        return 0.0
    times = []
    for l in lines:
        if not isinstance(l, dict) or l.get("pause") or l.get("time") is None:
            continue
        times.append(float_safe(l.get("time"), -1.0))
    times = [x for x in times if x >= 0]
    if len(times) < 3:
        return 0.0
    if max(times) > duration + 8.0:
        return 0.30
    if min(times) > duration * 0.6:
        return 0.30
    return 0.0


# уверенность в результате
def result_confidence(track: "TrackInfo", result: Optional["LyricsResult"]) -> float:
    if result is None or not result.lines:
        return -1.0
    info = score_candidate(track.match_target, safe_str(result.matched_title), safe_str(result.matched_artist),
                           float_safe(result.matched_duration, 0.0), synced=bool(result.synced),
                           plain=not result.synced, cand_versions=frozenset(result.versions or ()))
    conf = info["score"]
    if info["reject"]:
        conf = min(conf, 0.45)
    if result.synced:
        conf -= _sync_sanity_penalty(result.lines, track.duration)
    if not result.verified:
        conf = min(conf, 0.70)
    return max(0.0, conf)


_WORD3_RE = re.compile(r"\w{3,}", re.UNICODE)


# слова текста
def _text_words(result: "LyricsResult") -> set:
    sig = getattr(result, "_sig", None)
    if sig is None:
        sig = set()
        for l in (result.lines or [])[:150]:
            if isinstance(l, dict):
                sig.update(_WORD3_RE.findall(_fold(safe_str(l.get("text")))))
        try:
            result._sig = sig
        except Exception:
            pass
    return sig


# совпадают ли два текста
def lyrics_agree(a: "LyricsResult", b: "LyricsResult") -> bool:
    wa, wb = _text_words(a), _text_words(b)
    if len(wa) < 15 or len(wb) < 15:
        return False
    return len(wa & wb) / float(min(len(wa), len(wb))) >= 0.55


# провайдер LiriQo
class LiriQoLyricsProvider:

    def __init__(self, plugin: "Plugin"):
        self.plugin = plugin

    LONG_LINE_CHARS = 64

    # разбиение длинных строк
    def _split_long_lines(self, lines: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        out: List[Dict[str, Any]] = []
        for line in lines:
            text = safe_str(line.get("text"))
            words = line.get("words")
            if len(text) <= self.LONG_LINE_CHARS or not isinstance(words, list) or len(words) < 4:
                out.append(line)
                continue
            wtexts = [safe_str(w.get("text")) for w in words]
            joiner = "" if "".join(wtexts).strip() == text.strip() else " "
            total = sum(len(t) for t in wtexts)
            acc, cut, best = 0, None, None
            for i in range(len(words) - 1):
                acc += len(wtexts[i])
                d = abs(acc - total / 2.0)
                if best is None or d < best:
                    best, cut = d, i + 1
            if not cut:
                out.append(line)
                continue
            t1 = joiner.join(wtexts[:cut]).strip()
            t2 = joiner.join(wtexts[cut:]).strip()
            start1 = float_safe(line.get("time"), 0.0)
            start2 = float_safe(words[cut].get("start"), 0.0)
            if not t1 or not t2 or start2 <= start1 + 0.05:
                out.append(line)
                continue
            first = dict(line)
            first["text"], first["words"] = t1, words[:cut]
            second = dict(line)
            second["text"], second["words"], second["time"] = t2, words[cut:], start2
            out.append(first)
            out.append(second)
        return out

    # ноты в паузах и вступлении
    def _add_gap_markers(self, lines: List[Dict[str, Any]], duration: float = 0.0) -> List[Dict[str, Any]]:
        if not lines:
            return lines
        threshold = float(MUSIC_GAP_THRESHOLD_SEC)
        out: List[Dict[str, Any]] = []
        if float_safe(lines[0].get("time"), 0.0) >= threshold:
            out.append({"time": 0.0, "text": MUSIC_GAP_MARKER, "pause": True})
        for i, line in enumerate(lines):
            out.append(line)
            start = float_safe(line.get("time"), 0.0)
            if i + 1 < len(lines):
                nxt = float_safe(lines[i + 1].get("time"), 0.0)
            else:
                continue
            if nxt <= start:
                continue
            end = None
            words = line.get("words")
            if isinstance(words, list) and words:
                ends = [float_safe(w.get("end"), 0.0) for w in words if isinstance(w, dict)]
                e = max(ends) if ends else 0.0
                if e > start:
                    end = e
            if end is None:
                text = safe_str(line.get("text"))
                est = len(text) / float(ESTIMATED_CHARS_PER_SEC) if text else float(ESTIMATED_MIN_LINE_DURATION_SEC)
                est = max(float(ESTIMATED_MIN_LINE_DURATION_SEC), min(float(ESTIMATED_MAX_LINE_DURATION_SEC), est))
                end = start + est
            end = max(start, min(nxt, end))
            if nxt - end >= threshold:
                out.append({"time": end, "text": MUSIC_GAP_MARKER, "pause": True})
        out.sort(key=lambda item: float_safe(item.get("time"), 0.0))
        return out

    # запрос к API
    def _request(self, title: str, artist: str, duration: float, deadline: float) -> Tuple[Optional[Dict[str, Any]], int]:
        params: Dict[str, Any] = {"title": title, "artist": artist, "full": "1"}
        if duration and duration > 0:
            params["duration"] = int(round(duration))
        headers = {"Accept": "application/json", "User-Agent": LIRIQO_USER_AGENT}
        search_log("LiriQo: запрос title='{}', artist='{}', duration={}s".format(
            title, artist, params.get("duration", 0)))
        data, code = http_get_json(LIRIQO_URL, params, headers, timeout=(2.0, 6.5), deadline=deadline, tag="LiriQo",
                                   retry_timeout=False)
        if not isinstance(data, dict) or data.get("error"):
            if data is not None:
                search_log("LiriQo: ошибка API: " + safe_str(data.get("error") if isinstance(data, dict) else "invalid"))
            return None, code
        return data, code

    # запрос с одним повтором
    def _request_retry(self, title: str, artist: str, duration: float, deadline: float) -> Optional[Dict[str, Any]]:
        for _attempt in range(2):
            data, code = self._request(title, artist, duration, deadline)
            if data is not None:
                return data
            if code not in (0, 502, 503, 504, -3):
                return None
            if deadline and deadline - time.time() < 2.0:
                return None
        return None

    # пары название и артист для попыток
    def _attempt_pairs(self, track: TrackInfo, rescue: bool) -> List[Tuple[str, str]]:
        title = qclean(track.title or track.query_fallback)
        full = ", ".join(track.query_artists[:3])
        prim = track.primary_artist
        tried = getattr(track, "_liriqo_tried", None)
        if tried is None:
            tried = set()
            try:
                track._liriqo_tried = tried
            except Exception:
                pass
        pairs: List[Tuple[str, str]] = []

        def _add(t: str, a: str):
            t, a = qclean(t), qclean(a)
            key = (normalize_key(t), normalize_key(a))
            if t and key[0] and key not in tried:
                tried.add(key)
                pairs.append((t, a))

        if not rescue:
            _add(title, full)
            if prim and prim != full:
                _add(title, prim)
        else:
            for tv in build_title_variants(title)[:5]:
                _add(tv, prim or full)
                _add(tv, "")
            for extra in track.query_artists[1:3]:
                _add(title, extra)
        return pairs

    # качество результата
    @staticmethod
    def _quality(res: "LyricsResult"):
        return (bool(res.verified), round(float(res.score or 0.0) / 0.05), _has_word_sync(res), len(res.lines or []))

    # получение текста
    def get_lyrics(self, track: TrackInfo, rescue: bool = False) -> Optional[LyricsResult]:
        if not track.query:
            return None
        deadline = track._deadline or (time.time() + NETWORK_TOTAL_TIMEOUT_SEC)
        pairs = self._attempt_pairs(track, rescue)
        if not pairs:
            return None
        pairs = pairs[:(4 if rescue else 2)]
        best: List[Optional[LyricsResult]] = [None]

        def _on_result(_name: str, data: Any) -> bool:
            if not isinstance(data, dict) or not (data.get("primary") or data.get("tracks")):
                if isinstance(data, dict):
                    search_log("LiriQo: ответ без результатов (ключи: {})".format(",".join(list(data.keys())[:6])))
                return False
            res = self._data_to_result(track, data)
            if res is None:
                return False
            if rescue and not res.verified:
                return False
            if best[0] is None or self._quality(res) > self._quality(best[0]):
                best[0] = res
            return bool(res.verified and res.score >= 0.95)

        tasks = [("lq%d" % i, (lambda t=t, a=a: self._request_retry(t, a, track.duration, deadline)))
                 for i, (t, a) in enumerate(pairs)]
        run_parallel(tasks, deadline, _on_result)
        return best[0]

    # имена для запроса
    @staticmethod
    def _names(value: Any) -> str:
        if isinstance(value, (list, tuple)):
            return ", ".join(safe_str(x.get("name") if isinstance(x, dict) else x) for x in value if x)
        if isinstance(value, dict):
            return safe_str(value.get("name"))
        return safe_str(value)

    # метаданные найденного элемента
    def _item_meta(self, item: Dict[str, Any]) -> Tuple[str, str, float]:
        sub = item.get("metadata") if isinstance(item.get("metadata"), dict) else {}
        title = safe_str(item.get("title") or item.get("trackName") or item.get("name")
                         or sub.get("title") or sub.get("trackName"))
        artist = self._names(item.get("artist") or item.get("artistName") or item.get("artists")
                             or sub.get("artist") or sub.get("artistName"))
        dur = 0.0
        for key in ("duration", "durationMs", "duration_ms", "length"):
            dur = _norm_duration(item.get(key) if item.get(key) is not None else sub.get(key))
            if dur > 0:
                break
        return title, artist, dur

    # ответ API в результат
    def _data_to_result(self, track: TrackInfo, data: Dict[str, Any]) -> Optional[LyricsResult]:
        candidates = []
        primary = data.get("primary")
        if isinstance(primary, dict):
            candidates.append(primary)
        for item in data.get("tracks") or []:
            if isinstance(item, dict) and item not in candidates:
                candidates.append(item)
        self.plugin.log("LiriQo: candidates={}, count={}, partial={}".format(
            len(candidates), data.get("count", "?"), data.get("partial", "?")))
        if not candidates:
            search_log("LiriQo: API вернул пустой список кандидатов")
            return None

        top_meta = data.get("metadata") if isinstance(data.get("metadata"), dict) else {}
        top_title = safe_str(top_meta.get("title"))
        top_artist = self._names(top_meta.get("artist"))
        echo = bool(top_title) and normalize_key(top_title) == normalize_key(track.title or track.query_fallback) and (
            not top_artist or artist_similarity(top_artist, track.artist) >= 0.95)

        sync_rank = {"syllable": 5, "word": 5, "character": 5, "line": 3, "plain": 1}
        verified_pool: List[Tuple[Tuple, Dict[str, Any], Dict[str, Any], str, str, float]] = []
        unverified_pool: List[Tuple[Tuple, Dict[str, Any], str, str, float]] = []
        for item in candidates:
            title, artist, dur = self._item_meta(item)
            level = safe_str(item.get("syncLevel"), "plain").lower()
            timed = item.get("timed") or []
            srank = sync_rank.get(level, 0) + (2 if timed else 0) + (1 if item.get("nativeWordTiming") else 0)
            if not title and top_title and not echo:
                title, artist = top_title, artist or top_artist
            if title:
                info = score_candidate(track.match_target, title, artist, dur, synced=True,
                                       instrumental=bool(item.get("instrumental")))
                if info["reject"] or info["score"] < ACCEPT_SCORE:
                    search_log("LiriQo: кандидат '{}' - '{}' отклонен (score={:.2f}, {})".format(
                        title, artist, info["score"], info["reason"] or "low"))
                    continue
                verified_pool.append(((round(info["score"] / 0.05), srank, item is primary), item, info,
                                      title, artist, dur))
            else:
                unverified_pool.append(((srank, item is primary), item, "", "", dur))

        chosen = None
        if verified_pool:
            verified_pool.sort(key=lambda r: r[0], reverse=True)
            _k, best, info, c_title, c_artist, c_dur = verified_pool[0]
            verified, score = True, info["score"]
        elif unverified_pool:
            unverified_pool.sort(key=lambda r: r[0], reverse=True)
            _k, best, c_title, c_artist, c_dur = unverified_pool[0]
            verified, score = False, 0.0
            c_title, c_artist = track.title or track.query_fallback, track.artist
        else:
            return None

        timed = best.get("timed") or []
        lines: List[Dict[str, Any]] = []
        words_map = best.get("words") if isinstance(best.get("words"), dict) else None
        for entry in timed:
            if not isinstance(entry, dict):
                continue
            text = safe_str(entry.get("text"))
            words = entry.get("words") or []
            if not words and words_map is not None:
                words = words_map.get(str(entry.get("id")), words_map.get(entry.get("id"), [])) or []
            if not text and isinstance(words, list):
                text = "".join(safe_str(w.get("text")) for w in words if isinstance(w, dict)).strip()
            start_ms = float_safe(entry.get("start"), 0.0)
            if not text:
                continue
            line: Dict[str, Any] = {"time": max(0.0, start_ms / 1000.0), "text": text}
            if _entry_backing_flag(entry):
                line["backing"] = True
            if isinstance(words, list) and words:
                parsed_words = []
                for word in words:
                    if not isinstance(word, dict):
                        continue
                    wtext = safe_str(word.get("text"))
                    if not wtext:
                        continue
                    parsed_words.append({
                        "text": wtext,
                        "start": float_safe(word.get("start"), 0.0) / 1000.0,
                        "end": float_safe(word.get("end"), 0.0) / 1000.0,
                    })
                if parsed_words:
                    line["words"] = parsed_words
                    line["sync_level"] = safe_str(entry.get("granularity"), safe_str(best.get("syncLevel")))
            lines.append(line)
        lines.sort(key=lambda item: float_safe(item.get("time"), 0.0))
        if not lines:
            return None
        if not verified and _sync_sanity_penalty(lines, track.duration) > 0:
            search_log("LiriQo: неподтвержденный результат не помещается в трек -- отброшен")
            return None

        try:
            lines = self._split_long_lines(lines)
            lines = self._add_gap_markers(lines, float_safe(getattr(track, "duration", 0.0), 0.0))
        except Exception as _e:
            self.plugin.log("LiriQo: post-process failed: " + safe_str(_e))

        provider_name = safe_str(best.get("upstreamProvider") or best.get("provider"), "LiriQo")
        sync_level = safe_str(best.get("syncLevel"), "line").lower()
        result = LyricsResult(
            lines=lines, synced=True,
            source="LiriQo / " + provider_name + " (" + sync_level + ")",
            source_url="https://github.com/AlFarrizi-Studio/LiriQo",
            matched_title=c_title, matched_artist=c_artist, matched_duration=c_dur,
            versions=sorted(extract_versions(c_title) | ({"instrumental"} if best.get("instrumental") else set())),
            verified=verified, score=score,
        )
        try:
            result.relaxed = bool(verified and info.get("relaxed"))
        except Exception:
            result.relaxed = False
        self.plugin.log("LiriQo: {} lines, sync={}, provider={}, verified={}".format(
            len(lines), sync_level, provider_name, verified))
        search_log("LiriQo: найдено {} строк; sync={}; provider={}; verified={}; track='{}' - '{}'".format(
            len(lines), sync_level, provider_name, verified, c_title, c_artist))
        return result


# провайдер LRCLIB
class LrclibLyricsProvider:
    def __init__(self, plugin: "Plugin"):
        self.plugin = plugin
        self._last_search_had_zero_candidates = False

    # получение текста
    def get_lyrics(self, track: TrackInfo) -> LyricsResult:
        cached = self.plugin.cache_get(track.cache_key)
        if cached:
            result = LyricsResult.from_cache(cached)
            if result and result.synced and result_confidence(track, result) >= 0.80:
                search_log("=== Трек: '{}' - '{}' (длительность {:.0f}с) | результат взят из КЭША -> '{}' - '{}' ===".format(
                    safe_str(track.title), safe_str(track.artist), track.duration,
                    result.matched_title, result.matched_artist))
                return result

        if not track.query:
            raise Exception("Не удалось определить название трека")

        self._last_search_had_zero_candidates = False
        deadline = track._deadline or (time.time() + NETWORK_TOTAL_TIMEOUT_SEC)
        data = self._find_parallel(track, deadline)
        if not data:
            raise Exception("LRCLIB не нашел подходящий текст")
        result = self._record_to_result(data, track)
        if result.synced:
            self.plugin.cache_put(track.cache_key, result.to_cache())
        return result

    # заголовки запроса
    def _headers(self) -> Dict[str, str]:
        return {"User-Agent": LRCLIB_USER_AGENT, "Accept": "application/json"}

    # оценка найденной записи
    def _score_item(self, track: TrackInfo, item: Dict[str, Any], ambiguous: bool = False) -> Dict[str, Any]:
        return score_candidate(track.match_target, safe_str(item.get("trackName")), safe_str(item.get("artistName")),
                               float_safe(item.get("duration"), 0.0), synced=bool(item.get("syncedLyrics")),
                               plain=bool(item.get("plainLyrics")), ambiguous=ambiguous,
                               artist_only_query=bool(item.get("_artist_only_query")),
                               instrumental=bool(item.get("instrumental")))


    # параллельный поиск записи
    def _find_parallel(self, track: TrackInfo, deadline: float) -> Optional[Dict[str, Any]]:
        variants = build_query_variants(track.title, track.artist)
        if not variants:
            return self._find_untitled(track, deadline)
        v0 = variants[0]
        tasks: List[Tuple[str, Any]] = []
        if v0["title"] and v0["artist"]:
            tasks.append(("get:primary", lambda: self._get_exact(track, v0["title"], v0["artist"], deadline)))
            tasks.append(("cached:primary", lambda: self._get_exact(track, v0["title"], v0["artist"], deadline,
                                                                    cached=True)))
            v_full = next((v for v in variants[1:] if v["artist"] and v["artist"] != v0["artist"]
                           and normalize_key(v["title"]) == normalize_key(v0["title"])), None)
            if v_full:
                tasks.append(("get:full", lambda: self._get_exact(track, v_full["title"], v_full["artist"], deadline)))
            tasks.append(("search:structured", lambda: self._search(
                {"track_name": v0["title"], "artist_name": v0["artist"]}, deadline)))
            tasks.append(("search:q", lambda: self._search(
                {"q": "{} {}".format(v0["artist"], v0["title"])}, deadline)))
        else:
            tasks.append(("search:q", lambda: self._search({"q": v0["title"] or track.query}, deadline)))

        candidates: List[Dict[str, Any]] = []
        exact_hit: List[Dict[str, Any]] = []
        zero = {"count": 0}

        def _on_result(name: str, value: Any) -> bool:
            if name.startswith("get:") or name.startswith("cached:"):
                if isinstance(value, dict):
                    info = self._score_item(track, value)
                    if not info["reject"] and info["score"] >= 0.90 and info["title_sim"] >= 0.97:
                        search_log("=== Трек: '{}' - '{}' | НАЙДЕНО ТОЧНЫМ запросом ({}) -> '{}' - '{}' ===".format(
                            safe_str(track.title), safe_str(track.artist), name,
                            safe_str(value.get("trackName")), safe_str(value.get("artistName"))))
                        exact_hit.append(value)
                        return True
                    candidates.append(value)
                return False
            if isinstance(value, list):
                zero["count"] += len(value)
                candidates.extend(x for x in value if isinstance(x, dict))
                picked, info = self._rank(track, candidates)
                if picked is not None and info and info["score"] >= 0.95 and info["title_sim"] >= 0.98 and info["exact"]:
                    exact_hit.append(picked)
                    return True
            return False

        run_parallel(tasks, deadline, _on_result)
        if exact_hit:
            return exact_hit[0]
        picked = self._choose_best_candidate(track, candidates)
        if picked:
            return picked

        if time.time() < deadline - 0.5:
            wave2: List[Tuple[str, Any]] = []
            seen_q = {normalize_key("{} {}".format(v0["artist"], v0["title"]))}
            for i, v in enumerate(variants[1:5], start=1):
                q = "{} {}".format(v["artist"], v["title"]).strip()
                key = normalize_key(q)
                if key and key not in seen_q:
                    seen_q.add(key)
                    wave2.append(("search:v%d" % i, lambda q=q: self._search({"q": q}, deadline)))
            if v0["title"]:
                wave2.append(("search:title", lambda: self._search({"track_name": v0["title"]}, deadline)))
            if wave2:
                res = run_parallel(wave2, deadline)
                for value in res.values():
                    if isinstance(value, list):
                        zero["count"] += len(value)
                        candidates.extend(x for x in value if isinstance(x, dict))
                picked = self._choose_best_candidate(track, candidates)
                if picked:
                    return picked
        self._last_search_had_zero_candidates = zero["count"] == 0
        return None

    # поиск таймкодов другими способами
    def rescue(self, track: TrackInfo, deadline: float) -> Optional[LyricsResult]:
        titles = build_title_variants(track.title or track.query_fallback)
        if not titles:
            return None
        arts: List[str] = list(track.query_artists[:3])
        tasks: List[Tuple[str, Any]] = []
        for i, tv in enumerate(titles[:4]):
            tasks.append(("r:t%d" % i, lambda tv=tv: self._search({"track_name": tv}, deadline)))
            if arts:
                tasks.append(("r:q%d" % i, lambda tv=tv: self._search({"q": "{} {}".format(arts[0], tv)}, deadline)))
                if i > 0:
                    tasks.append(("get:r%d" % i, lambda tv=tv: self._get_exact(track, tv, arts[0], deadline)))
            if len(arts) > 1 and i == 0:
                tasks.append(("r:q%da" % i, lambda tv=tv: self._search({"q": "{} {}".format(arts[1], tv)}, deadline)))
        candidates: List[Dict[str, Any]] = []
        res = run_parallel(tasks, deadline)
        for value in res.values():
            if isinstance(value, list):
                candidates.extend(x for x in value if isinstance(x, dict))
            elif isinstance(value, dict):
                candidates.append(value)
        synced_only = [c for c in candidates if c.get("syncedLyrics")]
        search_log("LRCLIB rescue: {} кандидатов, из них с таймкодами {}".format(len(candidates), len(synced_only)))
        item, info = self._rank(track, synced_only)
        if item is None or info is None or info["score"] < ACCEPT_SCORE:
            return None
        search_log("LRCLIB rescue: выбран '{}' - '{}' score={:.2f} title_sim={:.2f} artist_sim={:.2f} dur_diff={:.1f}{}".format(
            safe_str(item.get("trackName")), safe_str(item.get("artistName")), info["score"],
            info["title_sim"], info["artist_sim"], info["dur_diff"], " (артист не совпал)" if info.get("relaxed") else ""))
        result = self._record_to_result(item, track)
        return result if result.synced else None

    # поиск трека без нормального названия
    def _find_untitled(self, track: TrackInfo, deadline: float) -> Optional[Dict[str, Any]]:
        arts = track.query_artists[:2]
        if not arts or track.duration <= 0:
            return None
        tasks = [("u%d" % i, (lambda a=a: self._search({"q": a}, deadline))) for i, a in enumerate(arts)]
        cands: List[Dict[str, Any]] = []
        res = run_parallel(tasks, deadline)
        for value in res.values():
            if isinstance(value, list):
                cands.extend(dict(x, _artist_only_query=True) for x in value if isinstance(x, dict))
        item, info = self._rank(track, cands)
        if item is None or info is None or info["score"] < ACCEPT_SCORE:
            search_log("LRCLIB: название без букв, по артисту+длительности ничего не нашлось ({} кандидатов)".format(len(cands)))
            return None
        search_log("LRCLIB: название без букв -> по артисту и длительности выбран '{}' - '{}' dur_diff={:.1f}".format(
            safe_str(item.get("trackName")), safe_str(item.get("artistName")), info["dur_diff"]))
        return item

    # расширенный поиск
    def deep(self, track: TrackInfo, deadline: float) -> Optional[LyricsResult]:
        titles = build_title_variants(track.title or track.query_fallback)
        if not titles:
            item = self._find_untitled(track, deadline)
            return self._record_to_result(item, track) if item else None
        arts = list(track.query_artists[:3])
        tasks: List[Tuple[str, Any]] = []
        for i, tv in enumerate(titles[:5]):
            tasks.append(("d:t%d" % i, lambda tv=tv: self._search({"track_name": tv}, deadline)))
            for j, a in enumerate(arts):
                tasks.append(("d:q%d_%d" % (i, j), lambda tv=tv, a=a: self._search({"q": "{} {}".format(a, tv)}, deadline)))
                tasks.append(("d:s%d_%d" % (i, j), lambda tv=tv, a=a: self._search(
                    {"track_name": tv, "artist_name": a}, deadline)))
                if i < 3:
                    tasks.append(("d:g%d_%d" % (i, j), lambda tv=tv, a=a: self._get_exact(track, tv, a, deadline)))
        tasks = tasks[:24]
        res = run_parallel(tasks, deadline)
        cands: List[Dict[str, Any]] = []
        for value in res.values():
            if isinstance(value, list):
                cands.extend(x for x in value if isinstance(x, dict))
            elif isinstance(value, dict):
                cands.append(value)
        item, info = self._rank(track, cands)
        search_log("LRCLIB deep: {} кандидатов{}".format(
            len(cands), "" if item is None else ", лучший '{}' - '{}' score={:.2f}".format(
                safe_str(item.get("trackName")), safe_str(item.get("artistName")), info["score"])))
        if item is None or info is None or info["score"] < ACCEPT_SCORE:
            return None
        return self._record_to_result(item, track)

    # точный запрос
    def _get_exact(self, track: TrackInfo, title: str, artist: str, deadline: float,
                   cached: bool = False) -> Optional[Dict[str, Any]]:
        if not title:
            return None
        params: Dict[str, Any] = {"track_name": title}
        if artist:
            params["artist_name"] = artist
        if track.duration > 0:
            params["duration"] = int(round(track.duration))
        url = LRCLIB_GET_CACHED_URL if cached else LRCLIB_GET_URL
        data, code = http_get_json(url, params, self._headers(), timeout=(1.2, 2.5), deadline=deadline,
                                   tag="LRCLIB get-cached" if cached else "LRCLIB get", cache_ttl=300.0)
        if isinstance(data, dict) and (data.get("syncedLyrics") or data.get("plainLyrics") or data.get("instrumental")):
            return data
        return None

    # поиск по запросу
    def _search(self, params: Dict[str, Any], deadline: float) -> List[Dict[str, Any]]:
        data, code = http_get_json(LRCLIB_SEARCH_URL, params, self._headers(), timeout=(1.2, 3.0),
                                   deadline=deadline, tag="LRCLIB search", cache_ttl=300.0)
        self.plugin.log("LRCLIB search {} -> {} results (HTTP {})".format(
            params, len(data) if isinstance(data, list) else 0, code))
        return [x for x in data if isinstance(x, dict)] if isinstance(data, list) else []


    # выбор лучшего кандидата
    def _rank(self, track: TrackInfo, candidates: List[Dict[str, Any]]):
        best_item, best_info, best_key = None, None, None
        sync_item, sync_info, sync_key = None, None, None
        seen = set()
        for item in candidates:
            item_id = safe_str(item.get("id"))
            if item_id and item_id in seen:
                continue
            if item_id:
                seen.add(item_id)
            has_synced = bool(item.get("syncedLyrics"))
            has_plain = bool(item.get("plainLyrics"))
            instrumental = bool(item.get("instrumental"))
            if not (has_synced or has_plain or instrumental):
                continue
            info = self._score_item(track, item)
            if info["reject"]:
                continue
            key = (round(info["score"] / 0.03), has_synced, -(info["dur_diff"] if info["dur_diff"] >= 0 else 99.0),
                   info["score"])
            if best_key is None or key > best_key:
                best_item, best_info, best_key = item, info, key
            if has_synced and (sync_key is None or key > sync_key):
                sync_item, sync_info, sync_key = item, info, key
        if (sync_item is not None and best_info is not None and sync_item is not best_item
                and sync_info["score"] >= ACCEPT_SCORE and sync_info["score"] >= best_info["score"] - 0.10):
            return sync_item, sync_info
        return best_item, best_info

    # лучший кандидат из списка
    def _choose_best_candidate(self, track: TrackInfo, candidates: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
        if not candidates:
            return None
        item, info = self._rank(track, candidates)
        for c in candidates[:12]:
            search_log("  кандидат: '{}' - '{}' duration={:.0f}с synced={}".format(
                safe_str(c.get("trackName")), safe_str(c.get("artistName")),
                float_safe(c.get("duration"), 0.0), bool(c.get("syncedLyrics"))))
        if item is None or info is None:
            self.plugin.log("LRCLIB: подходящих кандидатов нет")
            return None
        if info["score"] < ACCEPT_SCORE:
            self.plugin.log("LRCLIB: лучший score {:.2f} ниже порога".format(info["score"]))
            return None
        search_log("LRCLIB: выбран '{}' - '{}' score={:.2f} title_sim={:.2f} artist_sim={:.2f} dur_diff={:.1f}".format(
            safe_str(item.get("trackName")), safe_str(item.get("artistName")),
            info["score"], info["title_sim"], info["artist_sim"], info["dur_diff"]))
        return item

    # запись в результат
    def _record_to_result(self, data: Dict[str, Any], track: Optional[TrackInfo] = None) -> LyricsResult:
        result = self._record_to_result_raw(data, track)
        try:
            result.matched_duration = float_safe(data.get("duration"), 0.0)
            result.versions = sorted(extract_versions(safe_str(data.get("trackName")))
                                     | ({"instrumental"} if data.get("instrumental") else set()))
            result.verified = True
            if track is not None:
                _info = self._score_item(track, data)
                result.score = _info["score"]
                result.relaxed = bool(_info.get("relaxed"))
                if (_info.get("dur_ignored") and result.synced and result.matched_duration > 0
                        and track.duration > 0):
                    ratio = float(track.duration) / float(result.matched_duration)
                    if 0.5 <= ratio <= 1.7 and abs(ratio - 1.0) > 0.02:
                        result.lines = _retime_lines(result.lines, ratio)
                        result.matched_duration = float(track.duration)
                        search_log("LRCLIB: тайминги пересчитаны x{:.3f} (версия с другой скоростью)".format(ratio))
        except Exception:
            pass
        return result

    # запись в результат без оценки
    def _record_to_result_raw(self, data: Dict[str, Any], track: Optional[TrackInfo] = None) -> LyricsResult:
        source_url = None
        try:
            if data.get("id") is not None:
                source_url = "https://lrclib.net/api/get/" + str(data.get("id"))
        except Exception:
            source_url = None

        if bool(data.get("instrumental")) and not data.get("plainLyrics") and not data.get("syncedLyrics"):
            return LyricsResult(
                lines=[{"time": 0.0, "text": "Инструментал"}],
                synced=True,
                source="LRCLIB",
                source_url=source_url,
                matched_title=safe_str(data.get("trackName")),
                matched_artist=safe_str(data.get("artistName")),
            )

        synced_text = safe_str(data.get("syncedLyrics"))
        if synced_text:
            duration = float_safe(data.get("duration"), 0.0)
            if duration <= 0 and track is not None:
                duration = float_safe(track.duration, 0.0)
            lines = self._parse_lrc(synced_text, duration)
            if lines:
                return LyricsResult(
                    lines=lines,
                    synced=True,
                    source="LRCLIB",
                    source_url=source_url,
                    matched_title=safe_str(data.get("trackName")),
                    matched_artist=safe_str(data.get("artistName")),
                )

        plain_text = safe_str(data.get("plainLyrics"))
        if plain_text:
            return LyricsResult(
                lines=self._plain_to_lines(plain_text),
                synced=False,
                source="LRCLIB",
                source_url=source_url,
                matched_title=safe_str(data.get("trackName")),
                matched_artist=safe_str(data.get("artistName")),
            )

        raise Exception("LRCLIB вернул запись, но без текста")

    # разбор LRC
    def _parse_lrc(self, synced_lyrics: str, duration: float = 0.0) -> List[Dict[str, Any]]:
        lyric_events: List[Dict[str, Any]] = []
        empty_events: List[float] = []
        time_pattern = re.compile(r"\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]")

        for raw_line in synced_lyrics.replace("\r", "\n").split("\n"):
            raw_line = raw_line.strip()
            if not raw_line:
                continue

            matches = list(time_pattern.finditer(raw_line))
            if not matches:
                continue

            text = time_pattern.sub("", raw_line).strip()
            if re.match(r"^\[.+\]$", text):
                continue

            for match in matches:
                minutes = int(match.group(1))
                seconds = int(match.group(2))
                fraction_raw = match.group(3) or "0"
                if len(fraction_raw) == 1:
                    fraction = int(fraction_raw) / 10.0
                elif len(fraction_raw) == 2:
                    fraction = int(fraction_raw) / 100.0
                else:
                    fraction = int(fraction_raw[:3]) / 1000.0
                time_value = minutes * 60 + seconds + fraction

                if not text:
                    empty_events.append(time_value)
                else:
                    lyric_events.append({"time": time_value, "text": text})

        lyric_events.sort(key=lambda item: float_safe(item.get("time"), 0.0))
        empty_events.sort()
        return self._inject_music_gap_markers(lyric_events, empty_events, duration)

    # ноты в паузах
    def _inject_music_gap_markers(
        self,
        lines: List[Dict[str, Any]],
        empty_times: List[float],
        duration: float = 0.0,
    ) -> List[Dict[str, Any]]:
        if not lines:
            return lines

        threshold = float(MUSIC_GAP_THRESHOLD_SEC)
        output: List[Dict[str, Any]] = []

        first_time = float_safe(lines[0].get("time"), 0.0)
        if first_time >= threshold:
            output.append({"time": 0.0, "text": MUSIC_GAP_MARKER, "pause": True})

        for index, line in enumerate(lines):
            output.append(line)
            current_start = float_safe(line.get("time"), 0.0)
            next_start = None
            if index + 1 < len(lines):
                next_start = float_safe(lines[index + 1].get("time"), 0.0)
            elif duration and duration > 0:
                next_start = float_safe(duration, 0.0)

            if next_start is None or next_start <= current_start:
                continue

            line_end = self._estimate_line_end_time(line, current_start, next_start, empty_times)
            if next_start - line_end >= threshold:
                if not output or safe_str(output[-1].get("text")) != MUSIC_GAP_MARKER or abs(float_safe(output[-1].get("time"), -9999.0) - line_end) > 0.05:
                    output.append({"time": line_end, "text": MUSIC_GAP_MARKER, "pause": True})

        output.sort(key=lambda item: float_safe(item.get("time"), 0.0))
        return output

    # оценка конца строки
    def _estimate_line_end_time(
        self,
        line: Dict[str, Any],
        current_start: float,
        next_start: float,
        empty_times: List[float],
    ) -> float:
        for empty_time in empty_times:
            if current_start < empty_time < next_start:
                return max(current_start, min(next_start, empty_time))

        text = safe_str(line.get("text"))
        estimated = len(text) / float(ESTIMATED_CHARS_PER_SEC) if text else ESTIMATED_MIN_LINE_DURATION_SEC
        estimated = max(float(ESTIMATED_MIN_LINE_DURATION_SEC), min(float(ESTIMATED_MAX_LINE_DURATION_SEC), estimated))
        return max(current_start, min(next_start, current_start + estimated))

    # обычный текст в строки
    def _plain_to_lines(self, lyrics: str) -> List[Dict[str, Any]]:
        result: List[Dict[str, Any]] = []
        lyrics = lyrics.replace("\r", "\n")
        for raw_line in lyrics.split("\n"):
            line = raw_line.strip()
            if re.match(r"^\[.+\]$", line):
                continue
            result.append({"time": None, "text": line})
        while result and not safe_str(result[0].get("text")):
            result.pop(0)
        while result and not safe_str(result[-1].get("text")):
            result.pop()
        return result or [{"time": None, "text": "Текст пустой"}]


# кандидаты поиска Genius
def _genius_search_candidates(query: str, per_page: int = 5, target_title: str = "", deadline: float = 0.0) -> List[Dict[str, Any]]:
    hits = list(_genius_search_multi_endpoint(query, per_page=5, deadline=deadline))
    if not _has_strong_hit(hits, target_title) and (not deadline or time.time() < deadline - 1.0):
        seen = {safe_str(h.get("id")) for h in hits if h.get("id")}
        extra = _genius_search_song_endpoint(query, page=1, per_page=per_page, deadline=deadline)
        for h in extra:
            hid = safe_str(h.get("id"))
            if not hid or hid not in seen:
                hits.append(h)
                if hid:
                    seen.add(hid)
        if extra and not _has_strong_hit(hits, target_title) and (not deadline or time.time() < deadline - 1.2):
            hits += _genius_search_song_endpoint(query, page=2, per_page=per_page, deadline=deadline)
    return hits


# есть ли уверенное совпадение
def _has_strong_hit(hits: List[Dict[str, Any]], target_title: str = "") -> bool:
    if not hits:
        return False
    if not target_title:
        return len(hits) >= 3
    for h in hits:
        title = normalize_key(h.get("title", ""))
        if title and string_sim(normalize_key(target_title), title) >= 0.8:
            return True
    return False


_GENIUS_HEADERS = {
    "User-Agent": "Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Mobile Safari/537.36",
    "X-Requested-With": "XMLHttpRequest",
    "Accept": "application/json",
    "Referer": "https://genius.com/search",
}


# запрос к Genius
def _genius_request(url: str, query: str, page: int, per_page: int, deadline: float = 0.0) -> Optional[Dict[str, Any]]:
    data, code = http_get_json(url, {"q": query, "per_page": min(int(per_page), 5), "page": page}, _GENIUS_HEADERS,
                               timeout=(1.5, 3.0), deadline=deadline, tag="Genius search")
    return data if isinstance(data, dict) else None


# поиск Genius по песне
def _genius_search_song_endpoint(query: str, page: int = 1, per_page: int = 5, deadline: float = 0.0) -> List[Dict[str, Any]]:
    hits: List[Dict[str, Any]] = []
    data = _genius_request("https://genius.com/api/search/song", query, page, per_page, deadline)
    if not data:
        return hits
    resp_obj = data.get("response")
    raw_hits = (resp_obj.get("hits") if isinstance(resp_obj, dict) else None) or []
    for hit in raw_hits:
        if not isinstance(hit, dict):
            continue
        result = hit.get("result") or hit
        if result and isinstance(result, dict):
            hits.append(result)
    if not hits:
        search_log("Genius search/song: 0 кандидатов для '{}' (стр. {})".format(query, page))
    return hits


# общий поиск Genius
def _genius_search_multi_endpoint(query: str, per_page: int = 5, deadline: float = 0.0) -> List[Dict[str, Any]]:
    hits: List[Dict[str, Any]] = []
    data = _genius_request("https://genius.com/api/search/multi", query, 1, per_page, deadline)
    if not data:
        return hits
    resp_obj = data.get("response")
    sections = (resp_obj.get("sections") if isinstance(resp_obj, dict) else None) or []
    for sec in sections:
        if not isinstance(sec, dict):
            continue
        for hit in (sec.get("hits") or []):
            if isinstance(hit, dict) and hit.get("type") == "song":
                result = hit.get("result") or {}
                if result and isinstance(result, dict):
                    hits.append(result)
    if not hits:
        search_log("Genius search/multi: 0 кандидатов для '{}'".format(query))
    return hits


# текст со страницы Genius
def _genius_scrape_lyrics(url: str, deadline: float = 0.0) -> Optional[str]:
    try:
        resp, _code = http_get(
            url,
            None,
            {"User-Agent": "Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36"},
            timeout=(1.5, 5.0), deadline=deadline, tag="Genius page",
        )
        if resp is None or _code != 200:
            return None
        try:
            if len(resp.content) > 6 * 1024 * 1024:
                return None
        except Exception:
            pass
        html = resp.text

        lines = []
        import re as _re

        def _extract_genius_containers(html_text):
            results = []
            pos = 0
            guard = 0
            marker = 'data-lyrics-container="true"'
            while True:
                guard += 1
                if guard > 200:
                    break
                start = html_text.find(marker, pos)
                if start == -1:
                    break
                tag_end = html_text.find('>', start)
                if tag_end == -1:
                    pos = start + 1
                    continue
                depth = 1
                i = tag_end + 1
                while i < len(html_text) and depth > 0:
                    open_m = html_text.find('<div', i)
                    close_m = html_text.find('</div>', i)
                    if close_m == -1:
                        pos = start + len(marker)
                        break
                    if open_m != -1 and open_m < close_m:
                        depth += 1
                        i = open_m + 4
                    else:
                        depth -= 1
                        if depth == 0:
                            results.append(html_text[tag_end + 1:close_m])
                            pos = close_m + 6
                            break
                        i = close_m + 6
                else:
                    pos = start + 1
            return results

        containers = _extract_genius_containers(html)
        for container in containers:
            text = _re.sub(r'<br\s*/?>', '\n', container, flags=_re.IGNORECASE)
            text = _re.sub(r'<[^>]+>', '', text)
            text = _html_mod.unescape(text)
            for line in text.split('\n'):
                line = line.strip()
                lines.append(line)

        if lines:
            import re as _sre2
            _sp = _sre2.compile(r'^\[[^\]]{1,80}\]$', _sre2.UNICODE)
            lines = [l for l in lines if not _sp.match(l.strip())]
            _hdr = _sre2.compile(
                r'^(?:Lyrics|Текст\s+песни|[A-Za-z0-9].{0,60}Lyrics\s*\[|.{0,10}\[Текст\s+песни)',
                _sre2.IGNORECASE | _sre2.UNICODE
            )
            lines = [l for l in lines if not _hdr.search(l.strip())]
            while lines and not lines[0]:
                lines.pop(0)
            while lines and not lines[-1]:
                lines.pop()
            return '\n'.join(lines) if lines else None

        match = _re.search(r'"lyrics":\{"body":\{"plain":"(.*?)"', html)
        if match:
            try:
                text = json.loads('"' + match.group(1) + '"')
            except Exception:
                text = match.group(1).replace('\\n', '\n')
            return text if text.strip() else None

    except Exception as e:
        try:
            Plugin.get_instance().log("Genius scrape failed: " + str(e))
        except Exception:
            pass
    return None


# текст через плагин Genius
def _try_get_genius_plugin_lyrics(track, deep: bool = False) -> "Optional[LyricsResult]":
    try:
        if not track.query:
            return None
        inst = Plugin.get_instance()
        deadline = getattr(track, "_deadline", 0.0) or (time.time() + NETWORK_TOTAL_TIMEOUT_SEC)
        target = track.match_target
        if not target.forms:
            return None
        title = track.title or track.query_fallback
        primary = track.primary_artist

        def _split_camel_genius(s: str) -> str:
            s = re.sub(r"([a-zа-яё])([A-ZА-Я])", r"\1 \2", s)
            s = re.sub(r"([A-ZА-Я]{2,})([A-ZА-Я][a-zа-я])", r"\1 \2", s)
            return s.strip()

        queries: List[Tuple[str, bool]] = []
        title_only_q: List[Tuple[str, bool]] = []
        seen_q: set = set()
        for v in build_query_variants(track.title, track.artist):
            q_text = "{} {}".format(v["artist"], v["title"]).strip()
            camel = _split_camel_genius(v["title"])
            for cand_q in (q_text, "{} {}".format(v["artist"], camel).strip() if camel != v["title"] else ""):
                key = normalize_key(cand_q)
                if cand_q and key and key not in seen_q:
                    seen_q.add(key)
                    (queries if v["artist"] else title_only_q).append((cand_q, False))
        if not queries and qclean(track.query):
            queries.append((qclean(track.query), False))
        if deep:
            tvs = build_title_variants(track.title)
            extra_q: List[Tuple[str, bool]] = []
            for a in track.query_artists[1:3]:
                for tv in tvs[:2]:
                    cq = "{} {}".format(a, tv).strip()
                    k = normalize_key(cq)
                    if k and k not in seen_q:
                        seen_q.add(k)
                        extra_q.append((cq, False))
            queries = queries[:4] + extra_q[:3] + title_only_q[:3]
        else:
            queries = (queries[:2] + title_only_q[:1]) if title_only_q else queries[:3]

        all_hits: List[Dict[str, Any]] = []
        tasks = [("g%d" % i, (lambda q=q: _genius_search_candidates(q, per_page=5, target_title=title, deadline=deadline)))
                 for i, (q, _) in enumerate(queries)]
        res = run_parallel(tasks, deadline)
        for value in res.values():
            if isinstance(value, list):
                all_hits.extend(h for h in value if isinstance(h, dict))
        if not all_hits:
            if inst:
                inst.log("Genius: no hits for: " + safe_str(track.query))
            return None

        best_hit, best_info, best_key = None, None, None
        seen_ids: set = set()
        for hit in all_hits:
            hit_id = safe_str(hit.get("id"))
            if hit_id and hit_id in seen_ids:
                continue
            if hit_id:
                seen_ids.add(hit_id)
            prim = (hit.get("primary_artist") or {}).get("name", "")
            artist_names = safe_str(hit.get("artist_names")) or safe_str(prim)
            if hit.get("lyrics_state") not in (None, "", "complete"):
                continue
            if _GENIUS_JUNK_RE.search(artist_names) or _GENIUS_JUNK_RE.search(safe_str(hit.get("title"))):
                continue
            info = score_candidate(target, safe_str(hit.get("title")), artist_names, 0.0, plain=True)
            if info["reject"]:
                continue
            key = (round(info["score"], 3), bool(hit.get("lyrics_state") == "complete"))
            if best_key is None or key > best_key:
                best_hit, best_info, best_key = hit, info, key

        if not best_hit or best_info is None:
            return None
        if best_info["score"] < GENIUS_MIN_SCORE:
            if inst:
                inst.log("Genius: best score {:.2f} below threshold, rejecting".format(best_info["score"]))
            return None

        matched_title = safe_str(best_hit.get("title"))
        matched_artist = safe_str(best_hit.get("artist_names")) or safe_str(
            (best_hit.get("primary_artist") or {}).get("name"))
        song_url = safe_str(best_hit.get("url"))
        if inst:
            inst.log("Genius best match: {} — {} (score={:.2f})".format(matched_title, matched_artist, best_info["score"]))
        if not song_url:
            return None

        raw_text = _genius_scrape_lyrics(song_url, deadline)
        if not raw_text or not raw_text.strip():
            if inst:
                inst.log("Genius: scrape returned empty for: " + song_url)
            return None

        sec_pat = re.compile(r'^\[[^\]]{1,80}\]$', re.UNICODE)
        lines = []
        for line in raw_text.split('\n'):
            stripped = line.strip()
            if sec_pat.match(stripped):
                continue
            lines.append({"time": None, "text": stripped})
        while lines and not safe_str(lines[0].get("text")):
            lines.pop(0)
        while lines and not safe_str(lines[-1].get("text")):
            lines.pop()
        if not lines:
            return None
        if len(lines) > MAX_LYRIC_LINES:
            lines = lines[:MAX_LYRIC_LINES]
        return LyricsResult(lines=lines, synced=False, source="Genius", source_url=song_url,
                            matched_title=matched_title, matched_artist=matched_artist,
                            versions=sorted(extract_versions(matched_title)), verified=True,
                            score=float(best_info["score"]))
    except Exception as e:
        try:
            Plugin.get_instance().log("Genius fallback failed: " + str(e))
        except Exception:
            pass
        return None


GENIUS_MIN_SCORE = 0.78
_GENIUS_JUNK_RE = re.compile(
    r"genius\s+(?:\w+\s+)?(?:translations?|romanizations?)|\btrack\s*list\b|\bdiscography\b|\bannotated\b", re.I)


# текст с lyrics.ovh
def _try_lyrics_ovh(track: "TrackInfo") -> Optional["LyricsResult"]:
    artist = track.primary_artist
    title = qclean(track.title)
    if not artist or not title:
        return None
    try:
        url = "https://api.lyrics.ovh/v1/{}/{}".format(
            requests.utils.quote(artist, safe=""), requests.utils.quote(title, safe=""))
        resp, code = http_get(url, None, {"Accept": "application/json", "User-Agent": "LyricsPlus/2.7.0"},
                              timeout=(2.0, 4.0), deadline=getattr(track, "_deadline", 0.0), tag="Lyrics.ovh",
                              retry_timeout=False)
        if resp is None or code != 200:
            return None
        payload = resp.json()
        raw = safe_str(payload.get("lyrics")) if isinstance(payload, dict) else ""
        if not raw:
            return None
        lines = [{"time": None, "text": x.strip()} for x in raw.splitlines() if x.strip()]
        if len(lines) < 4:
            return None
        return LyricsResult(lines=lines[:MAX_LYRIC_LINES], synced=False, source="Lyrics.ovh", source_url=url,
                            matched_title=title, matched_artist=track.artist, verified=False)
    except Exception as e:
        search_log("Lyrics.ovh fallback failed: {}".format(e))
        return None


# текст с Karalyr
def _try_karalyr(track: "TrackInfo", lrclib_provider: "LrclibLyricsProvider") -> Optional["LyricsResult"]:
    if not qclean(track.title) or not track.primary_artist:
        return None
    headers = {
        "Accept": "application/json",
        "User-Agent": "LyricsPlus/2.7.0 (Android; lyrics lookup)",
        "X-Karalyr-Client": "LyricsPlus/2.7.0",
    }
    params: Dict[str, Any] = {"track_name": qclean(track.title), "artist_name": track.primary_artist}
    if track.duration > 0:
        params["duration"] = int(round(track.duration))
    try:
        data, code = http_get_json("https://karalyr.com/api/get", params, headers, timeout=(1.5, 3.0),
                                   deadline=getattr(track, "_deadline", 0.0), tag="Karalyr", cache_ttl=300.0)
        if not isinstance(data, dict) or not (data.get("syncedLyrics") or data.get("plainLyrics")):
            return None
        info = lrclib_provider._score_item(track, data)
        if info["reject"] or info["score"] < ACCEPT_SCORE:
            search_log("Karalyr: '{}' - '{}' отклонен (score={:.2f})".format(
                safe_str(data.get("trackName")), safe_str(data.get("artistName")), info["score"]))
            return None
        result = lrclib_provider._record_to_result(data, track)
        result.source = "Karalyr"
        result.source_url = "https://karalyr.com"
        return result
    except Exception as e:
        search_log("Karalyr lookup failed: {}".format(e))
        return None


# есть ли пословная синхронизация
def _has_word_sync(result: Optional["LyricsResult"]) -> bool:
    try:
        return bool(result and result.lines and any(isinstance(l, dict) and l.get("words") for l in result.lines[:12]))
    except Exception:
        return False


# уверенность совпадения
def _match_confidence(track: "TrackInfo", result: Optional["LyricsResult"]) -> float:
    return result_confidence(track, result)


# точное совпадение
def _match_exact(track: "TrackInfo", result: "LyricsResult") -> bool:
    if not result.verified:
        return False
    info = score_candidate(track.match_target, safe_str(result.matched_title), safe_str(result.matched_artist),
                           float_safe(result.matched_duration, 0.0), synced=bool(result.synced),
                           cand_versions=frozenset(result.versions or ()))
    return bool(info["exact"])


HIGH_CONFIDENCE_THRESHOLD = 0.82
EXACT_CONFIDENCE = 0.96
GOOD_CONFIDENCE = 0.88
DEEP_SEARCH_SEC = 11.0
SEARCH_HARD_DEADLINE_SEC = 10.0
SYNCED_ACCEPT_CONF = 0.70
SYNCED_LAST_RESORT_CONF = 0.55
SYNCED_PATIENCE_SEC = 6.0
RESCUE_AFTER_SEC = 2.0
UNSYNCED_CACHE_TTL_SEC = 2 * 60 * 60
SYNC_PROVIDERS = ("LRCLIB", "LiriQo", "Karalyr", "Rescue")
HEDGE_DELAY_SEC = 0.9
RICH_SYNC_GRACE_SEC = 0.5
GOOD_ACCEPT_AFTER_SEC = 1.2
FALLBACK_ACCEPT_AFTER_SEC = 3.2
NEGATIVE_SHORT_SEC = 20 * 60
FALLBACK_CONFIDENCE = 0.76
FINAL_CONFIDENCE = 0.72


# общий запрос для одинаковых треков
class _Flight:
    def __init__(self):
        self.event = threading.Event()
        self.result: Optional["LyricsResult"] = None
        self.error: Optional[BaseException] = None


# объединенный провайдер текстов
class CombinedLyricsProvider:
    def __init__(self, plugin: "Plugin"):
        self.plugin = plugin
        self.liriqo = LiriQoLyricsProvider(plugin)
        self.lrclib = LrclibLyricsProvider(plugin)
        self._flights: Dict[str, _Flight] = {}
        self._flights_lock = threading.Lock()

    # получение текста
    def get_lyrics(self, track: "TrackInfo") -> "LyricsResult":
        t0 = time.time()
        hit = self._cache_lookup(track)
        if hit is not None:
            result, via = hit
            search_log("=== Трек: '{}' - '{}' | из КЭША ({}) за {:.0f} мс -> '{}' - '{}' ===".format(
                safe_str(track.title), safe_str(track.artist), via, (time.time() - t0) * 1000.0,
                result.matched_title, result.matched_artist))
            return result
        neg = self.plugin.cache_get_negative(track.negative_key)
        if neg:
            raise Exception(neg)

        key = track.final_key
        with self._flights_lock:
            flight = self._flights.get(key)
            leader = flight is None
            if leader:
                flight = _Flight()
                self._flights[key] = flight
        if not leader:
            flight.event.wait(SEARCH_HARD_DEADLINE_SEC + 1.5)
            if flight.result is not None:
                return flight.result
            hit = self._cache_lookup(track)
            if hit is not None:
                return hit[0]
            if flight.error is not None:
                raise flight.error
            raise Exception("Не удалось найти текст для: " + safe_str(track.query))

        try:
            result = self._fetch_lyrics(track)
            try:
                self._cache_store(track, result)
            except Exception as e:
                self.plugin.log("cache store failed: " + str(e))
            flight.result = result
            return result
        except BaseException as e:
            flight.error = e
            raise
        finally:
            with self._flights_lock:
                self._flights.pop(key, None)
            flight.event.set()

    # подходит ли запись кэша
    @staticmethod
    def _cache_ok(track: "TrackInfo", result: "LyricsResult") -> bool:
        try:
            if result.synced:
                md = float_safe(result.matched_duration, 0.0)
                if track.duration > 0 and md > 0 and abs(track.duration - md) > 12.0:
                    return False
                if _sync_sanity_penalty(result.lines, track.duration) > 0:
                    return False
            return True
        except Exception:
            return True

    # поиск в кэше
    def _cache_lookup(self, track: "TrackInfo"):
        plugin = self.plugin
        fps = track.fingerprints
        for fp in fps:
            item = plugin.cache_get("fp_v6|" + fp)
            if item:
                result = LyricsResult.from_cache(item)
                if result and self._cache_ok(track, result):
                    plugin.cache_put_alias(track.final_key, "fp_v6|" + fp)
                    for other in fps:
                        if other != fp:
                            plugin.cache_put_alias("fp_v6|" + other, "fp_v6|" + fp)
                    return result, "хэш файла"
        item = plugin.cache_get(track.final_key)
        if item:
            result = LyricsResult.from_cache(item)
            if result and self._cache_ok(track, result):
                for fp in fps:
                    plugin.cache_put_alias("fp_v6|" + fp, track.final_key)
                return result, "название"
        try:
            found = plugin.cache_find_similar(track)
        except Exception as e:
            plugin.log("fuzzy cache lookup failed: " + str(e))
            found = None
        if found:
            key, item = found
            result = LyricsResult.from_cache(item)
            if result and self._cache_ok(track, result):
                plugin.cache_put_alias(track.final_key, key)
                for fp in fps:
                    plugin.cache_put_alias("fp_v6|" + fp, key)
                return result, "похожее название"
        return None

    # запись в кэш
    def _cache_store(self, track: "TrackInfo", result: "LyricsResult") -> None:
        conf = _match_confidence(track, result)
        strong = bool(result.synced) and bool(result.verified) and conf >= HIGH_CONFIDENCE_THRESHOLD
        item = result.to_cache()
        if not result.synced:
            item["ttl"] = int(UNSYNCED_CACHE_TTL_SEC)
        else:
            item["ttl"] = int((CACHE_TTL_DAYS if strong else CACHE_TTL_WEAK_DAYS) * 24 * 60 * 60)
        self.plugin.cache_put(track.final_key, item)
        for fp in track.fingerprints:
            self.plugin.cache_put_alias("fp_v6|" + fp, track.final_key)

    # сортировка результатов
    def _rank(self, track: "TrackInfo", results: Dict[str, Optional["LyricsResult"]]):
        items = []
        for name, result in results.items():
            if not result or not result.lines or name == "Lyrics.ovh":
                continue
            conf = result_confidence(track, result)
            if result.source == "Genius" and len(result.lines) < 8:
                conf = max(0.0, conf - 0.25)
            items.append([conf, name, result])
        if len(items) >= 2:
            agree_pairs = {}
            for i in range(len(items)):
                for j in range(i + 1, len(items)):
                    agree_pairs[(i, j)] = lyrics_agree(items[i][2], items[j][2])
            for i, it in enumerate(items):
                agree = sum(1 for (x, y), ok in agree_pairs.items() if ok and i in (x, y))
                if agree:
                    it[0] = min(1.0, it[0] + 0.04 * min(agree, 2))
                elif len(items) >= 3 and any(ok for (x, y), ok in agree_pairs.items() if i not in (x, y)):
                    it[0] = max(0.0, it[0] - 0.15)
        kept = []
        for it in items:
            if getattr(it[2], "relaxed", False):
                others = [o for o in items if o is not it and len(o[2].lines) >= 8]
                if not any(lyrics_agree(it[2], o[2]) for o in others):
                    search_log("  отброшен '{}' - '{}': артист не совпал и другие источники не подтвердили текст".format(
                        it[2].matched_title, it[2].matched_artist))
                    continue
            kept.append(it)
        items = kept
        corroborated = set()
        for a_i in range(len(items)):
            for b_i in range(a_i + 1, len(items)):
                if lyrics_agree(items[a_i][2], items[b_i][2]):
                    corroborated.update((id(items[a_i][2]), id(items[b_i][2])))
        for it in items:
            if it[2].synced and not it[2].verified and id(it[2]) not in corroborated:
                it[0] = min(it[0], 0.69)
        ranked = [(conf, _has_word_sync(r), bool(r.synced), len(r.lines), name, r) for conf, name, r in items]

        def _tier(conf: float, synced: bool, res=None) -> int:
            if synced and conf >= SYNCED_ACCEPT_CONF and (res is None or res.verified or id(res) in corroborated):
                return 2
            if conf >= FINAL_CONFIDENCE:
                return 1
            return 0

        ranked.sort(key=lambda r: (_tier(r[0], r[2], r[5]), round(r[0] / 0.04), r[1], r[2], r[0], r[3]), reverse=True)
        return ranked

    # выбор итогового результата
    def _decide(self, track, results, elapsed: float, pending: set, final: bool, exact_since: Optional[Dict[str, float]] = None):
        ranked = self._rank(track, results)
        synced_pending = any(p in SYNC_PROVIDERS for p in pending)
        if ranked:
            for conf, word, synced, _n, name, result in ranked:
                if synced and conf >= EXACT_CONFIDENCE and _match_exact(track, result):
                    seen = None
                    if exact_since is not None:
                        seen = exact_since.setdefault("t", elapsed)
                    waited = (elapsed - seen) if seen is not None else RICH_SYNC_GRACE_SEC
                    if word or "LiriQo" not in pending or waited >= RICH_SYNC_GRACE_SEC:
                        return result, "exact"
                    break
            conf, word, synced, _n, name, result = ranked[0]
            if synced:
                if conf >= GOOD_CONFIDENCE and elapsed >= GOOD_ACCEPT_AFTER_SEC:
                    return result, "good"
                if conf >= SYNCED_ACCEPT_CONF:
                    if (not synced_pending and elapsed >= GOOD_ACCEPT_AFTER_SEC) or elapsed >= SYNCED_PATIENCE_SEC:
                        return result, "synced"
            else:
                if (not synced_pending) and conf >= FALLBACK_CONFIDENCE and elapsed >= FALLBACK_ACCEPT_AFTER_SEC:
                    return result, "unsynced-fallback"
            if final:
                best_synced = next((r for r in ranked if r[2] and r[0] >= SYNCED_ACCEPT_CONF), None)
                if best_synced:
                    return best_synced[5], "final-synced"
                best_plain = next((r for r in ranked if (not r[2]) and r[0] >= FINAL_CONFIDENCE), None)
                if best_plain:
                    return best_plain[5], "final-unsynced"
                last_resort = next((r for r in ranked if r[2] and r[0] >= SYNCED_LAST_RESORT_CONF and r[5].verified), None)
                if last_resort:
                    return last_resort[5], "final-synced-weak"
        if final:
            ovh = results.get("Lyrics.ovh")
            if ovh and ovh.lines and len(ovh.lines) >= 6:
                return ovh, "ovh"
        return None, ""

    # спасательный поиск таймкодов
    def _rescue(self, track: "TrackInfo") -> Optional["LyricsResult"]:
        deadline = track._deadline or (time.time() + NETWORK_TOTAL_TIMEOUT_SEC)
        search_log("Rescue: ищем синхронизацию другими способами для '{}' - '{}'".format(
            safe_str(track.title), safe_str(track.artist)))
        jobs = [
            ("lrclib", lambda: self.lrclib.rescue(track, deadline)),
            ("liriqo", lambda: self.liriqo.get_lyrics(track, rescue=True)),
        ]
        found = run_parallel(jobs, deadline)
        best, best_key = None, None
        for name, res in found.items():
            if not (res and res.lines and res.synced):
                continue
            key = (round(result_confidence(track, res) / 0.04), _has_word_sync(res))
            search_log("Rescue: {} -> '{}' - '{}' conf={:.2f}".format(
                name, res.matched_title, res.matched_artist, result_confidence(track, res)))
            if best_key is None or key > best_key:
                best, best_key = res, key
        return best

    # расширенный поиск
    def _deep_search(self, track: "TrackInfo") -> Optional["LyricsResult"]:
        started = time.time()
        deadline = started + DEEP_SEARCH_SEC
        track._deadline = deadline
        search_log("Deep: расширенный поиск для '{}' - '{}'".format(safe_str(track.title), safe_str(track.artist)))
        jobs = [
            ("Genius", lambda: _try_get_genius_plugin_lyrics(track, deep=True)),
            ("LRCLIB", lambda: self.lrclib.deep(track, deadline)),
        ]
        found = run_parallel(jobs, deadline)
        results = {n: r for n, r in found.items() if r and getattr(r, "lines", None)}
        for n, r in results.items():
            search_log("Deep: {} -> '{}' - '{}' synced={} conf={:.2f}".format(
                n, r.matched_title, r.matched_artist, r.synced, result_confidence(track, r)))
        if not results:
            return None
        chosen, _why = self._decide(track, results, DEEP_SEARCH_SEC, set(), final=True)
        return chosen

    # сбор текстов из источников
    def _fetch_lyrics(self, track: "TrackInfo") -> "LyricsResult":
        try:
            legacy = self.plugin.cache_get(track.cache_key)
            legacy_result = LyricsResult.from_cache(legacy) if legacy else None
            if (legacy_result and legacy_result.synced
                    and _match_confidence(track, legacy_result) >= HIGH_CONFIDENCE_THRESHOLD):
                self.plugin.log("Legacy cache selected before network lookup")
                return legacy_result
        except Exception as e:
            self.plugin.log("Legacy cache read failed: " + str(e))

        started = time.time()
        deadline = started + SEARCH_HARD_DEADLINE_SEC
        track._deadline = deadline
        events: "_queue_mod.Queue" = _queue_mod.Queue()
        results: Dict[str, Optional[LyricsResult]] = {}
        errors: Dict[str, Any] = {}
        clean_misses = {"n": 0}

        def run_provider(name, fn):
            ts = time.time()
            try:
                value = fn()
                value = value if (value and value.lines) else None
                events.put((name, value, None, (time.time() - ts) * 1000.0))
            except BaseException as e:
                events.put((name, None, e, (time.time() - ts) * 1000.0))

        tier1 = [
            ("LRCLIB", lambda: self.lrclib.get_lyrics(track)),
            ("LiriQo", lambda: self.liriqo.get_lyrics(track)),
            ("Karalyr", lambda: _try_karalyr(track, self.lrclib)),
        ]
        tier2 = [
            ("Genius", lambda: _try_get_genius_plugin_lyrics(track)),
            ("Lyrics.ovh", lambda: _try_lyrics_ovh(track)),
        ]
        pending: set = set()

        def launch(jobs):
            for name, fn in jobs:
                pending.add(name)
                threading.Thread(target=run_provider, args=(name, fn),
                                 name="LyricsProvider-" + name.replace(".", ""), daemon=True).start()

        launch(tier1)
        tier2_started = False
        rescue_started = False
        hedge_at = started + HEDGE_DELAY_SEC
        chosen = None
        why = ""
        exact_since: Dict[str, float] = {}

        while True:
            now = time.time()
            elapsed = now - started
            if (not tier2_started) and (now >= hedge_at or not pending):
                ranked = self._rank(track, results)
                if not (ranked and ranked[0][0] >= GOOD_CONFIDENCE and ranked[0][2]):
                    launch(tier2)
                tier2_started = True
            if not rescue_started:
                t1_pending = any(n in pending for n in ("LRCLIB", "LiriQo", "Karalyr"))
                if (not t1_pending) or elapsed >= RESCUE_AFTER_SEC:
                    rescue_started = True
                    rk = self._rank(track, results)
                    if not any(r[2] and r[0] >= SYNCED_ACCEPT_CONF for r in rk):
                        launch([("Rescue", lambda: self._rescue(track))])
            chosen, why = self._decide(track, results, elapsed, pending, final=False, exact_since=exact_since)
            if chosen is not None:
                break
            if now >= deadline or (tier2_started and not pending):
                chosen, why = self._decide(track, results, elapsed, set(), final=True)
                break
            wait = deadline - now
            if not tier2_started:
                wait = min(wait, max(0.02, hedge_at - now))
            elif results:
                wait = min(wait, 0.1)
            try:
                name, value, err, ms = events.get(timeout=max(0.02, min(wait, 0.5)))
            except _queue_mod.Empty:
                continue
            pending.discard(name)
            if err is not None:
                errors[name] = err
                self.plugin.log("{} provider failed: {}".format(name, err))
            else:
                results[name] = value
                if value is None:
                    clean_misses["n"] += 1
                self.plugin.log("{} finished in {:.0f} ms ({})".format(name, ms, "hit" if value else "miss"))

        try:
            for conf, word, synced, _n, name, res in self._rank(track, results):
                search_log("  итог: {} conf={:.2f} verified={} synced={} word={} dur={:.0f}с '{}' - '{}'".format(
                    name, conf, res.verified, synced, word, float_safe(res.matched_duration, 0.0),
                    res.matched_title, res.matched_artist))
        except Exception:
            pass
        if chosen is not None:
            self.plugin.log("Selected {} ({}) elapsed={:.0f}ms".format(
                chosen.source, why, (time.time() - started) * 1000.0))
            return chosen

        if not getattr(track, "_deep_done", False):
            try:
                track._deep_done = True
            except Exception:
                pass
            try:
                deep = self._deep_search(track)
            except Exception as e:
                deep = None
                self.plugin.log("deep search failed: " + str(e))
            if deep is not None:
                search_log("Deep: найдено через расширенный поиск ({})".format(deep.source))
                return deep

        if clean_misses["n"] >= 2 and len(errors) <= 1:
            try:
                self.plugin.cache_put_negative(
                    track.negative_key, "Ни один источник не нашел текст для: " + safe_str(track.query), NEGATIVE_SHORT_SEC)
            except Exception:
                pass
        if errors and not results:
            self.plugin.log("All lyrics providers failed: " + safe_str(errors))
        raise Exception("Ни один источник не нашел достаточно подходящий текст для: " + safe_str(track.query))


# цвет в байты ARGB
def _af_argb_bytes(color_int: int) -> Tuple[int, int, int, int]:
    c = int(color_int) & 0xFFFFFFFF
    a = (c >> 24) & 0xFF
    r = (c >> 16) & 0xFF
    g = (c >> 8) & 0xFF
    b = c & 0xFF
    return a, r, g, b


# отладка анимаций
def _af_dbg(viewer, tag: str, message: str) -> None:
    try:
        viewer._dbg(tag, message)
    except Exception:
        pass


# включена ли анимация масштаба
def _af_scale_animation_enabled(viewer):
    return setting_bool(viewer.plugin, "scale_animation_enabled", DEFAULT_SCALE_ANIMATION_ENABLED)

# длительность анимации
def _af_animation_ms(viewer):
    return viewer._setting_int("animation_ms", DEFAULT_ANIMATION_MS, 60, 900)


# интервал между строками
def _af_line_interval_ms(viewer, line_index: int) -> int:
    try:
        t_cur = viewer.line_times[line_index] if 0 <= line_index < len(viewer.line_times) else None
        if t_cur is None:
            return DEFAULT_LINE_INTERVAL_MS
        t_next = None
        for j in range(line_index + 1, len(viewer.line_times)):
            tv = viewer.line_times[j]
            if tv is not None:
                t_next = float(tv)
                break
        if t_next is None:
            t_next = float(t_cur) + 5.0
        delta_ms = (float(t_next) - float(t_cur)) * 1000.0
        return int(max(100.0, min(8000.0, delta_ms)))
    except Exception:
        return DEFAULT_LINE_INTERVAL_MS


# целевой масштаб строки
def _get_target_scale(viewer, is_active: bool, is_backing: bool = False) -> float:
    try:
        return float(viewer._line_target_state(is_active, is_backing)[0])
    except Exception:
        return 1.0

# целевой цвет строки
def _get_target_color(viewer, is_active: bool, is_backing: bool = False) -> int:
    try:
        return int(viewer._line_target_state(is_active, is_backing)[1])
    except Exception:
        return int(COLOR_TEXT_ACTIVE)

# целевой сдвиг строки
def _get_target_translation(viewer, is_active: bool, is_backing: bool = False) -> float:
    try:
        return float(viewer._line_target_state(is_active, is_backing)[2])
    except Exception:
        return 0.0


# смешивание цветов
def _af_lerp_color(fc: int, tc: int, t: float) -> int:
    if _ARGB_EVALUATOR is not None:
        try:
            return int(_ARGB_EVALUATOR.evaluate(float(t), Integer(fc), Integer(tc)))
        except Exception:
            pass
    fa, fr, fg, fb = _af_argb_bytes(fc)
    ta, tr, tg, tb = _af_argb_bytes(tc)
    return Color.argb(
        max(0, min(255, int(fa + (ta - fa) * t))),
        max(0, min(255, int(fr + (tr - fr) * t))),
        max(0, min(255, int(fg + (tg - fg) * t))),
        max(0, min(255, int(fb + (tb - fb) * t))),
    )

# анимация значения с интерполятором
def _af_animate_interpolated(duration_ms, value_fn, apply_fn):
    frame_ms = 16
    steps = max(8, duration_ms // frame_ms)
    sleep_sec = duration_ms / 1000.0 / steps

    def worker():
        for i in range(1, steps + 1):
            t = i / float(steps)
            v = value_fn(t)
            run_on_ui_thread_safe(lambda val=v: apply_fn(val))
            time.sleep(sleep_sec)

    threading.Thread(target=worker, name="LyricsTextAnim", daemon=True).start()

# аниматор масштаба и сдвига строки
def _af_build_line_animator(viewer, row: FrameLayout, line_index: int, is_active: bool,
                             is_backing: bool = False, shared_base_ms: Optional[int] = None):
    target_scale = _get_target_scale(viewer, is_active, is_backing)
    target_translation = _get_target_translation(viewer, is_active, is_backing)
    viewer._apply_scale_pivot(row)
    try:
        from_scale = float(row.getScaleX())
    except Exception:
        from_scale = target_scale
    try:
        from_ty = float(row.getTranslationY())
    except Exception:
        from_ty = target_translation

    duration_ms = int(_af_animation_ms(viewer) * (1.1 if is_active else 1.3))
    wave_on = _af_wave_enabled(viewer)
    if wave_on:
        _wd = _af_wave_duration_ms(viewer)
        duration_ms = int(_wd * (0.85 if is_active else 0.70))
    spring_zeta = 0.62 if is_active else 1.0
    interpolator = None

    if not ANIMATOR_AVAILABLE:
        _af_animate_interpolated(
            duration_ms,
            lambda t: (from_scale + (target_scale - from_scale) * t,),
            lambda v: (row.setScaleX(v[0]), row.setScaleY(v[0])),
        )
        return None

    if True:
        try:
            ax = ObjectAnimator.ofFloat(row, "scaleX", float(from_scale), float(target_scale))
            ay = ObjectAnimator.ofFloat(row, "scaleY", float(from_scale), float(target_scale))
            if wave_on:
                ip = _af_bezier(0.30, 0.40, 0.20, 1.18) if is_active else _af_bezier(0.30, 0.40, 0.20, 1.0)
            else:
                ip = _af_bezier(*SMOOTH_BEZIER)
            for oa in (ax, ay):
                oa.setDuration(int(duration_ms))
                oa.setInterpolator(ip)
            sset = AnimatorSet()
            sset.playTogether(ax, ay)
            return sset
        except Exception as e:
            _af_dbg(viewer, "core", "native scale animator failed, python fallback: " + str(e))

    try:
        animator = ValueAnimator.ofFloat(0.0, 1.0)
        animator.setDuration(duration_ms)
        try:
            if wave_on:
                animator.setInterpolator(LinearInterpolator())
            else:
                animator.setInterpolator(AccelerateDecelerateInterpolator())
        except Exception:
            pass

        class ScaleFrameListener(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
            def onAnimationUpdate(self, anim):
                try:
                    t = float(anim.getAnimatedValue())
                    if wave_on:
                        t = _af_spring(t, spring_zeta)
                    s = from_scale + (target_scale - from_scale) * t
                    row.setScaleX(s)
                    row.setScaleY(s)
                except Exception:
                    pass

        animator.addUpdateListener(ScaleFrameListener())
        return animator
    except Exception as e:
        _af_dbg(viewer, "core", "_build_line_animator fell back to instant apply: " + str(e))
        try:
            viewer._apply_scale_state_instant(row, is_active, is_backing)
        except Exception:
            pass
        try:
            viewer._apply_row_alpha_instant(row, is_active, is_backing)
        except Exception:
            pass
        return None

# аниматор цвета строки
def _af_build_color_fade_animator(viewer, view: TextView, line_index: int, is_active: bool,
                                    duration_ms: Optional[int] = None, start_delay_ms: int = 0,
                                    is_backing: bool = False, shared_base_ms: Optional[int] = None):
    target_color = _get_target_color(viewer, is_active, is_backing)
    from_color = _get_target_color(viewer, not is_active, False)

    _af_dbg(viewer, "core", "fade(LyricsPlus default): line={} is_active={} from_color={:#010x} "
                        "target_color={:#010x} identical={}".format(
                            line_index, is_active, from_color & 0xFFFFFFFF,
                            target_color & 0xFFFFFFFF, from_color == target_color))

    if duration_ms is None:
        duration_ms = int(_af_animation_ms(viewer) * (1.1 if is_active else 1.3))
        if _af_wave_enabled(viewer):
            duration_ms = int(_af_wave_duration_ms(viewer) * (0.50 if is_active else 0.65))

    if not ANIMATOR_AVAILABLE:
        return None

    try:
        if PATH_INTERP_AVAILABLE:
            ca = ObjectAnimator.ofArgb(view, "textColor", _af_i32(from_color), _af_i32(target_color))
            ca.setDuration(int(duration_ms))
            if start_delay_ms > 0:
                ca.setStartDelay(int(start_delay_ms))
            if _af_wave_enabled(viewer):
                ca.setInterpolator(_af_bezier(0.33, 0.0, 0.2, 1.0))
            else:
                ca.setInterpolator(_af_bezier(*SMOOTH_BEZIER))
            return ca
    except Exception as e:
        _af_dbg(viewer, "core", "native color animator failed, python fallback: " + str(e))

    try:
        animator = ValueAnimator.ofFloat(0.0, 1.0)
        animator.setDuration(int(duration_ms))
        if start_delay_ms > 0:
            try:
                animator.setStartDelay(int(start_delay_ms))
            except Exception:
                pass
        try:
            animator.setInterpolator(AccelerateDecelerateInterpolator())
        except Exception:
            pass

        _fade_error_logged = {"done": False}

        class ColorFrameListener(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
            def onAnimationUpdate(self, anim):
                try:
                    t = float(anim.getAnimatedValue())
                    c = _af_lerp_color(from_color, target_color, t)
                    view.setTextColor(c)
                except Exception as e:
                    if not _fade_error_logged["done"]:
                        _fade_error_logged["done"] = True
                        _af_dbg(viewer, "core", "fade onAnimationUpdate failed (logged once): " + str(e))

        animator.addUpdateListener(ColorFrameListener())
        return animator
    except Exception as e:
        _af_dbg(viewer, "core", "_build_color_fade_animator failed, applying color instantly: " + str(e))
        try:
            view.setTextColor(target_color)
        except Exception:
            pass
        return None


# отмена перехода строки
def _af_cancel_line_transition(viewer, line_index: int, view=None, is_active: bool = False,
                                is_backing: bool = False) -> None:
    if view is None:
        return
    try:
        paint = view.getPaint()
        if paint is not None:
            if is_active:
                paint.setAlpha(255)
            else:
                try:
                    paint.setAlpha(int(viewer._inactive_alpha()))
                except Exception:
                    paint.setAlpha(255)

        try:
            resting_color = int(COLOR_TEXT_ACTIVE) if is_active else int(viewer._inactive_text_color())
            view.setTextColor(resting_color)
        except Exception:
            pass

        view.invalidate()
    except Exception:
        pass


# переход строки в активное состояние
def _af_line_transition_strategy(viewer, old_row, old_view, old_index,
                                  new_row, new_view, new_index, is_backing: bool = False) -> bool:
    scale_on = _af_scale_animation_enabled(viewer)

    shared_base_ms = _af_line_interval_ms(viewer, new_index) if new_index >= 0 else None

    animators = []

    if old_row is not None and old_view is not None:
        viewer._set_line_blur(old_view, blurred=True, animate=True)
    if new_row is not None and new_view is not None:
        viewer._set_line_blur(new_view, blurred=False, animate=True)

    if scale_on:
        if old_row is not None and old_view is not None:
            a = _af_build_line_animator(viewer, old_row, old_index, is_active=False, shared_base_ms=shared_base_ms)
            if a is not None:
                animators.append(a)
        if new_row is not None and new_view is not None:
            a = _af_build_line_animator(viewer, new_row, new_index, is_active=True, is_backing=is_backing,
                                         shared_base_ms=shared_base_ms)
            if a is not None:
                animators.append(a)
    else:
        if old_row is not None:
            viewer._apply_scale_state_instant(old_row, is_active=False)
        if new_row is not None:
            viewer._apply_scale_state_instant(new_row, is_active=True, is_backing=is_backing)

    if old_row is not None:
        viewer._apply_row_alpha_instant(old_row, is_active=False)
    if new_row is not None:
        viewer._apply_row_alpha_instant(new_row, is_active=True, is_backing=is_backing)

    if old_row is not None and old_view is not None:
        a = _af_build_color_fade_animator(viewer, old_view, old_index, is_active=False)
        if a is not None:
            animators.append(a)
        else:
            viewer._apply_color_state_instant(old_view, old_index, is_active=False)
    if new_row is not None and new_view is not None:
        a = _af_build_color_fade_animator(viewer, new_view, new_index, is_active=True, is_backing=is_backing,
                                           shared_base_ms=shared_base_ms)
        if a is not None:
            animators.append(a)
        else:
            viewer._apply_color_state_instant(new_view, new_index, is_active=True, is_backing=is_backing)

    if not animators:
        return True

    try:
        aset = AnimatorSet()
        aset.playTogether(*animators)

        viewer_self = viewer

        class TransitionEndListener(dynamic_proxy(Animator.AnimatorListener)):
            def __init__(self):
                super().__init__()
                self._cancelled = False

            def onAnimationStart(self, anim, *args):
                pass

            def onAnimationCancel(self, anim, *args):
                self._cancelled = True

            def onAnimationEnd(self, anim, *args):
                if viewer_self._line_animators.get(old_index) is aset:
                    viewer_self._line_animators.pop(old_index, None)
                if viewer_self._line_animators.get(new_index) is aset:
                    viewer_self._line_animators.pop(new_index, None)

            def onAnimationRepeat(self, anim, *args):
                pass

        aset.addListener(TransitionEndListener())

        aset.start()
        if old_row is not None and old_view is not None:
            viewer._line_animators[old_index] = aset
        if new_row is not None and new_view is not None:
            viewer._line_animators[new_index] = aset
    except Exception as e:
        _af_dbg(viewer, "core", "AnimatorSet.playTogether/start failed, falling back to individual starts: " + str(e))
        for a in animators:
            try:
                a.start()
            except Exception:
                pass
    return True


# снятие активности со строки цепочки
def _af_line_disconnect_strategy(viewer, row, view, line_index: int) -> bool:
    if not ANIMATOR_AVAILABLE or row is None or view is None:
        return False
    try:
        scale_on = _af_scale_animation_enabled(viewer)
        animators = []

        viewer._set_line_blur(view, blurred=True, animate=True)

        if scale_on:
            a = _af_build_line_animator(viewer, row, line_index, is_active=False)
            if a is not None:
                animators.append(a)
        else:
            viewer._apply_scale_state_instant(row, is_active=False)

        viewer._apply_row_alpha_instant(row, is_active=False)

        a = _af_build_color_fade_animator(viewer, view, line_index, is_active=False)
        if a is not None:
            animators.append(a)
        else:
            viewer._apply_color_state_instant(view, line_index, is_active=False)

        if not animators:
            return True

        aset = AnimatorSet()
        aset.playTogether(*animators)

        viewer_self = viewer

        class DisconnectEndListener(dynamic_proxy(Animator.AnimatorListener)):
            def onAnimationStart(self, anim, *args):
                pass

            def onAnimationCancel(self, anim, *args):
                pass

            def onAnimationEnd(self, anim, *args):
                if viewer_self._line_animators.get(line_index) is aset:
                    viewer_self._line_animators.pop(line_index, None)

            def onAnimationRepeat(self, anim, *args):
                pass

        aset.addListener(DisconnectEndListener())
        aset.start()
        viewer._line_animators[line_index] = aset
        return True
    except Exception as e:
        _af_dbg(viewer, "core", "line_disconnect_strategy failed, falling back to instant snap: " + str(e))
        return False


_BEZIER_CACHE: Dict[Tuple[float, float, float, float], Any] = {}

# кривая безье
def _af_bezier(x1: float, y1: float, x2: float, y2: float):
    key = (round(x1, 3), round(y1, 3), round(x2, 3), round(y2, 3))
    it = _BEZIER_CACHE.get(key)
    if it is not None:
        return it
    try:
        if PATH_INTERP_AVAILABLE:
            it = PathInterpolator(float(x1), float(y1), float(x2), float(y2))
        else:
            it = DecelerateInterpolator(2.0)
    except Exception:
        it = DecelerateInterpolator(2.0)
    _BEZIER_CACHE[key] = it
    return it


# приведение к int32
def _af_i32(c: int) -> int:
    v = int(c) & 0xFFFFFFFF
    return v - 0x100000000 if v >= 0x80000000 else v


# анимация размытия строки
def _af_blur_animate(viewer, view, want: bool, radius_px: float, was_blurred: bool = False) -> None:
    full = max(0.5, float(radius_px) * 0.6)
    curmap = getattr(viewer, "_blur_cur", None)
    if curmap is None:
        curmap = {}
        viewer._blur_cur = curmap
    tokens = getattr(viewer, "_blur_tokens", None)
    if tokens is None:
        tokens = {}
        viewer._blur_tokens = tokens
    key = int(view.hashCode())
    token = tokens.get(key, 0) + 1
    tokens[key] = token
    if key in curmap:
        start = float(curmap[key])
    else:
        start = full if was_blurred else 0.0
    end = full if want else 0.0

    fx_cache = getattr(viewer, "_blur_fx_cache", None)
    if fx_cache is None:
        fx_cache = {}
        viewer._blur_fx_cache = fx_cache
    applied = getattr(viewer, "_blur_applied_q", None)
    if applied is None:
        applied = {}
        viewer._blur_applied_q = applied

    def _put(sigma: float) -> None:
        curmap[key] = sigma
        q = round(sigma * 4.0) / 4.0
        if q < 0.3:
            q = 0.0
        if applied.get(key) == q:
            return
        applied[key] = q
        if q <= 0.0:
            view.setRenderEffect(None)
        else:
            fx = fx_cache.get(q)
            if fx is None:
                fx = RenderEffect.createBlurEffect(float(q), float(q), Shader.TileMode.CLAMP)
                fx_cache[q] = fx
            view.setRenderEffect(fx)

    if abs(end - start) < 0.05:
        curmap[key] = end
        try:
            if not want:
                view.setRenderEffect(None)
                applied[key] = 0.0
        except Exception:
            pass
        return

    dur = int(_af_wave_duration_ms(viewer) * 0.8) if _af_wave_enabled(viewer) else int(_af_animation_ms(viewer) * 1.6)
    steps = ((0.00, 0.30), (0.20, 0.60), (0.40, 0.85), (0.65, 1.00))

    def _make(progress: float):
        def _run():
            try:
                if tokens.get(key) != token:
                    return
                _put(start + (end - start) * progress)
            except Exception:
                pass
        return _run

    for when, progress in steps:
        fn = _make(progress)
        delay = int(dur * when)
        if delay <= 0:
            fn()
        else:
            try:
                from android_utils import run_on_ui_thread
                run_on_ui_thread(fn, delay)
            except Exception:
                fn()


# включена ли волна
def _af_wave_enabled(viewer) -> bool:
    return setting_bool(viewer.plugin, "wave_enabled", DEFAULT_WAVE_ENABLED)

# длительность волны
def _af_wave_duration_ms(viewer) -> int:
    return viewer._setting_int("wave_duration_ms", DEFAULT_WAVE_DURATION_MS, 300, 2000)

# задержка между строками волны
def _af_wave_stagger_ms(viewer) -> int:
    return viewer._setting_int("wave_stagger_ms", DEFAULT_WAVE_STAGGER_MS, 0, 120)

# затухание волны
def _af_wave_damping(viewer) -> float:
    return setting_float(viewer.plugin, "wave_damping", DEFAULT_WAVE_DAMPING, 0.4, 1.0)


# пружинная кривая
def _af_spring(u: float, zeta: float = 0.8) -> float:
    if u <= 0.0:
        return 0.0
    if u >= 1.0:
        return 1.0
    k = math.log(500.0)
    if zeta >= 0.999:
        w = k * 1.55
        return 1.0 - (1.0 + w * u) * math.exp(-w * u)
    decay = k
    omega = decay / zeta
    wd = omega * math.sqrt(1.0 - zeta * zeta)
    return 1.0 - math.exp(-decay * u) * (math.cos(wd * u) + (decay / wd) * math.sin(wd * u))


# отмена волны
def _af_wave_cancel(viewer, reset: bool = False) -> None:
    anim = getattr(viewer, "_wave_animator", None)
    rows = getattr(viewer, "_wave_rows", None) or []
    viewer._wave_animator = None
    if anim is not None:
        try:
            anim.cancel()
        except Exception:
            pass
    if reset:
        for row in rows:
            try:
                row.setTranslationY(0.0)
            except Exception:
                pass
        viewer._wave_rows = []


# скролл волной
def _af_wave_scroll(viewer, target: int) -> bool:
    if not ANIMATOR_AVAILABLE:
        return False
    wave_on = _af_wave_enabled(viewer)
    try:
        scroll = viewer.scroll
        rows = viewer.line_rows
        cur = int(scroll.getScrollY())
        delta = int(target) - cur
        sh = int(scroll.getHeight())
        if sh <= 0 or not rows:
            return False
        if abs(delta) > sh * 1.2:
            return False
        if abs(delta) < 2:
            return True

        idx = int(getattr(viewer, "_scroll_target_index", -1))
        if idx < 0:
            idx = 0
        lo = min(cur, target) - sh * 0.10
        hi = max(cur, target) + sh * 1.10
        picked = []
        _n = len(rows)
        _anchor = idx if 0 <= idx < _n else 0

        def _in_range(i):
            row = rows[i]
            if row is None:
                return None
            try:
                top = row.getTop()
                bottom = top + row.getHeight()
            except Exception:
                return None
            return top, bottom

        _steps = 0
        j = _anchor
        while j < _n and _steps < 60:
            tb = _in_range(j)
            _steps += 1
            if tb is not None:
                if tb[0] > hi:
                    break
                if tb[1] >= lo:
                    picked.append(j)
            j += 1
        j = _anchor - 1
        _steps = 0
        while j >= 0 and _steps < 60:
            tb = _in_range(j)
            _steps += 1
            if tb is not None:
                if tb[1] < lo:
                    break
                if tb[0] <= hi:
                    picked.append(j)
            j -= 1
        picked.sort()
        if not picked:
            return False
        if len(picked) > 18:
            picked = sorted(picked, key=lambda i: abs(i - idx))[:18]

        try:
            if viewer.scroll_animator is not None:
                viewer.scroll_animator.cancel()
                viewer.scroll_animator = None
        except Exception:
            pass
        prev_rows = list(getattr(viewer, "_wave_rows", None) or [])
        old = getattr(viewer, "_wave_animator", None)
        viewer._wave_animator = None
        if old is not None:
            try:
                old.cancel()
            except Exception:
                pass
        picked_ids = {id(rows[i]) for i in picked}
        _src_text = getattr(viewer, "source_text", None)
        for r in prev_rows:
            try:
                if r is _src_text:
                    continue
                if id(r) not in picked_ids:
                    r.setTranslationY(0.0)
            except Exception:
                pass

        if wave_on:
            dur = float(_af_wave_duration_ms(viewer))
            stagger = float(_af_wave_stagger_ms(viewer))
            zeta = float(_af_wave_damping(viewer))
        else:
            dur = float(SMOOTH_SCROLL_MS)
            stagger = 0.0
            zeta = 1.0
        sign = 1 if delta > 0 else -1

        items = []
        max_delay = 0.0
        for i in picked:
            row = rows[i]
            try:
                cur_ty = float(row.getTranslationY())
            except Exception:
                cur_ty = 0.0
            rank = (i - idx) * sign
            delay = stagger * 4.5 * (1.0 - math.exp(-rank / 4.0)) if rank > 0 else 0.0
            max_delay = max(max_delay, delay)
            items.append((row, cur_ty + float(delta), delay))

        try:
            _src = getattr(viewer, "source_text", None)
            if _src is not None:
                _stop = _src.getTop()
                _sbot = _stop + _src.getHeight()
                if _sbot >= lo and _stop <= hi:
                    try:
                        _scur = float(_src.getTranslationY())
                    except Exception:
                        _scur = 0.0
                    items.append((_src, _scur + float(delta), max_delay))
                else:
                    _src.setTranslationY(0.0)
        except Exception:
            pass

        total = dur + max_delay

        scroll.scrollTo(0, int(target))
        try:
            applied = int(scroll.getScrollY()) - cur
        except Exception:
            applied = delta
        if applied != delta:
            items = [(r_, sty_ - float(delta) + float(applied), d_) for (r_, sty_, d_) in items]
            if abs(applied) < 2:
                for r_, _sty, _d in items:
                    try:
                        r_.setTranslationY(0.0)
                    except Exception:
                        pass
                viewer._wave_rows = []
                return True
        for row, start_ty, _d in items:
            try:
                row.setTranslationY(start_ty)
            except Exception:
                pass
        viewer._wave_rows = [it[0] for it in items]

        if wave_on:
            interp = _af_bezier(0.30, 0.40, 0.20, 1.0 + (1.0 - zeta) * 0.8)
        else:
            interp = _af_bezier(*SMOOTH_BEZIER)
        anims = []
        for row, start_ty, delay in items:
            oa = ObjectAnimator.ofFloat(row, "translationY", float(start_ty), 0.0)
            oa.setDuration(int(dur))
            oa.setInterpolator(interp)
            if delay > 0.0:
                oa.setStartDelay(int(delay))
            anims.append(oa)
        animator = AnimatorSet()
        animator.playTogether(*anims)

        class WaveEndListener(dynamic_proxy(Animator.AnimatorListener)):
            def onAnimationStart(self, anim, *args):
                pass

            def onAnimationCancel(self, anim, *args):
                pass

            def onAnimationEnd(self, anim, *args):
                try:
                    if getattr(viewer, "_wave_animator", None) is animator:
                        viewer._wave_animator = None
                        viewer._wave_rows = []
                except Exception:
                    pass

            def onAnimationRepeat(self, anim, *args):
                pass

        animator.addListener(WaveEndListener())
        viewer._wave_animator = animator
        animator.start()
        return True
    except Exception as e:
        _af_dbg(viewer, "scroll", "wave scroll failed, falling back: " + str(e))
        try:
            _af_wave_cancel(viewer, reset=True)
        except Exception:
            pass
        return False


# выбор способа скролла
def _af_scroll_strategy(viewer, target: int) -> bool:
    if not ANIMATOR_AVAILABLE:
        return False
    try:
        if _af_wave_scroll(viewer, target):
            return True
    except Exception as e:
        _af_dbg(viewer, "scroll", "wave strategy crashed: " + str(e))
    try:
        _af_wave_cancel(viewer, reset=True)
        if viewer.scroll_animator is not None:
            viewer.scroll_animator.cancel()
        cur = viewer.scroll.getScrollY()
        a = ObjectAnimator.ofInt(viewer.scroll, "scrollY", int(cur), int(target))
        a.setDuration(int(SEEK_SCROLL_MS))
        a.setInterpolator(_af_bezier(*SMOOTH_BEZIER))
        a.start()
        viewer.scroll_animator = a
        return True
    except Exception as e:
        _af_dbg(viewer, "scroll", "kinetic animator failed, falling back to instant: " + str(e))
        return False


# одиночный тап по строке
class LineGestureClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, on_single_tap, on_double_tap, threshold_sec: float = 0.34):
        super().__init__()
        self.on_single_tap = on_single_tap
        self.on_double_tap = on_double_tap
        self.threshold_sec = threshold_sec
        self.last_click_at = 0.0
        self.generation = 0

    # разбор тапа по строке
    def onClick(self, view):
        try:
            now = time.time()
            if now - self.last_click_at <= self.threshold_sec:
                self.last_click_at = 0.0
                self.generation += 1
                self.on_double_tap(view)
                return
            self.last_click_at = now
            self.generation += 1
            my_generation = self.generation

            def _fire_single():
                if self.generation != my_generation:
                    return
                try:
                    self.on_single_tap(view)
                except BaseException as e:
                    _log_safe("LineGestureClickListener", e)

            try:
                from android_utils import run_on_ui_thread
                run_on_ui_thread(_fire_single, int(self.threshold_sec * 1000))
            except Exception:
                _fire_single()
        except BaseException as e:
            _log_safe("LineGestureClickListener", e)


# отслеживание касаний скролла
class ScrollTouchListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, on_touch_activity):
        super().__init__()
        self.on_touch_activity = on_touch_activity

    # реакция на касание
    def onTouch(self, view, event) -> bool:
        try:
            action = event.getAction()
            if action == MotionEvent.ACTION_MOVE:
                _now = time.monotonic()
                if _now - getattr(self, "_last_move_at", 0.0) < 0.06:
                    return False
                self._last_move_at = _now
            if action in (MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE,
                          MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                try:
                    self.on_touch_activity(action)
                except TypeError:
                    self.on_touch_activity()
        except BaseException as e:
            _log_safe("ScrollTouchListener", e)
        return False


# окно с текстом песни
class LyricsViewer:
    def __init__(self, plugin: "Plugin", track: TrackInfo):
