UPDATE_AUTO_DELAY_SEC = 8

_UPDATE_KEYS = ("version", "download", "changelog")


# версия строкой в кортеж чисел
def _parse_version_tuple(value: Any) -> Tuple[int, ...]:
    nums = [int(x) for x in re.findall(r"\d+", str(value or ""))][:4]
    while len(nums) < 4:
        nums.append(0)
    return tuple(nums)


# новее ли версия, чем текущая
def is_newer_version(remote: Any, local: Any) -> bool:
    try:
        return _parse_version_tuple(remote) > _parse_version_tuple(local)
    except Exception:
        return False


# разбор ответа с инфо об обновлении
def parse_update_info(text: str) -> Dict[str, str]:
    data: Dict[str, str] = {}
    current = None
    for raw in str(text or "").replace("\ufeff", "").splitlines():
        line = raw.rstrip()
        m = re.match(r"^\s*([A-Za-zА-Яа-я_]+)\s*[:=]\s*(.*)$", line)
        if m and m.group(1).lower() in _UPDATE_KEYS:
            current = m.group(1).lower()
            data[current] = m.group(2).strip()
            continue
        if current == "changelog" and line.strip():
            data["changelog"] = (data.get("changelog", "") + "\n" + line.strip()).strip()
    return data


# загрузка инфо об обновлении
def fetch_update_info() -> Dict[str, str]:
    r = requests.get(UPDATE_INFO_URL, timeout=UPDATE_TIMEOUT_SEC, headers={"Cache-Control": "no-cache"})
    r.raise_for_status()
    r.encoding = "utf-8"
    return parse_update_info(r.text)


# ссылка ведет в телеграм
def is_telegram_url(url: str) -> bool:
    return bool(re.match(r"^\s*(?:https?://(?:www\.)?(?:t|telegram)\.me/|https?://telegram\.dog/|tg://)", str(url or ""), re.I))


# открыть ссылку во внешнем приложении
def open_external_url(url: str) -> None:
    from android.content import Intent
    from android.net import Uri
    url = str(url).strip()
    if not url.lower().startswith(("http://", "https://", "tg://")):
        raise ValueError("unsupported url")
    context = ApplicationLoader.applicationContext
    if is_telegram_url(url):
        # ссылки на телеграм открываем в самом телеграме, без браузера
        try:
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.setPackage(context.getPackageName())
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
            return
        except Exception as e:
            plog_exc("Update", "open in telegram failed", e)
    if url.lower().startswith("tg://"):
        raise ValueError("unsupported url")
    intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    context.startActivity(intent)


