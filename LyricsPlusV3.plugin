_CIRCULAR_OUT = None
_CIRCULAR_IN = None
if ANIMATOR_AVAILABLE:
    class _CircularEaseOutInterpolator(dynamic_proxy(Interpolator)):
        def getInterpolation(self, t: float) -> float:
            t -= 1.0
            val = 1.0 - t * t
            return math.sqrt(val) if val > 0.0 else 0.0

    class _CircularEaseInInterpolator(dynamic_proxy(Interpolator)):
        def getInterpolation(self, t: float) -> float:
            val = 1.0 - t * t
            return 1.0 - math.sqrt(val) if val > 0.0 else 1.0

    _CIRCULAR_OUT = _CircularEaseOutInterpolator()
    _CIRCULAR_IN = _CircularEaseInInterpolator()


# безопасное приведение к строке
def safe_str(value: Any, default: str = "") -> str:
    if value is None:
        return default
    try:
        text = str(value)
    except Exception:
        return default
    text = text.strip()
    return text if text else default


