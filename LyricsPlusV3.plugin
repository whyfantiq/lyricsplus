        self._header_expanded: bool = True
        self.mini_player_bar: Optional[FrameLayout] = None
        self.mini_player_shield = None
        self.mini_cover_view: Optional[ImageView] = None
        self.mini_title_view: Optional[TextView] = None
        self.mini_artist_view: Optional[TextView] = None
